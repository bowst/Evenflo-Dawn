    "evenflo_faq_tBgRpX": {
      "type": "evenflo-faq",
      "blocks": {
        "faq_4pNGcV": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does this car seat have cupholders?",
            "content": "<p>Yes, a removable cupholder is included for use by the adult in stroller mode ONLY.                                                                                  </p>"
          }
        },
        "faq_CjNJaF": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does this seat have a tether?",
            "content": "<p>No, the Evenflo Shyft™ DualRide™ does not have a tether. Typically, rear-facing-only car seats do not use a tether as part of the vehicle installation.</p>"
          }
        },
        "faq_C7T4rr": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does this car seat have a steel frame?",
            "content": "<p>The Evenflo Shyft™ DualRide™ meets or exceeds all applicable Federal motor vehicle safety standards and Evenflo’s internal testing standards. This product does not have a steel frame but is made of robust plastic sufficient to withstand numerous dynamic tests. The Shyft™DualRide™ is engineered to manage crash energy appropriately without the addition of a steel frame.</p>"
          }
        },
        "faq_yQT8rD": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does this car seat have an anti-rebound bar?",
            "content": "<p>The base of the Evenflo Shyft™ DualRide™ acts as an anti-rebound system — a lot like an anti-rebound bar. This feature absorbs and dissipates crash forces to help provide additional stability.</p>"
          }
        },
        "faq_TJqKHm": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does this car seat have a load leg?",
            "content": "<p>No, the Evenflo Shyft™ DualRide™ is not designed with a load leg. This car seat meets or exceeds all applicable Federal motor vehicle safety standards and Evenflo’s internal testing standards. The Evenflo Shyft™ DualRide™ is engineered to manage crash energy appropriately without the addition of a load leg.</p>"
          }
        },
        "faq_yM3D4p": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Is the Evenflo Shyft™ DualRide™ latex-free?",
            "content": "<p>Yes. All Evenflo car seats are latex-free.</p>"
          }
        },
        "faq_RTcxU8": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Is the buckle cover required?",
            "content": "<p>No. The buckle cover for your Evenflo Shyft™ DualRide™ is optional and provided for your child’s comfort. It may be used at any time.</p>"
          }
        },
        "faq_e8QUzX": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Which models include SensorSafe™?",
            "content": "<p>All versions of the Evenflo Shyft™ DualRide™ come equipped with SensorSafe™.</p>"
          }
        },
        "faq_6HeHAT": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How many buckle positions does this car seat have?",
            "content": "<p>The Evenflo Shyft™DualRide™ has 3 buckle positions. The buckle should be positioned as close as possible to, without being under, your child’s bottom. You may also shorten the buckle to improve fit for newborns.</p>"
          }
        },
        "faq_CKf8GY": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Is the body pillow required?",
            "content": "<p>The infant body pillow is required for our tiniest riders from 3 - 6 lb. (1.4 - 2.7 kg). It is optional for use above 6 lb. (2.7 kg) and is designed to assist with your child’s positioning and comfort.</p>"
          }
        },
        "faq_LEM3jQ": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How many carry handle positions does the Evenflo ShyftTM DualRideTM have?",
            "content": "<p>The Evenflo Shyft™ DualRide™ has 3 handle positions. Any locked handle position may be used in your vehicle, in the United States. The handle must be in the upright position to carry your infant car seat.</p>"
          }
        },
        "faq_ih3jVJ": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How many harness height positions are on this car seat?",
            "content": "<p>The Evenflo Shyft™ DualRide™ has 8 harness positions. To adjust the harness height, simply squeeze the harness height adjustment at the top of the headrest and move the headrest up or down to the appropriate location for your child.</p>"
          }
        },
        "faq_w4KVtA": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can you use this car seat without the base?",
            "content": "<p>Yes, the Shyft™ DualRide™ can be used with or without the stroller frame when installing without the base.</p>"
          }
        }
      },
