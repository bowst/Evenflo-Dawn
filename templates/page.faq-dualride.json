    "evenflo_faq_eKNGJX": {
      "type": "evenflo-faq",
      "blocks": {
        "faq_H6WVTW": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does this car seat come with a seat protector pad?",
            "content": "<p>No, but we do have an accessory mat available at www.evenflo.com. You can also place a towel beneath and behind the car seat to help protect your vehicle upholstery.</p>"
          }
        },
        "faq_eRRRwA": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can I use a car seat mat to protect my vehicle seat?",
            "content": "<p>Evenflo allows the use of the Evenflo car seat accessory mat underneath the Evenflo Shyft™ DualRide™ in all installation modes. You can also place a towel beneath and behind the car seat to help protect your vehicle upholstery.</p>"
          }
        },
        "faq_ExHBdG": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can you wash the seat pad? If so, how?",
            "content": "<p>Yes! For your convenience, the soft goods on your Evenflo Shyft™ DualRide™ are washable. This includes the seat pad, head pad, infant insert, harness covers, and buckle cover. Machine wash separately in cold water on a delicate cycle. Do not use chlorine bleach. Tumble dry on low heat for 10 – 15 minutes. Do not iron or dry clean. See product instructions for full cleaning details.</p>"
          }
        },
        "faq_JTX8At": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How do you clean the plastic components of the car seat or base?",
            "content": "<p>Plastic components may be wiped clean with warm water and mild soap. Take care not to soak the product usage labels.</p>"
          }
        },
        "faq_qkxFWC": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How easy is it to remove the seat pad to wash?",
            "content": "<p>Really simple. The seat pad is designed to be easy-to-remove and toss in the wash (just be sure to wash separately, delicate cycle, with mild detergent).</p>"
          }
        },
        "faq_LdCfPR": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does the black fabric get hot in the summer?",
            "content": "<p>Like all black fabrics, the black fabric on your car seat will get warmer the longer the car seat is exposed to sunlight. In warmer months, you can place a towel or sheet over the car seat when it is not in use to help keep it cool.</p>"
          }
        },
        "faq_VHCpBc": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How comfortable are the fabrics for my child?",
            "content": "<p>The Evenflo Shyft™ DualRide™ is designed with premium, soft fabrics that have a smooth finish for easy spot cleaning. Your child will love the plush feel.</p>"
          }
        }
      },
