    "evenflo_faq_9jxxtE": {
      "type": "evenflo-faq",
      "blocks": {
        "faq_94AWBJ": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "What is the lifespan of the seat?",
            "content": "<p>The <a href=\"https://www.evenflo.com/products/revolve360-swivel-car-seat-convertible-car-seat\" title=\"https://www.evenflo.com/products/revolve360-swivel-car-seat-convertible-car-seat\">Revolve360</a> has a 10-year expiration from the date of manufacture. The specific<br/>expiration date is listed on the date and model label on the product.</p>"
          }
        },
        "faq_CdfBrb": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How long can my child stay rear-facing in the Revolve360?",
            "content": "<p>Once your child reaches either 40 lbs (18 kg), 40 inches (101 cm) or has less than one<br/>inch (2.5 cm) of car seat shell over the top of their head, you must discontinue use of<br/>the seat in rear-facing mode. A weight limit of 40 lbs (18 kg) is equivalent to a 97th<br/>percentile 3-year old boy. A height limit of 40 in (101 cm) is equivalent to a 93rd<br/>percentile 3-year old boy. It is important to remember that all children grow at different<br/>rates and in different ways, but this car seat will likely accommodate most children in the<br/>rear-facing mode through at least age three.</p>"
          }
        },
        "faq_J39MQd": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Where is the date and model label?",
            "content": "<p>You can find the date of manufacture, model name and model number on a label on the rear of the car seat over the User Guide storage pocket. It is also located on the car seat base near the LockStrong belt tensioning arm.</p>"
          }
        },
        "faq_LMQ3xR": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How much does the Revolve360 weigh?",
            "content": "<p>29.66 lbs (13.5 kg)</p>"
          }
        },
        "faq_9NFmtL": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "What are the dimensions of the Revolve360?",
            "content": "<p>The dimensions of the Revolve360 are 20.55 D x 25 H x 19.6 W inches (52.5cm D x 63.5cm H x 49.8cm W) when the car seat is positioned forward-facing in the lowest headrest position.</p>"
          }
        },
        "faq_AyxVmw": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How many buckle positions are on the Revolve360 and are there any restrictions based on mode of use?",
            "content": "<p>The Revolve360 has three buckle positions to help fit your growing child. You can use any of the three positions in either rear-facing or forward-facing harnessed mode. You should use the position that places the buckle closest to, but not underneath, your child.</p>"
          }
        },
        "faq_m8j7Ng": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does this come with a seat protector mat?",
            "content": "<p>No, but we do have an accessory mat available.</p>"
          }
        },
        "faq_mdcGRA": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does the Revolve360 include a base?",
            "content": "<p>Yes, the <a href=\"https://www.evenflo.com/products/revolve360-swivel-car-seat-convertible-car-seat\" title=\"https://www.evenflo.com/products/revolve360-swivel-car-seat-convertible-car-seat\">Revolve360 consists of a seat shell and base</a>. The seat shell is removable to ensure an easy installation.</p>"
          }
        },
        "faq_cUQyMk": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does this seat have an anti-rebound bar?",
            "content": "<p>Yes, the base of the Revolve360 acts as an anti-rebound system – a lot like an anti-rebound bar. This feature helps limit crash forces during the rebound phase of a crash.</p>"
          }
        },
        "faq_kCbYHM": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does this seat have a load leg?",
            "content": "<p>No, the Revolve360 is not designed with a load leg.</p>"
          }
        },
        "faq_wt4fFa": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Does the Revolve360 fit into a travel bag?",
            "content": "<p>Yes, it fits in the Evenflo travel bag which can be purchased separately.</p>"
          }
        }
      },
