    "evenflo_faq_YfTTiN": {
      "type": "evenflo-faq",
      "blocks": {
        "faq_gXjKDD": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can I wash the pad? If so, how?",
            "content": "<p>Yes! Simply wash the removable seat pads separately in cold water — delicate cycle, with mild detergent. Tumble dry 10 – 15 minutes on low heat, remove immediately. And be sure not to iron or dry clean. See product instructions for full cleaning details.</p>"
          }
        },
        "faq_kLDymr": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can I safely disinfect my Evenflo car seat?",
            "content": "<p>Yes. You can use 70% isopropyl alcohol to disinfect car seat and booster seat surfaces, including the fabric, harness, buckle, plastic parts, foam and labels. You can spray or wipe the 70% isopropyl alcohol to dampen (but not soak) the surfaces. Afterwards, be sure to let the surfaces air dry. This guidance applies to all Evenflo car seats and booster seats. But keep in mind—this guidance doesn’t apply to vehicle surfaces, like the seat belt. Please consult your vehicle manufacturer for guidance on disinfecting or cleaning vehicle surfaces.</p>"
          }
        },
        "faq_4XtWLz": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How easy is it to remove the covers to wash?",
            "content": "<p>Really simple. The covers are designed to be easy-to-remove and toss in the wash (just be sure to wash separately, delicate cycle, with mild detergent).</p>"
          }
        },
        "faq_rYicAd": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How do I clean the base?",
            "content": "<p>Simply wipe clean with mild detergent and damp cloth—and be sure not to soak the labels!</p>"
          }
        },
        "faq_NehqP3": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can I hose the seat down in case of any accidents (for example, my child gets sick in her/his seat?)",
            "content": "<p>Follow the care and cleaning instructions provided in the Revolve360 User Guide. Be sure to reach out to Gold Consumer Care for more information and communications regarding sanitization.</p>"
          }
        }
      },
