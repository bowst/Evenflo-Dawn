            "enable_video_looping": false,
            "liquid_content": "<!--  ----------------------------------------------------------------------  -->\n<!--  NOTE: Please add the following <META> element to your page <HEAD>.      -->\n<!--  If necessary, please modify the charset parameter to specify the        -->\n<!--  character set of your HTML page.                                        -->\n<!--  ----------------------------------------------------------------------  -->\n\n<META HTTP-EQUIV=\"Content-type\" CONTENT=\"text/html; charset=UTF-8\">\n<script src=\"https://www.google.com/recaptcha/api.js\"></script>\n<script>\n function timestamp() { var response = document.getElementById(\"g-recaptcha-response\"); if (response == null || response.value.trim() == \"\") {var elems = JSON.parse(document.getElementsByName(\"captcha_settings\")[0].value);elems[\"ts\"] = JSON.stringify(new Date().getTime());document.getElementsByName(\"captcha_settings\")[0].value = JSON.stringify(elems); } } setInterval(timestamp, 500); \n</script>\n<!--  ----------------------------------------------------------------------  -->\n<!--  NOTE: Please add the following <FORM> element to your page.             -->\n<!--  ----------------------------------------------------------------------  -->\n\n<form action=\"https://webto.salesforce.com/servlet/servlet.WebToCase?encoding=UTF-8&orgId=00Df4000002dTF0\" method=\"POST\">\n\n<input type=hidden name=\"orgid\" value=\"00Df4000002dTF0\">\n<input type=hidden name=\"retURL\" value=\"http://evenflo.com/pages/confirmation\">\n\n<!--  ----------------------------------------------------------------------  -->\n<!--  NOTE: These fields are optional debugging elements. Please uncomment    -->\n<!--  these lines if you wish to test in debug mode.                          -->\n<!--  <input type=\"hidden\" name=\"debug\" value=1>                              -->\n<!--  <input type=\"hidden\" name=\"debugEmail\"                                  -->\n<!--  value=\"russell.griffith@goodbabyint.com\">                               -->\n<!--  ----------------------------------------------------------------------  -->\n\n\n\n<label for=\"name\">Contact Name: <span class=\"required-star\" aria-hidden=\"true\">*</span></label><input id=\"name\" maxlength=\"80\" name=\"name\" size=\"20\" type=\"text\" class=\"field__input\" required/><br>\n\n<label for=\"email\">Email: <span class=\"required-star\" aria-hidden=\"true\">*</span></label><input id=\"email\" maxlength=\"80\" name=\"email\" size=\"20\" type=\"text\" class=\"field__input\" required /><br>\n\n<label for=\"phone\">Phone: </label><input id=\"phone\" maxlength=\"40\" name=\"phone\" size=\"20\" type=\"text\" class=\"field__input\"/><br><br>\n\n<label for=\"reason\">Virtual Visit Type: <span class=\"required-star\" aria-hidden=\"true\">*</span></label><select id=\"reason\" name=\"reason\" class=\"field__input\" required>\n<option value=\"\">--None--</option>\n<option value=\"Car Seat Install Support\">Car Seat Install Support</option>\n<option value=\"Other Product Issue\">Other Product Issue</option>\n</select><br><br>\n\n<div id=\"carseat\">\n\t<label for=\"00NUy00000CChwj\">Age of Child: <span class=\"required-star\" aria-hidden=\"true\">*</span></label>\n\t<select id=\"00NUy00000CChwj\" name=\"00NUy00000CChwj\" title=\"Age of Child\" class=\"field__input\"><option value=\"\">--None--</option>\n\t\t<option value=\"Unborn\">Unborn</option>\n\t\t<option value=\"1 month\">1 month</option>\n\t\t<option value=\"2 months\">2 months</option>\n\t\t<option value=\"3 months\">3 months</option>\n\t\t<option value=\"4 months\">4 months</option>\n\t\t<option value=\"5 months\">5 months</option>\n\t\t<option value=\"6 months\">6 months</option>\n\t\t<option value=\"7 months\">7 months</option>\n\t\t<option value=\"8 months\">8 months</option>\n\t\t<option value=\"9 months\">9 months</option>\n\t\t<option value=\"10 months\">10 months</option>\n\t\t<option value=\"11 months\">11 months</option>\n\t\t<option value=\"1 year\">1 year</option>\n\t\t<option value=\"2 years\">2 years</option>\n\t\t<option value=\"3 years\">3 years</option>\n\t\t<option value=\"4 years\">4 years</option>\n\t\t<option value=\"5 years\">5 years</option>\n\t\t<option value=\"6 years or older\">6 years or older</option>\n\t\t</select><br>\n\t<label for=\"00N5G00000WigJQ\">Type of Car Seat: <span class=\"required-star\" aria-hidden=\"true\">*</span></label><input id=\"00N5G00000WigJQ\" maxlength=\"255\" name=\"00N5G00000WigJQ\" size=\"20\" type=\"text\" class=\"field__input\" /><br>\n\t<label for=\"00NUy00000CCi3B\">Vehicle Year/Make/Model: <span class=\"required-star\" aria-hidden=\"true\">*</span></label><input id=\"00NUy00000CCi3B\" maxlength=\"100\" name=\"00NUy00000CCi3B\" size=\"20\" type=\"text\" class=\"field__input\" /><br><br>\n</div>\n\n<label for=\"subject\">Reason for Virtual Visit: <span class=\"required-star\" aria-hidden=\"true\">*</span></label><input id=\"subject\" maxlength=\"80\" name=\"subject\" size=\"20\" type=\"text\" class=\"field__input\" required /><br>\n\n<label for=\"description\">Attach a message to your booking.<span class=\"required-star\" aria-hidden=\"true\">*</span><br> \n\t(the more information you can provide, the faster we can resolve the issue)</label><br>\n<textarea name=\"description\" class=\"field__input\" required></textarea><br>\n\n\n\n<input id=\"status\" name=\"status\" type=\"hidden\" value=\"New\">\n<input id=\"Origin\" name=\"Origin\" type=\"hidden\" value=\"Web\">\n<input id=\"priority\" name=\"priority\" type=\"hidden\" value=\"Medium\">\n<input id=\"recordType\" name=\"recordType\" type=\"hidden\" value=\"012Uy00000EEeOw\">\n<input id=\"OwnerId\" name=\"OwnerId\" type=\"hidden\" value=\"00Gf4000003U5HV\">\n  <div class=\"g-recaptcha\" data-sitekey=\"6Lf_pw4tAAAAADxOWhGs3EBLwk0oDctGI6z4kiuV\n\"></div>\n<input type=\"submit\" name=\"submit\">\n\n</form>\n<!-- ----------------------------------------------------------------   -->\n<!-- NOTE: this script is needed for the show/hide of the \"carseat\" div -->\n<!-- ----------------------------------------------------------------   -->\n<script defer=\"defer\">\n  // Simple script to show hide content based on select option for \"reason\" above.\n  const selectReason = document.getElementById('reason');\n  const carseatDiv   = document.getElementById('carseat');\n\n  selectReason.addEventListener('change', function(event) {\n\t  switch (event.target.value) \n\t  {\n\t\tcase 'Car Seat Install Support':\n\t\t  carseatDiv.style.display = 'block';\n\t\t  document.getElementById('00NUy00000CChwj').required = true;\n\t\t  document.getElementById('00N5G00000WigJQ').required = true;\n\t\t  document.getElementById('00NUy00000CCi3B').required = true;\n\t\t  break;\n\t\tdefault:\n\t\t  carseatDiv.style.display = 'none';\n\t\t   document.getElementById('00NUy00000CChwj').required = false;\n\t\t  document.getElementById('00N5G00000WigJQ').required = false;\n\t\t  document.getElementById('00NUy00000CCi3B').required = false;\n\t\t  break;\n\t  }\n  });\n</script>\n<style>\n  #carseat {\n\tdisplay: none;\n  }\n  /* Style the asterisk to stand out visually */\n  .required-star {\n\tcolor: red;\n\tmargin-left: 2px;\n\tmargin-right: 2px;\n  }\n.select.field__input {\n  height: 4.5rem;\n  padding-top: 0 !important;\n  padding-bottom: 0;\n}\n</style>",
