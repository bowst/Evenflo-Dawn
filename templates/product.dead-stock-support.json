    "evenflo_multicolumn_cDcKcx": {
      "type": "evenflo-multicolumn",
      "blocks": {
        "column_xXNbtw": {
          "type": "column",
          "settings": {
            "liquid_content": "{% assign retail_package_contents_value = product.metafields.sf_products.retail_package_contents %}\n          {% if retail_package_contents_value %}\n<h3>Contents</h3>\n             {{ retail_package_contents_value }}\n\n          {% endif %}\n\n          {% assign assembled_width = product.metafields.sf_products.assembled_width %}\n          {% assign assembled_height = product.metafields.sf_products.assembled_height %}\n          {% assign assembled_depth = product.metafields.sf_products.assembled_depth %}\n          {% if assembled_width and assembled_height and assembled_depth %}\n            <div class=\"flex-item\">\n              <h3>Product Dimensions</h3>\n              <p>{{ assembled_width }} x {{ assembled_height }} x {{ assembled_depth }} in</p>\n            </div>\n          {% endif %}\n          {% assign folded_dimensions = product.metafields.sf_products.folded_dimensions %}\n          {% if folded_dimensions %}\n            <div class=\"flex-item\">\n              <h3>Folded Dimensions</h3>\n              <p>{{ folded_dimensions }}</p>\n            </div>\n          {% endif %}\n          {% assign package_width = product.metafields.sf_shipping.package_width %}\n          {% assign package_height = product.metafields.sf_shipping.package_height %}\n          {% assign package_depth = product.metafields.sf_shipping.package_depth %}\n          {% if package_width and package_height and package_depth %}\n            <div class=\"flex-item\">\n              <h3>Package Dimensions</h3>\n              <p>{{ package_width }} x {{ package_height }} x {{ package_depth }} in</p>\n            </div>\n          {% endif %}\n\n          {% assign assembled_weight = product.metafields.sf_products.assembled_weight %}\n          {% if assembled_weight %}\n            <div class=\"flex-item\">\n              <h3>Product Weight</h3>\n              <p>{{ assembled_weight }} lbs.</p>\n            </div>\n          {% endif %}\n          {% assign package_weight = product.metafields.sf_shipping.package_weight %}\n          {% if package_weight %}\n            <div class=\"flex-item\">\n              <h3>Package Weight</h3>\n              <p>{{ package_weight }} lbs.</p>\n            </div>\n          {% endif %}\n\n          {% assign carrier_weight_without_base = product.metafields.sf_car_seat.carrier_weight_without_base %}\n          {% if carrier_weight_without_base %}\n            <div class=\"flex-item\">\n              <h3>Weight w/o Base</h3>\n              <p>{{ carrier_weight_without_base }} lbs.</p>\n            </div>\n          {% endif %}\n\n          <!-- optional section -->\n          {% assign harness_rethread_method = product.metafields.sf_products.harness_rethread_method %}\n          {% assign harness_type = product.metafields.sf_products.harness_type %}\n          {% assign bubble_level = product.metafields.sf_car_seat.bubble_level %}\n          {% assign harness_covers = product.metafields.sf_car_seat.harness_covers %}\n          {% assign latch_install = product.metafields.sf_car_seat.latch_install %}\n          {% assign maturity = product.metafields.sf_products.maturity %}\n\n          {% if harness_rethread_method or harness_type %}\n            {% if harness_type %}\n              <div class=\"flex-item\">\n                <h3>Harness Type</h3>\n                <p>\n                  {{ harness_type }}\n                </p>\n              </div>\n            {% endif %}\n            {% if harness_rethread_method %}\n              <div class=\"flex-item\">\n                <h3>Harness Rethread</h3>\n                <p>\n                  {{ harness_rethread_method }}\n                </p>\n              </div>\n            {% endif %}\n          {% endif %}\n          {% if bubble_level or harness_covers or latch_install %}\n            {% if bubble_level == 1 %}\n              <div class=\"flex-item\">\n                <h3>Bubble Level</h3>\n                <p>Yes</p>\n              </div>\n            {% endif %}\n            {% if harness_covers == 1 %}\n              <div class=\"flex-item\">\n                <h3>Harness Covers</h3>\n                <p>Yes</p>\n              </div>\n            {% endif %}\n            {% if latch_installs == 1 %}\n              <div class=\"flex-item\">\n                <h3>Latch Install</h3>\n                <p>Yes</p>\n              </div>\n            {% endif %}\n          {% endif %}\n\n          <div class=\"flex-item\">\n            <h3>Assembly Required</h3>\n            {% assign assembly_switch_spec = product.metafields.sf_products.assembly_required %}\n            {% if assembly_switch_spec == 1 %}\n              <p>Yes</p>\n            {% else %}\n              <p>No</p>\n            {% endif %}\n          </div>\n          <div class=\"flex-item\">\n            {% assign my_switch = product.metafields.sf_gates.hardware_included %}\n            <h3>Hardware Included</h3>\n            {% if my_switch == 1 %}\n              <p>Yes</p>\n            {% else %}\n              <p>No</p>\n            {% endif %}\n          </div>",
            "title": "",
            "text": "",
            "link_label": "",
            "link": ""
          }
        },
