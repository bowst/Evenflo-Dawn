        "faq_tet3Bg": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "What kind of batteries does the nasal aspirator use?",
            "content": "<p>The nasal aspirator includes and uses a non-replaceable rechargeable lithium-ion battery.</p>"
          }
        },
        "faq_Khcpka": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How do I charge the nasal aspirator?",
            "content": "<p>The included USB-C Cable must be plugged into the back of the aspirator and can be plugged into any USB recharging receptor such as an adapter brick, laptop or an in-wall USB receptor.</p>"
          }
        },
        "faq_CRxmaW": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How long will it take to fully charge the nasal aspirator?",
            "content": "<p>Charging for approximately 1 hour 40 minutes (100 minutes) is recommended.</p>"
