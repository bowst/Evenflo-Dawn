        },
        "faq_Txq74n": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How long will one full charge last?",
            "content": "<p>One full charge will last for approximately 45 minutes.</p>"
          }
        },
        "faq_G4HJh8": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "What does the flashing yellow light mean?",
            "content": "<p>The flashing yellow light means the battery is low and needs to be recharged.</p>"
          }
        },
        "faq_7KUREY": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Is the battery replaceable?",
            "content": "<p>No, the battery is not replaceable and cannot be removed from the main body of the aspirator.</p>"
          }
        },
        "faq_Vh6NhR": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Is this nasal aspirator FDA CLEARED?",
            "content": "<p>The nasal aspirator is FDA CLEARED which means that the nasal aspirator is like other similar nasal aspirators already legally sold in the US market, that have been FDA approved.</p>"
          }
        },
        "faq_gnQ7R6": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Are all the materials free of chemicals?",
            "content": "<p>Yes. All parts of the nasal aspirator are made from BPA free and latex free materials.</p>"
          }
        },
        "faq_hbLCWA": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Which silicone tip should I use for an infant; which one should I use for a toddler?",
            "content": "<p>Choose the correct size tip based on the child’s age: The Bulbous-shaped tip with the narrow opening is recommended for children 0-2 years. The Cone-shaped tip with the wider opening is recommended for children 2+ years.</p>"
          }
        },
        "faq_VhR7FD": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can the nasal aspirator be used to clear my baby’s ears or mouth?",
            "content": "<p>No, the nasal aspirator is only for the child's nose. Do not use the nasal aspirator in baby’s ears or mouth.</p>"
          }
        },
        "faq_8aJ3LK": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can this nasal aspirator be used on adults?",
            "content": "<p>No, the nasal aspirator is for children’s use only within the age range of 0-12 years old.</p>"
          }
        },
        "faq_miAYWd": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can this nasal aspirator be used on pets?",
            "content": "<p>No, do not use the nasal aspirator on pets.</p>"
          }
        },
        "faq_ipUdwN": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Should baby be laying down or sitting to use?",
            "content": "<p>Hold the baby/child in an upright sitting position. Also, hold the aspirator in an upright position. This helps take advantage of gravity flow and helps to avoid blockages in the suction pump.</p>"
          }
        },
        "faq_qpJYi7": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "How do you clean the nasal aspirator?",
            "content": "<p>Both the silicone tips and the collection cup can be cleaned by rinsing well with hot water between uses to prevent mucus from drying and clogging the suction pump. To disinfect (after an illness/as needed): After washing, boil the tip and collection cup for 3-5 minutes. The nasal aspirator main body can be wiped down with a damp cloth.</p>"
          }
        },
        "faq_ecfBxM": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can the silicone tips and collection cup be disinfected in the microwave?",
            "content": "<p>No. DO NOT disinfect the nasal aspirator tips or collection cup in the microwave.</p>"
          }
        },
        "faq_B4q4Ji": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Are the silicone tips and collection cup dishwasher safe?",
            "content": "<p>Yes. The silicone tips and collection cup may be washed in the dishwasher on the top rack only.v</p>"
          }
        },
        "faq_aN8g6K": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Can an alcohol swab be used to clean/disinfect the silicone tips and the collection cup?",
            "content": "<p>No. We recommend using non-abrasive soap and water between uses to prevent mucus from drying and clogging the suction pump. To disinfect after an illness or as needed, wash the tips then boil the tips and collection cup for 3-5 minutes. The nasal aspirator main body can be wiped down with a damp cloth.</p>"
          }
        },
        "faq_h7Q9ew": {
          "type": "faq",
          "settings": {
            "checkbox_expanded": false,
            "title": "Are both silicone tips, the collection cup and USB-C cable available for replacement?",
            "content": "<p>Yes. The two silicone tips, the collection cup and the USB-C cable cord are available for replacement. Please contact Evenflo ParentLink at <a href=\"http://www.evenflo.com/\">www.Evenflo.com</a> or 1-800-233-5921.</p>"
          }
        },
