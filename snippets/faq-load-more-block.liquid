{% comment %} Skeleton for faq-load-more-block {% endcomment %}

<style>
  .faq-skeleton.placeholder-item {
    background: #f1f1f1;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 16px;
    animation: pulse 1.5s infinite;
  }

  .faq-skeleton-line {
    height: 16px;
    background: #e0e0e0;
    margin-bottom: 10px;
    border-radius: 4px;
  }

  .faq-skeleton-line.short { width: 50%; }
  .faq-skeleton-line.medium { width: 75%; }
  .faq-skeleton-line.long { width: 100%; }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.5; }
    100% { opacity: 1; }
  }
</style>

<template id="faqSkeletonTemplate">
  <div class="faq-skeleton placeholder-item">
    <div class="faq-skeleton-line long"></div>
    <div class="faq-skeleton-line medium"></div>
    <div class="faq-skeleton-line short"></div>
  </div>
</template>

<script>
function fetchFAQsByFilters({
  categoryID = "",
  filter = "",
  topicsID = "",
  page = 1,
  productID = "",
  collectionID = "",
  popular = false,
  appendTo = "searchListigBody",
  showLoadMore = true,
}) {
  const container = document.getElementById(appendTo);
  if (!container) {
    console.error("Container not found:", appendTo);
    return;
  }

  const template = document.getElementById("faqSkeletonTemplate");
  const count = parseInt(document.getElementById("categoryRelatedBlock")?.dataset?.faqsToShow || 3);

  if (page === 1) container.innerHTML = "";

  for (let i = 0; i < count; i++) {
    const skeleton = template.content.cloneNode(true);
    container.appendChild(skeleton);
  }

  const loadMoreBtn = document.getElementById("loadMoreBtn");
  if (loadMoreBtn && showLoadMore) loadMoreBtn.style.display = "none";

  const url = `${evenFloFAQURL}faqs/getFilteredFaqs?filter=${filter}&page=${page}&category_id=${categoryID}&topics_id=${topicsID}&product_id=${productID}&collection_id=${collectionID}&popular=${popular}`;

  fetch(url)
    .then(res => res.json())
    .then(data => {
      container.querySelectorAll(".placeholder-item").forEach(el => el.remove());

      const results = popular ? data.results?.slice(0, count) : data.results;

      results?.forEach(product => {
        const card = document.createElement("div");
        card.className = "popular-card";
        card.innerHTML = `<h3>${product.question}</h3><p>${product.answer}</p>`;
        container.appendChild(card);
      });

      if (loadMoreBtn && showLoadMore && data.next) {
        loadMoreBtn.style.display = "block";
      }
    })
    .catch(err => {
      console.error("Fetch failed", err);
      container.innerHTML = "<p>Error loading FAQs.</p>";
    });
}
</script>
