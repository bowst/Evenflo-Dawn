{% comment %}
  Dimensions & Fit tab: Modes of Use, Dimensions diagram, Child fit (evenflo-product-specifications).
{% endcomment %}
{%- liquid
  assign modes_raw = product.metafields.custom.modes_of_use
  assign modes_of_use = modes_raw | replace: '|', '<br>'
  assign specifications_image = product.metafields.sf_products.specifications_image
-%}

{% capture child_fit_markup %}
  {% render 'evenflo-pdp-tab-child-fit' %}
{% endcapture %}
{% assign child_fit_markup = child_fit_markup | strip %}

{%- liquid
  assign show_modes = false
  if modes_of_use != blank and modes_of_use != ''
    assign show_modes = true
  endif

  assign show_diagram = false
  if specifications_image != blank
    assign show_diagram = true
  endif

  assign show_child = false
  if child_fit_markup != blank
    assign show_child = true
  endif
-%}

{%- if show_modes or show_diagram or show_child -%}
  <div class="dimensions-fit">
    {%- if show_modes -%}
      <div class="info-block">
        <h4 class="h3">Modes of Use</h4>
        <div class="info-body rte">{{ modes_of_use }}</div>
      </div>
    {%- endif -%}

    {%- if show_diagram -%}
      <div class="info-block">
        <h4 class="h3">Dimensions Diagram</h4>
        <div class="info-diagram">
          <img
            class="specifications-image"
            src="{{ specifications_image }}"
            width="100%"
            height="auto"
            loading="lazy"
            alt="{{ product.title | escape }} dimensions diagram"
          >
        </div>
      </div>
    {%- endif -%}

    {%- if show_child -%}
      <div class="info-block">
        <h4 class="h3">Child Fit Requirements</h4>
        {{ child_fit_markup }}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
