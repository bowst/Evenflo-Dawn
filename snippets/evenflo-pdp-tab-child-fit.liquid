{% comment %}
  Child fit requirements (from evenflo-product-specifications column 3), without Modes of Use
  (Modes live in evenflo-pdp-tab-dimensions-fit).
{% endcomment %}
{%- liquid
  assign min_weight = product.metafields.sf_products.child_weight_min
  assign max_weight = product.metafields.sf_products.child_weight_max
  assign child_weight_min_value = product.metafields.sf_products.child_weight_min
  assign child_weight_max_value = product.metafields.sf_products.child_weight_max
  assign min_height = product.metafields.sf_products.child_height_min
  assign max_height = product.metafields.sf_products.child_height_max
  assign min_age = product.metafields.sf_products.child_age_min
  assign max_age = product.metafields.sf_products.child_age_max
  assign age_group = product.metafields.sf_products.age_group

  assign rear_facing_weight_min = product.metafields.sf_car_seat.rear_facing_weight_min
  assign rear_facing_weight_max = product.metafields.sf_car_seat.rear_facing_weight_max
  assign rear_facing_height_min = product.metafields.sf_car_seat.rear_facing_height_min
  assign rear_facing_height_max = product.metafields.sf_car_seat.rear_facing_height_max
  assign rear_facing_fit_statement = product.metafields.sf_car_seat.rear_facing_fit_statement

  assign forward_facing_weight_min = product.metafields.sf_car_seat.forward_facing_weight_min
  assign forward_facing_weight_max = product.metafields.sf_car_seat.forward_facing_weight_max
  assign forward_facing_height_min = product.metafields.sf_car_seat.forward_facing_height_min
  assign forward_facing_height_max = product.metafields.sf_car_seat.forward_facing_height_max
  assign forward_facing_fit_statement = product.metafields.sf_car_seat.forward_facing_fit_statement
  assign forward_facing_height_limit = product.metafields.sf_products.forward_facing_height_limit
  assign forward_facing = product.metafields.custom.forward_facing.value

  assign high_back_weight_min = product.metafields.sf_car_seat.high_back_weight_min
  assign high_back_weight_max = product.metafields.sf_car_seat.high_back_weight_max
  assign high_back_height_min = product.metafields.sf_car_seat.high_back_height_min
  assign high_back_height_max = product.metafields.sf_car_seat.high_back_height_max
  assign high_back_fit_statement = product.metafields.sf_car_seat.high_back_fit_statement

  assign no_back_weight_min = product.metafields.sf_car_seat.no_back_weight_min
  assign no_back_weight_max = product.metafields.sf_car_seat.no_back_weight_max
  assign no_back_height_min = product.metafields.sf_car_seat.no_back_height_min
  assign no_back_height_max = product.metafields.sf_car_seat.no_back_height_max
  assign no_back_fit_statement = product.metafields.sf_car_seat.no_back_fit_statement

  assign harness_age_limit = product.metafields.sf_car_seat.harness_age_limit
  assign harness_booster_fit_statement = product.metafields.sf_car_seat.harness_booster_fit_statement
  assign harness_booster_mode_height_limit = product.metafields.custom.harness_booster_mode_height_limit.value
  assign harness_booster_mode_weight_limit = product.metafields.custom.harness_booster_mode_weight_limit.value

  assign show_shared = false
  if child_weight_min_value or child_weight_max_value
    assign show_shared = true
  elsif min_weight and max_weight
    assign show_shared = true
  elsif min_height and max_height
    assign show_shared = true
  elsif age_group != blank
    assign show_shared = true
  elsif min_age != blank or max_age != blank
    assign show_shared = true
  endif

  assign show_rear = false
  if rear_facing_weight_min and rear_facing_weight_max and rear_facing_height_min and rear_facing_height_max
    assign show_rear = true
  endif

  assign show_forward = false
  if product.metafields.custom.forward_facing != blank and forward_facing == true
    assign show_forward = true
  endif

  assign show_high_back = false
  if high_back_weight_min or high_back_weight_max or high_back_height_min or high_back_height_max
    assign show_high_back = true
  endif

  assign show_no_back = false
  if no_back_weight_min or no_back_weight_max or no_back_height_min or no_back_height_max
    assign show_no_back = true
  endif

  assign show_harness_booster = false
  if harness_age_limit != blank or harness_booster_fit_statement != blank or product.metafields.custom.harness_booster_mode_height_limit != blank or product.metafields.custom.harness_booster_mode_weight_limit != blank
    assign show_harness_booster = true
  endif

  assign show_child_fit = false
  if show_shared or show_rear or show_forward or show_high_back or show_no_back or show_harness_booster
    assign show_child_fit = true
  endif
-%}

{%- if show_child_fit -%}
  <div class="child-fit">
    {%- if show_shared -%}
      <div>
        <ul class="specs-list no-bullets">
          {%- if child_weight_min_value or child_weight_max_value -%}
            <li>
              Child Weight:;
              {%- if child_weight_min_value -%}
                {{ child_weight_min_value }} -
              {%- endif -%}
              {%- if child_weight_max_value -%}
                {{ child_weight_max_value }} lbs
              {%- endif -%}
            </li>
          {%- elsif min_weight and max_weight -%}
            <li>Weight: {{ min_weight }} - {{ max_weight }} lbs</li>
          {%- endif -%}
          {%- if min_height and max_height -%}
            <li>Height: {{ min_height }} - {{ max_height }} inches</li>
          {%- endif -%}
          {%- if age_group -%}
            <li>Age Group: {{ age_group }}</li>
          {%- endif -%}
          {%- if min_age -%}
            <li>Minimum Age: {{ min_age }}</li>
          {%- endif -%}
          {%- if max_age -%}
            <li>Maximum Age: {{ max_age }}</li>
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}

    {% comment %} {%- if show_rear -%} {% endcomment %}
    <div>
      <h4 class="h5">Rear-Facing Mode</h4>
      <ul class="specs-list no-bullets">
        <li>Weight: {{ rear_facing_weight_min }} - {{ rear_facing_weight_max }} lbs</li>
        <li>Height: {{ rear_facing_height_min }} - {{ rear_facing_height_max }} in</li>
      </ul>
      {%- if rear_facing_fit_statement -%}
        <div class="tab-note">{{ rear_facing_fit_statement }}</div>
      {%- endif -%}
    </div>
    {% comment %} {%- endif -%} {% endcomment %}

    {% comment %} {%- if show_forward -%} {% endcomment %}
    <div>
      <h4 class="h5">Forward-Facing Mode</h4>
      <ul class="specs-list no-bullets">
        {%- if forward_facing_weight_min and forward_facing_weight_max -%}
          <li>Weight: {{ forward_facing_weight_min }} - {{ forward_facing_weight_max }} lbs</li>
        {%- endif -%}
        {%- if forward_facing_height_limit != blank -%}
          <li>Height: {{ forward_facing_height_limit }}</li>
        {%- elsif forward_facing_height_min and forward_facing_height_max -%}
          <li>Height: {{ forward_facing_height_min }} - {{ forward_facing_height_max }} in</li>
        {%- endif -%}
      </ul>
      {%- if forward_facing_fit_statement -%}
        <div class="tab-note">{{ forward_facing_fit_statement }}</div>
      {%- endif -%}
    </div>
    {% comment %} {%- endif -%} {% endcomment %}

    {% comment %} {%- if show_high_back -%} {% endcomment %}
    <div>
      <h4 class="h5">High Back Booster Mode</h4>
      <ul class="specs-list">
        {%- if high_back_fit_statement -%}
          <li>Weight: {{ high_back_weight_min }} - {{ high_back_weight_max }} lbs</li>
          <li>Height: {{ high_back_height_min }} - {{ high_back_height_max }} in</li>
        {%- endif -%}
      </ul>
      {%- if high_back_fit_statement -%}
        <div class="info-note">{{ high_back_fit_statement }}</div>
      {%- endif -%}
    </div>
    {% comment %} {%- endif -%} {% endcomment %}

    {% comment %} {%- if show_no_back -%} {% endcomment %}
    <div>
      <h4 class="h5">No Back Booster Mode</h4>
      <ul class="specs-list">
        {%- if no_back_weight_max -%}
          <li>Weight: {{ no_back_weight_min }} - {{ no_back_weight_max }} lbs</li>
        {%- endif -%}
        {%- if no_back_height_max -%}
          <li>Height: {{ no_back_height_min }} - {{ no_back_height_max }} in</li>
        {%- endif -%}
      </ul>
      {%- if no_back_fit_statement -%}
        <div class="info-note">{{ no_back_fit_statement }}</div>
      {%- endif -%}
    </div>
    {% comment %} {%- endif -%} {% endcomment %}

    {%- if show_harness_booster -%}
      <hr>
      <div>
        <h4 class="h5">Harness Booster Mode</h4>
        <ul class="specs-list no-bullets">
          {%- if harness_age_limit != blank -%}
            <li>Harness Booster Mode Age Limit: {{ harness_age_limit }}</li>
          {%- endif -%}
          {%- if harness_booster_fit_statement != blank -%}
            <li>Harness Booster Fit Limitation: {{ harness_booster_fit_statement }}</li>
          {%- endif -%}
          {%- if product.metafields.custom.harness_booster_mode_height_limit != blank -%}
            <li>Harness Booster Mode Height Limit: {{ harness_booster_mode_height_limit }}</li>
          {%- endif -%}
          {%- if product.metafields.custom.harness_booster_mode_weight_limit != blank -%}
            <li>Harness Booster Mode Weight Limit: {{ harness_booster_mode_weight_limit }}</li>
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
