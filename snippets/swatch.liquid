{% comment %}
  Renders a swatch component.
  Accepts:
  - swatch: {Object} a swatch object
  - swatch_value: {String} optional precomputed CSS background (url(...) or rgb(...))
  - swatch_focal_point: {String} optional focal point for precomputed swatch
  - shape: {String} swatch shape. Accepts 'square', defaults to circle.

  Usage:
  {% render 'swatch',
    swatch: value.swatch
    shape: 'square'
  %}
{% endcomment %}

{%- liquid
  assign resolved_swatch_value = swatch_value
  assign resolved_focal_point = swatch_focal_point

  if resolved_swatch_value == null
    if swatch.image != blank
      assign image_url = swatch.image | image_url: width: 50
      assign resolved_swatch_value = 'url(' | append: image_url | append: ')'
      assign resolved_focal_point = swatch.image.presentation.focal_point
    elsif swatch.color != blank
      assign resolved_swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')'
    endif
  endif
-%}

<span
  {% if resolved_swatch_value %}
    class="swatch{% if shape == 'square' %} swatch--square{% endif %}"
    style="--swatch--background: {{ resolved_swatch_value }};{% if resolved_focal_point %} --swatch-focal-point: {{ resolved_focal_point }};{% endif %}"
  {% else %}
    class="swatch swatch--unavailable{% if shape == 'square' %} swatch--square{% endif %}"
  {% endif %}
></span>
