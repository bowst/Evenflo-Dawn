{% comment %}
  Renders banner background images with optional video overlay.
  Images always render as fallback/placeholder; video plays on top when set.

  Accepts:
  - wrapper_class: {String} Wrapper class (e.g. hero-banner-image)
  - desktop_image: {Image}
  - mobile_image: {Image}
  - desktop_video: {Video}
  - mobile_video: {Video}
  - enable_video_looping: {Boolean}
  - alt_text: {String}
  - eager: {Boolean} LCP image: loading="eager" + fetchpriority="high". Default lazy.
{% endcomment %}

{{ 'evenflo-banner-background-media.css' | asset_url | stylesheet_tag }}

{%- liquid
  if eager
    assign image_loading = 'eager'
  else
    assign image_loading = 'lazy'
  endif

  assign has_desktop_video = false
  if desktop_video != blank
    assign has_desktop_video = true
  endif

  assign mobile_video_source = desktop_video
  if mobile_video != blank
    assign mobile_video_source = mobile_video
  endif

  assign has_fallback_image = false
  if desktop_image != blank or mobile_image != blank
    assign has_fallback_image = true
  elsif mobile_video_source.preview_image != blank
    assign has_fallback_image = true
  elsif desktop_video.preview_image != blank
    assign has_fallback_image = true
  endif

  assign image_alt = alt_text | default: ''

  assign picture_desktop = desktop_image
  if picture_desktop == blank and desktop_video.preview_image != blank
    assign picture_desktop = desktop_video.preview_image
  endif

  assign picture_mobile = mobile_image
  if picture_mobile == blank and mobile_video_source.preview_image != blank
    assign picture_mobile = mobile_video_source.preview_image
  endif
  if picture_mobile == blank
    assign picture_mobile = picture_desktop
  endif
  if picture_desktop == blank
    assign picture_desktop = picture_mobile
  endif

  assign picture_dimensions = picture_mobile | default: picture_desktop
-%}

<div class="{{ wrapper_class }}{% if has_desktop_video %} has-video-background{% unless has_fallback_image %} has-video-background--no-image{% endunless %}{% endif %}">
  {%- if picture_desktop != blank -%}
    <picture class="banner-background__picture">
      {%- if picture_mobile != blank -%}
        <source media="(max-width: 767px)" srcset="{{ picture_mobile | image_url: width: 768 }}">
      {%- endif -%}
      <img
        src="{{ picture_desktop | image_url: width: 1600 }}"
        alt="{{ image_alt | escape }}"
        width="{{ picture_dimensions.width }}"
        height="{{ picture_dimensions.height }}"
        class="desktop-image banner-background__image"
        loading="{{ image_loading }}"
        {% if eager %}fetchpriority="high"{% endif %}
      >
    </picture>
  {%- endif -%}

  {%- if has_desktop_video -%}
    <div class="banner-background__video banner-background__video--desktop">
      {{
        desktop_video
        | video_tag:
          image_size: '1600x',
          autoplay: true,
          loop: enable_video_looping,
          controls: false,
          muted: true,
          playsinline: true,
          preload: 'auto'
      }}
    </div>

    <div class="banner-background__video banner-background__video--mobile">
      {%- if mobile_video != blank -%}
        {{
          mobile_video
          | video_tag:
            image_size: '768x',
            autoplay: true,
            loop: enable_video_looping,
            controls: false,
            muted: true,
            playsinline: true,
            preload: 'auto'
        }}
      {%- else -%}
        {{
          desktop_video
          | video_tag:
            image_size: '768x',
            autoplay: true,
            loop: enable_video_looping,
            controls: false,
            muted: true,
            playsinline: true,
            preload: 'auto'
        }}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
