{% comment %}
  Comma-separated Fit Guide mode keys for a product.
  Keys: rear, forward, booster, high-back, no-back
  A mode shows only when its boolean metafield is true.
  Keep in sync with evenflo-fit-guide-detail tab visibility.
{% endcomment %}
{%- liquid
  assign rear_mode = product.metafields.custom.rear_facing.value
  assign forward_mode = product.metafields.custom.forward_facing.value
  assign high_back_mode = product.metafields.custom.high_back_booster.value
  assign no_back_mode = product.metafields.custom.no_back_booster.value
  # Generic Booster tag disabled. It came from has_harness_booster_mode, separate from high-back and no-back.
  # assign harness_mode = product.metafields.sf_car_seat.has_harness_booster_mode.value

  assign show_rear = false
  if rear_mode == true
    assign show_rear = true
  endif

  assign show_forward = false
  if forward_mode == true
    assign show_forward = true
  endif

  assign show_high_back = false
  assign show_no_back = false
  if high_back_mode == true
    assign show_high_back = true
  endif
  if no_back_mode == true
    assign show_no_back = true
  endif

  # assign show_booster = false
  # if harness_mode == true or harness_mode == 1
  #   assign show_booster = true
  # endif

  assign keys = ''
  if show_rear
    assign keys = keys | append: 'rear,'
  endif
  if show_forward
    assign keys = keys | append: 'forward,'
  endif
  # if show_booster
  #   assign keys = keys | append: 'booster,'
  # endif
  if show_high_back
    assign keys = keys | append: 'high-back,'
  endif
  if show_no_back
    assign keys = keys | append: 'no-back,'
  endif
  assign keys = keys | split: ',' | compact | join: ','
-%}
{{- keys -}}
