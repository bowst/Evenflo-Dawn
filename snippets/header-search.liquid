{% comment %}
  Renders a header search modal. Should be used with 'header.liquid'

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-search', input_id: 'My-Id'%}
{% endcomment %}

{% comment %}
  Evenflo custom header search.
  Desktop: icon-only until expanded.
  Mobile: default visible search form behavior.
{% endcomment %}

{{ 'header-search.css' | asset_url | stylesheet_tag }}

<div
  class="header-search-expandable{% if is_primary %} header-search-expandable--primary{% endif %}"
  data-evenflo-search="1"
  {% if is_primary %}data-evenflo-search-primary{% endif %}
>
  <button
    type="button"
    class="header__icon header__icon--search header-search-toggle"
    aria-label="{{ 'general.search.search' | t }}"
    aria-expanded="false"
  >
    <span class="svg-wrapper header-search-toggle__icon-search">
      {{- 'icon-search.svg' | inline_asset_content -}}
    </span>
    <span class="svg-wrapper header-search-toggle__icon-close">
      {{- 'icon-close.svg' | inline_asset_content -}}
    </span>
  </button>

  <div class="header-search-form-wrapper">
    {%- if settings.predictive_search_enabled -%}
      <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}" data-upgraded="true">
    {%- else -%}
      <search-form class="search-modal__form">
    {%- endif -%}
    <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
      <div class="field">
        <input
          class="search__input field__input"
          id="{{ input_id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.search' | t }}"
          {%- if settings.predictive_search_enabled -%}
            role="combobox"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            autocorrect="off"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          {%- endif -%}
        >
        <label class="field__label" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
        <input type="hidden" name="options[prefix]" value="last">
        <button
          type="reset"
          class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
          aria-label="{{ 'general.search.reset' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-reset.svg' | inline_asset_content -}}
          </span>
        </button>
        <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
          <span class="svg-wrapper">
            {{- 'icon-search.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      {%- if settings.predictive_search_enabled -%}
        <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
          {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
        </div>
        <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
      {%- endif -%}
    </form>
    {%- if settings.predictive_search_enabled -%}
      </predictive-search>
    {%- else -%}
      </search-form>
    {%- endif -%}
  </div>
</div>

{%- if is_primary -%}
<script>
  (function () {
    var MOBILE_MAX_WIDTH = 1100;
    var controllers = [];
    var primaryController = null;
    var searchWasOpenOnPointerDown = false;

    function isMobileSearch() {
      return window.matchMedia('(max-width: ' + MOBILE_MAX_WIDTH + 'px)').matches;
    }

    function updateMobileSearchTop() {
      var headerEl = document.querySelector('.section-header');
      var top = headerEl ? headerEl.getBoundingClientRect().bottom : 0;
      document.documentElement.style.setProperty('--evenflo-header-search-top', top + 'px');
    }

    function isGloboSearchTrigger(target) {
      var link = target && target.closest ? target.closest('a[href="gm-open:Search"]') : null;
      return !!link;
    }

    function closeGloboSearchPanels() {
      document.querySelectorAll('.gm-bb-panel, [id^="gm-bb-panel-"]').forEach(function (panel) {
        panel.classList.remove('gm-active', 'is-open', 'active');
        panel.setAttribute('hidden', '');
        panel.style.display = 'none';
      });
      document.querySelectorAll('a.gm-bb-item-box[aria-expanded="true"]').forEach(function (item) {
        item.setAttribute('aria-expanded', 'false');
      });
    }

    function handleGloboSearchTrigger(event) {
      if (!isGloboSearchTrigger(event.target) || !primaryController) return;
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();
      closeGloboSearchPanels();
      primaryController.toggle();
    }

    function createController(container) {
      var toggle = container.querySelector('.header-search-toggle');
      var input = container.querySelector('.search__input');

      if (!toggle || !input) return null;

      function closeSearch() {
        container.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('evenflo-header-search-open');
        if (input) {
          input.value = '';
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      function openSearch() {
        if (isMobileSearch()) {
          updateMobileSearchTop();
        }

        container.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('evenflo-header-search-open');

        setTimeout(function () {
          input.focus();
        }, 120);
      }

      function toggleSearch() {
        if (container.classList.contains('is-open')) {
          closeSearch();
        } else {
          openSearch();
        }
      }

      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        toggleSearch();
      });

      return {
        container: container,
        open: openSearch,
        close: closeSearch,
        toggle: toggleSearch,
        isOpen: function () {
          return container.classList.contains('is-open');
        },
        handleOutsideClick: function (event) {
          if (!container.classList.contains('is-open')) return;
          if (!searchWasOpenOnPointerDown) return;
          if (container.contains(event.target)) return;
          if (isGloboSearchTrigger(event.target)) return;
          closeSearch();
        },
      };
    }

    function initEvenfloHeaderSearch() {
      if (window.__evenfloHeaderSearchInitialized) return;
      window.__evenfloHeaderSearchInitialized = true;

      document.querySelectorAll('.header-search-expandable[data-evenflo-search]').forEach(function (container) {
        if (container.dataset.evenfloInit === 'true') return;
        container.dataset.evenfloInit = 'true';

        var controller = createController(container);
        if (!controller) return;

        controllers.push(controller);

        if (container.hasAttribute('data-evenflo-search-primary')) {
          primaryController = controller;
        }
      });

      if (!primaryController && controllers.length) {
        primaryController = controllers.find(function (controller) {
          return controller.container.closest('.header__icons');
        }) || controllers[0];
      }

      document.addEventListener('pointerdown', function () {
        searchWasOpenOnPointerDown = primaryController ? primaryController.isOpen() : false;
      }, true);

      document.addEventListener('click', handleGloboSearchTrigger, true);

      document.addEventListener('click', function (event) {
        controllers.forEach(function (controller) {
          controller.handleOutsideClick(event);
        });
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          controllers.forEach(function (controller) {
            if (controller.isOpen()) controller.close();
          });
        }
      });

      window.addEventListener('resize', function () {
        if (!isMobileSearch()) return;
        controllers.forEach(function (controller) {
          if (controller.isOpen()) updateMobileSearchTop();
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEvenfloHeaderSearch);
    } else {
      initEvenfloHeaderSearch();
    }
  })();
</script>
{%- endif -%}
