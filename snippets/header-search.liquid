{% comment %}
  Renders a header search modal. Should be used with 'header.liquid'

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-search', input_id: 'My-Id'%}
{% endcomment %}

{% comment %}
  Evenflo custom header search.
  Desktop: icon-only until expanded.
  Mobile: default visible search form behavior.
{% endcomment %}

<style>
  .header-search-expandable {
    display: flex;
    align-items: center;
    position: relative;
  }

  .header-search-toggle .header-search-toggle__icon-close {
    display: none;
  }

  .header-search-expandable.is-open .header-search-toggle .header-search-toggle__icon-search {
    display: none;
  }

  .header-search-expandable.is-open .header-search-toggle .header-search-toggle__icon-close {
    display: inline-flex;
  }

  @media screen and (max-width: 1100px) {
    .header-search-expandable {
      display: none !important;
    }

    .header-search-expandable.is-open {
      display: block !important;
      position: fixed;
      top: var(--evenflo-header-search-top, var(--header-height, 0px));
      left: 0;
      right: 0;
      z-index: 999;
      background-color: rgb(var(--color-background));
      box-shadow: 0 0.2rem 0.6rem rgba(var(--color-foreground), 0.08);
    }

    .header-search-expandable.is-open .header-search-toggle {
      display: none;
    }

    .header-search-expandable.is-open .header-search-form-wrapper {
      position: relative;
      z-index: 1;
      width: 100% !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      overflow: visible !important;
      transform: none;
      padding: 0 1.6rem 1.2rem;
    }

    .header-search-expandable.is-open .header-search-form-wrapper .search,
    .header-search-expandable.is-open .header-search-form-wrapper .search-modal__form,
    .header-search-expandable.is-open .header-search-form-wrapper > predictive-search.search-modal__form,
    .header-search-expandable.is-open .header-search-form-wrapper > search-form.search-modal__form {
      width: 100%;
      min-width: 0;
      max-width: none;
      position: static !important;
    }

    body.evenflo-header-search-open {
      overflow: hidden;
    }
  }

  @media screen and (min-width: 1101px) {
    .header-search-toggle {
      display: inline-flex;
      position: relative;
      z-index: 61;
      align-items: center;
      justify-content: center;
	  border: none;
	  background: transparent;
    }

    .header-search-form-wrapper {
      position: absolute;
      right: calc(100% + 0.8rem);
      top: 50%;
      transform: translateY(-50%);
      width: 0 !important;
      opacity: 0 !important;
      pointer-events: none !important;
      overflow: hidden !important;
      transition: width 0.3s ease, opacity 0.2s ease;
      z-index: 60;
      background-color: rgb(var(--color-background));
    }

    .header-search-expandable.is-open .header-search-form-wrapper {
      width: 36rem !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      overflow: visible !important;
    }

    .header-search-form-wrapper .search,
    .header-search-form-wrapper .search-modal__form,
    .header-search-form-wrapper > predictive-search.search-modal__form,
    .header-search-form-wrapper > search-form.search-modal__form {
      width: 36rem;
      min-width: 36rem;
      max-width: none;
      position: static !important;
      top: auto !important;
      left: auto !important;
      padding: 0 !important;
      background: transparent !important;
    }

    .header-search-form-wrapper .predictive-search {
      z-index: 62;
    }

    .header-search-form-wrapper .field {
      margin: 0;
    }
  }
</style>

<div
  class="header-search-expandable{% if is_primary %} header-search-expandable--primary{% endif %}"
  data-evenflo-search="1"
  {% if is_primary %}data-evenflo-search-primary{% endif %}
>
  <button
    type="button"
    class="header__icon header__icon--search header-search-toggle"
    aria-label="{{ 'general.search.search' | t }}"
    aria-expanded="false"
  >
    <span class="svg-wrapper header-search-toggle__icon-search">
      {{- 'icon-search.svg' | inline_asset_content -}}
    </span>
    <span class="svg-wrapper header-search-toggle__icon-close">
      {{- 'icon-close.svg' | inline_asset_content -}}
    </span>
  </button>

  <div class="header-search-form-wrapper">
    {%- if settings.predictive_search_enabled -%}
      <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}" data-upgraded="true">
    {%- else -%}
      <search-form class="search-modal__form">
    {%- endif -%}
    <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
      <div class="field">
        <input
          class="search__input field__input"
          id="{{ input_id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.search' | t }}"
          {%- if settings.predictive_search_enabled -%}
            role="combobox"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            autocorrect="off"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          {%- endif -%}
        >
        <label class="field__label" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
        <input type="hidden" name="options[prefix]" value="last">
        <button
          type="reset"
          class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
          aria-label="{{ 'general.search.reset' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-reset.svg' | inline_asset_content -}}
          </span>
        </button>
        <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
          <span class="svg-wrapper">
            {{- 'icon-search.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      {%- if settings.predictive_search_enabled -%}
        <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
          {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
        </div>
        <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
      {%- endif -%}
    </form>
    {%- if settings.predictive_search_enabled -%}
      </predictive-search>
    {%- else -%}
      </search-form>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var MOBILE_MAX_WIDTH = 1100;
    var controllers = [];
    var primaryController = null;

    function isMobileSearch() {
      return window.matchMedia('(max-width: ' + MOBILE_MAX_WIDTH + 'px)').matches;
    }

    function getPrimaryContainer() {
      return (
        document.querySelector('.header-search-expandable--primary[data-evenflo-search]') ||
        document.querySelector('.header__icons .header-search-expandable[data-evenflo-search]') ||
        document.querySelector('.header-search-expandable[data-evenflo-search]')
      );
    }

    function updateMobileSearchTop() {
      var headerEl = document.querySelector('.section-header');
      var top = headerEl ? headerEl.getBoundingClientRect().bottom : 0;
      document.documentElement.style.setProperty('--evenflo-header-search-top', top + 'px');
    }

    function createController(container) {
      var toggle = container.querySelector('.header-search-toggle');
      var input = container.querySelector('.search__input');

      if (!toggle || !input) return null;

      function closeSearch() {
        container.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('evenflo-header-search-open');
        if (input) {
          input.value = '';
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      function openSearch() {
        if (isMobileSearch()) {
          updateMobileSearchTop();
        }

        container.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('evenflo-header-search-open');

        setTimeout(function () {
          input.focus();
        }, 120);
      }

      function toggleSearch() {
        if (container.classList.contains('is-open')) {
          closeSearch();
        } else {
          openSearch();
        }
      }

      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        toggleSearch();
      });

      return {
        container: container,
        open: openSearch,
        close: closeSearch,
        toggle: toggleSearch,
        isOpen: function () {
          return container.classList.contains('is-open');
        },
        handleOutsideClick: function (event) {
          if (!container.classList.contains('is-open')) return;
          if (container.contains(event.target)) return;
          closeSearch();
        },
      };
    }

    function initEvenfloHeaderSearch() {
      document.querySelectorAll('.header-search-expandable[data-evenflo-search]').forEach(function (container) {
        if (container.dataset.evenfloInit === 'true') return;
        container.dataset.evenfloInit = 'true';

        var controller = createController(container);
        if (!controller) return;

        controllers.push(controller);

        if (container.hasAttribute('data-evenflo-search-primary')) {
          primaryController = controller;
        }
      });

      if (!primaryController && controllers.length) {
        primaryController = controllers.find(function (controller) {
          return controller.container.closest('.header__icons');
        }) || controllers[0];
      }

      window.evenfloHeaderSearch = {
        open: function () {
          if (primaryController) primaryController.open();
        },
        close: function () {
          if (primaryController) primaryController.close();
        },
        toggle: function () {
          if (primaryController) primaryController.toggle();
        },
        isOpen: function () {
          return primaryController ? primaryController.isOpen() : false;
        },
      };

      document.addEventListener('click', function (event) {
        controllers.forEach(function (controller) {
          controller.handleOutsideClick(event);
        });
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          controllers.forEach(function (controller) {
            if (controller.isOpen()) controller.close();
          });
        }
      });

      window.addEventListener('resize', function () {
        if (!isMobileSearch()) return;
        controllers.forEach(function (controller) {
          if (controller.isOpen()) updateMobileSearchTop();
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEvenfloHeaderSearch);
    } else {
      initEvenfloHeaderSearch();
    }
  })();
</script>
