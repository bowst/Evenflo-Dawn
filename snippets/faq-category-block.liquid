{{ 'section-evenflo-answer.css' | asset_url | stylesheet_tag }}

<div class="category-block">
  <div class="category-content-wrapper page-width">

    {% if show_title %}
    <div class="heading center">
      <h1>{{ category_title }}</h1>
    </div>
    {% endif %}

    <div class="category-tab-wrapper" id="categoryTabWrapper">

      <div id="categoriesContainer" class="tab-header" data-categories-to-show="{{ categories_to_show }}">
         <!-- Loader -->
         <div id="categoriesLoader" class="loader" style="display: none;"></div>
      </div>

      <div class="tab-body">
        <div class="tab-content-wrapper" id="productsByCategory" data-faqs-to-show="{{ products_to_show }}">
          <!-- Loader -->
          <div id="productByCategoriesLoader" class="loader" style="display: none;"></div>
        </div>
      </div>

      {% if show_title %}
        <div class="browse-categories" id="browseCategoriesDiv">
        </div>
      {% endif %}

    </div>
  </div>
</div>

<style>
  /* Skeleton Loading Styles for Categories */
  .categories-loading .tab-header {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .categories-loading .categoriesSkeleton {
    width: 145px;
    height: 38px;
    background: #f1f2f3;
    border-radius: 8px;
    position: relative;
    overflow: hidden;
  }

  .categories-loading .categoriesSkeleton::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
    animation: shimmer 1.5s infinite;
  }

  /* Skeleton Loading Styles for Products */
  .products-loading #productsByCategory {
    width: 292px;
    height: 322px;
    background: #f1f2f3;
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    margin: 0 auto;
  }

  .products-loading #productsByCategory::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
    animation: shimmer 1.5s infinite;
  }

  /* Shimmer Animation */
  @keyframes shimmer {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }
  }
</style>

<script>
  function getPaginatedCategories() {
    const categoryWrapper = document.getElementById('categoryTabWrapper');
    const categoriesContainer = document.getElementById('categoriesContainer');
    
    // Add skeleton loading class for categories
    categoryWrapper.classList.add('categories-loading');
    
    // Show category skeleton
    categoriesContainer.innerHTML = `
      <div class="categoriesSkeleton"></div>
      <div class="categoriesSkeleton"></div>
      <div class="categoriesSkeleton"></div>
      <div class="categoriesSkeleton"></div>
      <div class="categoriesSkeleton"></div>
    `;
    
    fetch(evenFloFAQURL + 'products/getAllCategories?show=true')
      .then(response => response.json())
      .then(data => {
        getProductsByCategory(data[0]?.id, data[0]?.category_name);

        const categoriesBlock = document.getElementById('categoriesContainer');
        const blocksToShow = categoriesBlock ? categoriesBlock.dataset.categoriesToShow : 3;
        
        const container = document.querySelector('.tab-header'); 
        container.innerHTML = ""; // Clear skeleton

        data?.forEach((category, index) => {
          const categoryTag = document.createElement('button');
    
          const isActive = index === 0 ? "active" : "";
          if (isActive) {
            categoryTag.classList.add(isActive);
          }
          
          categoryTag.innerHTML = category?.category_name;

          // Appending an onclick function to all the buttons
          categoryTag.onclick = function() {
            // Removing "active" class from all buttons inside the .tab-header container
            const allButtons = container.querySelectorAll('button');
            allButtons.forEach(button => button.classList.remove("active"));

            // Adding "active" class to the clicked button
            categoryTag.classList.add("active");

            // Fetch products for the selected category
            getProductsByCategory(category.id, category.category_name);
          };

          container.appendChild(categoryTag);
        });
      })
      .catch(error => {
        console.error('Error fetching categories:', error);
      })
      .finally(() => {
        // Remove skeleton loading class for categories
        categoryWrapper.classList.remove('categories-loading');
      });
  }

  function getProductsByCategory(categoryId, categoryName) {
    const categoryWrapper = document.getElementById('categoryTabWrapper');
    const productsContainer = document.getElementById('productsByCategory');
    
    // Add skeleton loading class for products
    categoryWrapper.classList.add('products-loading');
    
    // Clear products container for skeleton
    productsContainer.innerHTML = '';
    
    // Your existing fetch logic for products
    fetch(evenFloFAQURL + 'products/getProductsByCategory/' + categoryId)
      .then(response => response.json())
      .then(data => {
        // Your existing product rendering logic here
        let productsContent = "";
        data?.forEach(product => {
          productsContent += `
            <div class="product-content">
              <a href="/pages/evenflo-faq-product?pid=${product?.id}">
                <div class="product-img">
                  <img src="${product?.image}" alt="product" />
                </div>
                <div class="product-title">
                  ${product?.name}
                </div>
              </a>
            </div>`;
        });
        
        productsContainer.innerHTML = productsContent;
      })
      .catch(error => {
        console.error('Error fetching products:', error);
      })
      .finally(() => {
        // Remove skeleton loading class for products
        categoryWrapper.classList.remove('products-loading');
      });
  }

  document.addEventListener('DOMContentLoaded', () => {
    getPaginatedCategories();
  });
</script>