<div class="category-block">
  <div class="category-content-wrapper page-width">

    {% if show_title %}
    <div class="heading center">
      <h1>{{ category_title }}</h1>
    </div>
    {% endif %}

    <div class="category-tab-wrapper" id="categoryTabWrapper">

      <div id="categoriesContainer" class="tab-header" data-categories-to-show="{{ categories_to_show }}">
        <!-- Skeleton buttons injected here while loading -->
      </div>

      <div class="tab-body">
        <div class="tab-content-wrapper" id="productsByCategory" data-faqs-to-show="{{ products_to_show }}">
          <!-- Products skeleton injected here while loading -->
        </div>
      </div>

      {% if show_title %}
      <div class="browse-categories" id="browseCategoriesDiv"></div>
      {% endif %}

    </div>
  </div>
</div>

<style>
  /* Category buttons skeleton - centered */
  .tab-header.skeleton-loading {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding: 16px 0;
    flex-wrap: wrap; /* Wraps skeleton buttons if too many */
  }

  .tab-header.skeleton-loading .skeleton-tag {
    width: 145px;
    height: 32px;
    border-radius: 6px;
    background: #f1f2f3;
  }

  /* Skeleton for product categories with fixed size */
  .tab-content-wrapper.skeleton-loading > .content-inner {
    width: 292.8px;
    height: 322.8px;
    background: #f1f2f3;
    border-radius: 8px;
  }

  /* Skeleton for swiper-slide tab-card */
  .swiper-slide.tab-card.skeleton {
    width: 292.8px;
    height: 322.8px;
    background: #f1f2f3;
    border-radius: 8px;
  }

  /* Hide content inside skeleton while loading */
  .swiper-slide.tab-card.skeleton * {
    visibility: hidden;
  }

  /* Additional styles for content to make skeleton visible and positioned */
  .tab-content-wrapper.skeleton-loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    background: red;
  }
  .tab-content-wrapper.skeleton-loading .skeleton-card{
    background: blue;
    width: 292px;
    height: 322px;
  }

  .tab-content-wrapper.skeleton-loading .content-inner {
    background: #f1f2f3;
    border-radius: 8px;
    padding: 10px;
  }
.tab-content-wrapper.skeleton-loading #loader{
  display:none!important;
}
</style>

<script>
  // Skeleton markup for category buttons (10 placeholders)
  const categoriesSkeletonMarkup = `
    <button class="skeleton-tag"></button>
    <button class="skeleton-tag"></button>
    <button class="skeleton-tag"></button>
    <button class="skeleton-tag"></button>
    <button class="skeleton-tag"></button>
    <button class="skeleton-tag"></button>
    <button class="skeleton-tag"></button>
    <button class="skeleton-tag"></button>
    <button class="skeleton-tag"></button>
    <button class="skeleton-tag"></button>
  `;

  // Skeleton markup for products (fixed size container)
  const productsSkeletonMarkup = `
    <div class="swiper-slide tab-card skeleton-card"></div>
    <div class="swiper-slide tab-card skeleton-card"></div>
    <div class="swiper-slide tab-card skeleton-card"></div>
    <div class="swiper-slide tab-card skeleton-card"></div>
    <div class="swiper-slide tab-card skeleton-card"></div>
    <div class="swiper-slide tab-card skeleton-card"></div>
  `;

  function getPaginatedCategories() {
    const categoriesContainer = document.getElementById('categoriesContainer');
    const productsWrapper = document.getElementById('productsByCategory');
    if (!categoriesContainer || !productsWrapper) return;

    // Show skeleton loading for categories and products
    categoriesContainer.classList.add('skeleton-loading');
    categoriesContainer.innerHTML = categoriesSkeletonMarkup;

    productsWrapper.classList.add('skeleton-loading');
    productsWrapper.innerHTML = productsSkeletonMarkup;

    fetch(evenFloFAQURL + 'products/getAllCategories?show=true')
      .then(response => response.json())
      .then(data => {
        categoriesContainer.classList.remove('skeleton-loading');
        categoriesContainer.innerHTML = ""; // Clear skeleton

        if (!data || data.length === 0) {
          categoriesContainer.innerHTML = '<p>No categories found.</p>';
          return;
        }

        data.forEach((category, index) => {
          const categoryTag = document.createElement('button');
          if (index === 0) categoryTag.classList.add("active");
          categoryTag.textContent = category?.category_name;

          categoryTag.onclick = function() {
            const allButtons = categoriesContainer.querySelectorAll('button');
            allButtons.forEach(button => button.classList.remove("active"));
            categoryTag.classList.add("active");
            getProductsByCategory(category.id, category.category_name);
          };

          categoriesContainer.appendChild(categoryTag);
        });

        // Load products for first category by default
        getProductsByCategory(data[0].id, data[0].category_name);
      })
      .catch(error => {
        console.error('Error fetching categories:', error);
        categoriesContainer.classList.remove('skeleton-loading');
        categoriesContainer.innerHTML = '<p>Error loading categories</p>';
        productsWrapper.classList.remove('skeleton-loading');
        productsWrapper.innerHTML = '';
      });
  }

  function getProductsByCategory(categoryId, categoryName) {
    const productsWrapper = document.getElementById('productsByCategory');
    if (!productsWrapper) return;

    // Show skeleton for products while loading
    productsWrapper.classList.add('skeleton-loading');
    productsWrapper.innerHTML = productsSkeletonMarkup;

    fetch(evenFloFAQURL + 'products/getByCategory?id=' + categoryId)
      .then(response => response.json())
      .then(data => {
       

        // Render product content inside fixed size container
        const innerDiv = document.createElement('div');
        innerDiv.classList.add('content-inner');

        let html = '<ul style="padding: 10px; margin: 0; list-style: none;">';
        (data.products || []).forEach(product => {
          html += `<li>${product.name}</li>`;
        });
        html += '</ul>';

        innerDiv.innerHTML = html;
        // productsWrapper.innerHTML = '';
        productsWrapper.appendChild(innerDiv);

        // Also, remove skeleton from swiper-slide tab-card elements if you have them inside products
        document.querySelectorAll('.swiper-slide.tab-card').forEach(el => {
          el.classList.remove('skeleton');
        });
         // productsWrapper.classList.remove('skeleton-loading');

      })
      .catch(error => {
        console.error('Error fetching products:', error);
        productsWrapper.classList.remove('skeleton-loading');
        productsWrapper.innerHTML = '<p>Error loading products</p>';
      });
  }

  document.addEventListener('DOMContentLoaded', () => {
    getPaginatedCategories();
  });
</script>
