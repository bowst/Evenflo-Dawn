<!-- 1) Include Swiper’s CSS (in <head>) -->
<link
  rel="stylesheet"
  href="https://unpkg.com/swiper/swiper-bundle.min.css"
/>

<style>
  /* Skeleton shimmer */
  .tab-card.skeleton {
    width: 292px;
    height: 322px;
    background-color: #eee;
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }
  .tab-card.skeleton::before {
    content: "";
    position: absolute;
    top: 0; left: -150px;
    width: 150px; height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,0.4),
      transparent
    );
    animation: shimmer 1.5s infinite;
  }
  @keyframes shimmer {
    to { transform: translateX(442px); }
  }

  /* Swiper slide style */
  .swiper-slide.tab-card {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    text-align: center;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 4px;
  }
</style>

<div class="category-block">
  <div class="category-content-wrapper page-width">
    {% if show_title %}
      <div class="heading center">
        <h1>{{ category_title }}</h1>
      </div>
    {% endif %}

    <div class="category-tab-wrapper">
      <!-- Categories slider -->
      <div class="swiper-container categories-swiper">
        <div class="swiper-wrapper" id="categoriesWrapper"></div>
        <!-- navigation buttons, optional -->
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>

      <div class="tab-body">
        <div class="tab-content-wrapper">
          <!-- Products slider -->
          <div class="swiper-container products-swiper">
            <div class="swiper-wrapper" id="productsWrapper"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
          </div>
        </div>
      </div>

      {% if show_title %}
        <div class="browse-categories" id="browseCategoriesDiv"></div>
      {% endif %}
    </div>
  </div>
</div>

<!-- 2) Include Swiper’s JS (before closing </body>) -->
<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
<script>
  // initialize both Swipers
  const categoriesSwiper = new Swiper('.categories-swiper', {
    slidesPerView: 'auto',
    spaceBetween: 16,
    navigation: {
      nextEl: '.categories-swiper .swiper-button-next',
      prevEl: '.categories-swiper .swiper-button-prev',
    },
  });
  const productsSwiper = new Swiper('.products-swiper', {
    slidesPerView: 'auto',
    spaceBetween: 16,
    navigation: {
      nextEl: '.products-swiper .swiper-button-next',
      prevEl: '.products-swiper .swiper-button-prev',
    },
  });

  // inject skeleton slides
  function showCategorySkeletons(count = 4) {
    const wrap = document.getElementById('categoriesWrapper');
    wrap.innerHTML = '';
    for (let i = 0; i < count; i++) {
      const slide = document.createElement('div');
      slide.className = 'swiper-slide tab-card skeleton';
      wrap.appendChild(slide);
    }
    categoriesSwiper.update();
  }
  function showProductSkeletons(count = 6) {
    const wrap = document.getElementById('productsWrapper');
    wrap.innerHTML = '';
    for (let i = 0; i < count; i++) {
      const slide = document.createElement('div');
      slide.className = 'swiper-slide tab-card skeleton';
      wrap.appendChild(slide);
    }
    productsSwiper.update();
  }

  // fetch categories → render slides
  function loadCategories() {
    showCategorySkeletons();
    fetch(evenFloFAQURL + 'products/getAllCategories?show=true')
      .then(r => r.json())
      .then(data => {
        const wrap = document.getElementById('categoriesWrapper');
        wrap.innerHTML = '';
        data.forEach((cat, idx) => {
          const slide = document.createElement('div');
          slide.className = 'swiper-slide tab-card';
          slide.textContent = cat.category_name;
          slide.addEventListener('click', () => {
            getProductsByCategory(cat.id);
          });
          wrap.appendChild(slide);
        });
        categoriesSwiper.update();
        if (data[0]) {
          getProductsByCategory(data[0].id);
        }
      })
      .catch(err => console.error(err));
  }

  // fetch products → render slides
  function getProductsByCategory(categoryId) {
    showProductSkeletons();
    fetch(evenFloFAQURL + `products/getByCategory/${categoryId}?show=true`)
      .then(r => r.json())
      .then(products => {
        const wrap = document.getElementById('productsWrapper');
        wrap.innerHTML = '';
        products.forEach(p => {
          const slide = document.createElement('div');
          slide.className = 'swiper-slide tab-card';
          // build your card markup here:
          slide.innerHTML = `
            <img src="${p.image_url}" alt="${p.name}" style="max-width:100%;border-bottom:1px solid #ddd"/>
            <div>${p.name}</div>
          `;
          wrap.appendChild(slide);
        });
        productsSwiper.update();
      })
      .catch(err => console.error(err));
  }

  document.addEventListener('DOMContentLoaded', loadCategories);
</script>
