<style>
  /* the shimmering skeleton block */
  .skeleton {
    width: 292px;
    height: 322px;
    background-color: #eee;
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }
  .skeleton::before {
    content: "";
    position: absolute;
    top: 0; left: -150px;
    width: 150px; height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,0.4),
      transparent
    );
    animation: shimmer 1.5s infinite;
  }
  @keyframes shimmer {
    100% { transform: translateX(442px); }
  }

  /* grid container for multiple skeletons */
  .loader.skeleton-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 292px);
    gap: 16px;
    justify-content: center;
  }
</style>

<div class="category-block">
  <div class="category-content-wrapper page-width">
    {% if show_title %}
    <div class="heading center">
      <h1>{{ category_title }}</h1>
    </div>
    {% endif %}

    <div class="category-tab-wrapper" id="categoryTabWrapper">
      <div id="categoriesContainer" class="tab-header" data-categories-to-show="{{ categories_to_show }}">
        <!-- Skeletons for categories -->
        <div id="categoriesSkeleton" class="loader skeleton-grid" style="display: none;">
          <div class="skeleton"></div>
          <div class="skeleton"></div>
          <div class="skeleton"></div>
        </div>
      </div>

      <div class="tab-body">
        <div class="tab-content-wrapper" id="productsByCategory" data-faqs-to-show="{{ products_to_show }}">
          <!-- Skeletons for products -->
          <div id="productsSkeleton" class="loader skeleton-grid" style="display: none;">
            <div class="skeleton"></div>
            <div class="skeleton"></div>
            <div class="skeleton"></div>
            <div class="skeleton"></div>
          </div>
        </div>
      </div>

      {% if show_title %}
      <div class="browse-categories" id="browseCategoriesDiv"></div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  function getPaginatedCategories() {
    const catLoader = document.getElementById('categoriesSkeleton');
    const catContainer = document.getElementById('categoriesContainer');
    catContainer.innerHTML = '';               // clear old
    catLoader.style.display = 'grid';          // show skeleton

    fetch(evenFloFAQURL + 'products/getAllCategories?show=true')
      .then(r => r.json())
      .then(data => {
        catLoader.style.display = 'none';      // hide skeleton
        // build real buttons…
        data.forEach((cat, idx) => {
          const btn = document.createElement('button');
          btn.textContent = cat.category_name;
          if (idx === 0) btn.classList.add('active');
          btn.onclick = () => {
            catContainer.querySelectorAll('button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            getProductsByCategory(cat.id, cat.category_name);
          };
          catContainer.appendChild(btn);
        });
        // load first tab
        if (data[0]) getProductsByCategory(data[0].id, data[0].category_name);
      })
      .catch(console.error);
  }

  function getProductsByCategory(catId, catName) {
    const prodLoader = document.getElementById('productsSkeleton');
    const prodWrapper = document.getElementById('productsByCategory');
    prodWrapper.innerHTML = '';
    prodLoader.style.display = 'grid';

    fetch(evenFloFAQURL + `products/getByCategory/${catId}?show=true`)
      .then(r => r.json())
      .then(products => {
        prodLoader.style.display = 'none';
        // render your real products here...
        products.forEach(p => {
          const card = document.createElement('div');
          card.className = 'product-card';
          card.textContent = p.name;
          prodWrapper.appendChild(card);
        });
      })
      .catch(console.error);
  }

  document.addEventListener('DOMContentLoaded', getPaginatedCategories);
</script>
