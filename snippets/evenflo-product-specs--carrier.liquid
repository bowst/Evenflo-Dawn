{% assign toy_clip = product.metafields.sf_carrier.pacifier_toy_clip %}
{% assign machine_wash = product.metafields.sf_carrier.machine_washable %}

<!-- carrier positions for carrier -->

<h3>Carrier Specifications</h3>
<ul class="specs-list">
	<li>
		<strong>Positions</strong>
		<div>
			{{ product.metafields.sf_carrier.position | split: ',' }}
		</div>
	</li>

	{% assign shipping_restrictions = product.metafields.sf_shipping.shipping_restrictions %}

	{% if shipping_restrictions %}
	<li>
		<strong>Shipping Restrictions</strong>
		<div>
		{{ shipping_restrictions }}
		</div>
	</li>
	{% endif %}

	{% if machine_wash == 1 %}
	<li class="checkbox-item">
		<strong>Machine Washable</strong>
		<span class="screen-reader-text">Yes</span>
		<span class="checkmark">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
	</li>
	{% endif %}
	
	{% if toy_clip == 1 %}
	<li class="checkbox-item">
		<strong>Toy Clip</strong>
		<span class="screen-reader-text">Yes</span>
		<span class="checkmark">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
	</li>
	{% endif %}
</ul>