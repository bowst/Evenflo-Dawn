{% comment %}
  Specifications tab: Product measurements, certifications, warranty, key features
  (aligned with evenflo-product-specifications / evenflo-product-highlights patterns).
  Layout: evenflo-pdp-tab-layout* — left: measurements, certifications, warranty; right: key features when split.
{% endcomment %}
{%- liquid
  assign folded_dimensions = product.metafields.sf_products.folded_dimensions
  assign folded_dims_assembled = product.metafields.custom.folded_dims_assembled
  assign package_width = product.metafields.sf_shipping.package_width
  assign package_height = product.metafields.sf_shipping.package_height
  assign package_depth = product.metafields.sf_shipping.package_depth
  assign assembled_weight = product.metafields.sf_products.assembled_weight
  assign package_weight = product.metafields.custom.package_weight
  assign certifications = product.metafields.custom.certifications
  assign warranty_code = product.metafields.sf_products.warranty
  assign product_warranty_link = product.metafields.custom.product_warranty_link
  assign warranty_type = product.metafields.sf_products.warranty_type
  assign key_features = product.metafields.product.features

  assign product_dims_assembled = product.metafields.custom.product_dims_assembled
  assign stroller_accepts_infant_car_seat = product.metafields.custom.stroller_accepts_infant_car_seat.value
  assign number_of_wheels = product.metafields.custom.number_of_wheels.value
  assign frame_material = product.metafields.custom.frame_material.value
  assign accepts_rider_board = product.metafields.sf_stroller.accepts_rider_board
  assign upf_50_sun_protection = product.metafields.custom.upf_50_sun_protection.value
  assign pramette = product.metafields.custom.pramette.value
  assign travel_system_compatible = product.metafields.custom.travel_system_compatible.value
  assign stroller_age_limitation = product.metafields.custom.stroller_age_limitation.value
  assign stroller_height_limitation = product.metafields.custom.stroller_height_limitation.value
  assign stroller_weight_limitation = product.metafields.custom.stroller_weight_limitation.value
  assign suspension = product.metafields.custom.suspension.value
  assign side_impact_protection = product.metafields.sf_car_seat.side_impact_protection
  assign green_gentle_fabric = product.metafields.custom.green_gentle_fabric.value
  assign harness_rethread_method = product.metafields.sf_products.harness_rethread_method

  assign show_measurements = false
  if assembled_width and assembled_height and assembled_depth
    assign show_measurements = true
  elsif package_width and package_height and package_depth
    assign show_measurements = true
  elsif folded_dimensions != blank or folded_dims_assembled != blank
    assign show_measurements = true
  elsif assembled_weight != blank or package_weight != blank
    assign show_measurements = true
  elsif product_dims_assembled != blank
    assign show_measurements = true
  endif

  assign show_certifications = false
  if certifications != blank
    assign show_certifications = true
  endif

  assign show_warranty = false
  if warranty_type != blank or warranty_code != blank or product_warranty_link != blank
    assign show_warranty = true
  endif

  assign show_left_column = false
  if show_measurements or show_certifications or show_warranty
    assign show_left_column = true
  endif

  assign layout_split = false
  if show_left_column
    assign layout_split = true
  endif
-%}

{%- capture key_features_list_markup -%}
  <div class="info-body">
    <ul class="specs-list info-list evenflo-pdp-tab-key-features-list">

      {%- if stroller_accepts_infant_car_seat == true -%}
        <li>Stroller accepts infant car seat</li>
      {%- endif -%}
      {%- if product.metafields.custom.number_of_wheels != blank -%}
        <li>Number of wheels: {{ number_of_wheels }}</li>
      {%- endif -%}
      {%- if product.metafields.custom.frame_material != blank -%}
        <li>Frame material: {{ frame_material }}</li>
      {%- endif -%}
      {%- if accepts_rider_board == 1 -%}
        <li>Stroller accepts rider board</li>
      {%- endif -%}
      {%- if upf_50_sun_protection == true -%}
        <li>UPF Canopy</li>
      {%- endif -%}
      {%- if pramette == true -%}
        <li>Pramette Mode</li>
      {%- endif -%}
      {%- if travel_system_compatible == true -%}
        <li>Travel System Compatible</li>
      {%- endif -%}
      {%- if product.metafields.custom.stroller_age_limitation != blank -%}
        <li>Stroller age limitation: {{ stroller_age_limitation }}</li>
      {%- endif -%}
      {%- if product.metafields.custom.stroller_height_limitation != blank -%}
        <li>Stroller height limitation: {{ stroller_height_limitation }}</li>
      {%- endif -%}
      {%- if product.metafields.custom.stroller_weight_limitation != blank -%}
        <li>Stroller weight limitation: {{ stroller_weight_limitation }}</li>
      {%- endif -%}
      {%- if product.metafields.custom.suspension != blank -%}
        <li>Suspension Type: {{ suspension }}</li>
      {%- endif -%}
      {%- if side_impact_protection == 1 -%}
        <li>Side Impact Protection</li>
      {%- endif -%}
      {%- if green_gentle_fabric == true -%}
        <li>Green &amp; Gentle Fabric</li>
      {%- endif -%}
      {%- if harness_rethread_method != blank -%}
        <li>Rethread Harness: {{ harness_rethread_method }}</li>
      {%- endif -%}
    </ul>
  </div>
{%- endcapture -%}

<div class="evenflo-pdp-tab-layout specifications">
  <div class="evenflo-pdp-tab-layout__grid{% if layout_split %} evenflo-pdp-tab-layout__grid--split{% endif %}">
    <div class="evenflo-pdp-tab-layout__main">
      {%- if show_measurements -%}
        <div class="info-block">
          <h4 class="h3">Product Measurements</h4>
          <ul class="specs-list no-bullets">
            {%- if product_dims_assembled != blank -%}
              <li>Assembled: {{ product_dims_assembled }}</li>
            {%- endif -%}

            {%- if package_width and package_height and package_depth -%}
              <li>Package: {{ package_width }}" W × {{ package_height }}" H × {{ package_depth }}" D</li>
            {%- endif -%}
            {%- if folded_dimensions != blank -%}
              <li>Folded dimensions: {{ folded_dimensions }}</li>
            {%- elsif folded_dims_assembled != blank -%}
              <li>Folded dimensions: {{ folded_dims_assembled }}</li>
            {%- endif -%}
            {%- if assembled_weight != blank -%}
              <li>Product weight: {{ assembled_weight }} lbs</li>
            {%- endif -%}
            {%- if package_weight != blank -%}
              <li>Package weight: {{ package_weight }} lbs</li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if show_certifications -%}
        <div class="info-block">
          <h4 class="h3">Certifications</h4>
          <div class="info-body rte">{{ certifications }}</div>
        </div>
      {%- endif -%}

      {%- if show_warranty -%}
        <div class="info-block">
          <h4 class="h3">Warranty</h4>
          <div class="info-body rte">
            {%- if warranty_type != blank -%}
              <p>{{ warranty_type }}</p>
            {%- endif -%}
            {%- if warranty_code != blank -%}
              <p>{{ warranty_code }}</p>
            {%- endif -%}
            {%- if product_warranty_link != blank -%}
              <p><a href="{{ product_warranty_link }}">{{ product_warranty_link }}</a></p>
            {%- endif -%}
            {%- if product_warranty_link and warranty_code == '1 Year, 6 Month Battery' -%}
              <p><a href="{{ product_warranty_link }}">Limited 1 Year, 6-Month Battery Warranty</a></p>
            {%- endif -%}
            {%- if warranty_code == 'lifetime-limited' -%}
              <p><a href="https://www.evenflo.com/pages/warranty">Limited Lifetime Warranty</a></p>
            {%- endif -%}
            {%- if warranty_code == '1 Year, Limited' -%}
              <p><a href="https://www.evenflo.com/pages/warranty">Limited 1 Year Warranty</a></p>
            {%- endif -%}
            {%- if product_warranty_link and warranty_code == '90-day-limited' -%}
              <p><a href="{{ product_warranty_link }}">Limited 90-Day Warranty</a></p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if layout_split == false -%}
        <div class="info-block">
          <h4 class="h3">Key Features</h4>
          {{ key_features_list_markup }}
        </div>
      {%- endif -%}
    </div>

    {%- if layout_split -%}
      <div class="evenflo-pdp-tab-layout__aside">
        <div class="info-block">
          <h4 class="h3">Key Features</h4>
          {{ key_features_list_markup }}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
