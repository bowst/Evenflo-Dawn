{% schema %}
{
	"name": "QQ - Image Gallery",
	"tag": "section",
	"class": "qq-image-gallery",
	"settings": [
		{
			"type": "text",
			"id": "section_class",
			"label": "Section Class",
			"info": "Add section class (without .). Use spaces to add multiple classes"
		},
		{
			"type": "richtext",
			"id": "section_title",
			"label": "Section Title",
			"default": "<h2>Section Title</h2>"
		},		
		{
			"type": "richtext",
			"id": "section_textblock",
			"label": "Section Text Block",
			"info": "Optional"
		},		
		{
			"type": "header",
			"content": "Carousel Settings"
		},
		{
			"type": "range",
			"id": "carousel_slides_to_show",
			"min": 2,
			"max": 6,
			"step": 1,
			"label": "Slides to Show",
			"default": 4
		},
		{
			"type": "checkbox",
			"id": "carousel_slide_all",
			"label": "Advance entire row on arrow click instead of 1-by-1",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "carousel_autoplay",
			"label": "Autoplay Carousel Slides",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "carousel_autoplay_mobile",
			"label": "Autoplay Carousel Slides on Mobile",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "carousel_overflow",
			"label": "Show overflow of items",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "carousel_infinite",
			"label": "Infinite Scroll",
			"default": true
		},
		{
			"type": "range",
			"id": "carousel_speed",
			"min": 1,
			"max": 15,
			"step": 1,
			"label": "Carousel Speed",
			"info": "Speed in seconds",
			"default": 4
		},
		{
			"type": "range",
			"id": "carousel_slide_padding",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Space between slides",
			"default": 20
		},
		{
			"type": "range",
			"id": "carousel_slide_padding_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Space between slides - Mobile",
			"default": 20
		},
		{
			"type": "color",
			"id": "carousel_arrows_color_line",
			"label": "Carousel Arrows Line Color"
		},
		{
			"type": "color",
			"id": "carousel_arrows_color_bg",
			"label": "Carousel Arrows Background Color",
			"default": "#ffffff"
		},
		{
			"type": "range",
			"id": "carousel_arrows_edge_distance",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"label": "Carousel Arrows Distance from Edge",
			"default": 20
		},
		{
			"type": "select",
			"id": "carousel_arrows_position",
			"options": [
				{
					"value": "inside",
					"label": "Inside of Wrapper"
				},
				{
					"value": "outside",
					"label": "Outside of Wrapper"
				}
			],
			"default": "inside",
			"label": "Position of Arrows"
		},
		{
			"type": "image_picker",
			"id": "arrow_left",
			"label": "Custom Left Arrow (Optional)",
			"info": "Recommended size 32px X 32px"
		},
		{
			"type": "image_picker",
			"id": "arrow_right",
			"label": "Custom Right Arrow (Optional)",
			"info": "Recommended size 32px X 32px"
		},
		{
			"type": "header",
			"content": "Carousel/Grid Toggle"
		},
		{
			"type": "select",
			"id": "carousel_default",
			"options": [
				{
					"value": "carousel",
					"label": "Carousel"
				},
				{
					"value": "grid",
					"label": "Grid"
				}
			],
			"default": "carousel",
			"label": "Default State"
		},
		{
			"type": "text",
			"id": "carousel_expand",
			"label": "Expand as Grid Title",
			"default": "Expand Images"
		},
		{
			"type": "text",
			"id": "carousel_collapse",
			"label": "Minimize as Carousel Title",
			"default": "Minimize Images"
		},
		{
            "type": "header",
            "content": "Grid Settings"
        },
		{
			"type": "select",
			"id": "grid_columns",
			"options": [
				{
					"value": "2",
					"label": "2"
				},
				{
					"value": "3",
					"label": "3"
				},
				{
					"value": "4",
					"label": "4"
				}
			],
			"default": "3",
			"label": "Grid Columns",
			"info": "Amount of Columns for expanded images"
		},
		{
			"type": "range",
			"id": "grid_horizontal_gap",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"label": "Grid Horizontal Gap",
			"default": 40
		},
		{
			"type": "range",
			"id": "grid_vertical_gap",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"label": "Grid Vertical Gap",
			"default": 40
		},
		{
			"type": "header",
			"content": "Carousel/Grid Toggle - Mobile"
		},
		{
			"type": "select",
			"id": "grid_columns_mobile",
			"options": [
				{
					"value": "1",
					"label": "1"
				},
				{
					"value": "2",
					"label": "2"
				}
			],
			"default": "1",
			"label": "Grid Columns - Mobile"
		},
		{
			"type": "range",
			"id": "grid_horizontal_gap_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Grid Horizontal Gap - Mobile",
			"default": 20
		},
		{
			"type": "range",
			"id": "grid_vertical_gap_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Grid Vertical Gap - Mobile",
			"default": 20
		},
		{
			"type": "header",
			"content": "Section Styling"
		},
		{
			"type": "select",
			"id": "section_width",
			"options": [
				{
					"value": "regular",
					"label": "Regular"
				},
				{
					"value": "fullwidth",
					"label": "Fullwidth"
				}
			],
			"default": "regular",
			"label": "Section Width"
		},
		{
			"type": "range",
			"id": "content_max_width",
			"min": 500,
			"max": 1500,
			"step": 20,
			"unit": "px",
			"label": "Content Max Width",
			"default": 1280
		},
		{
			"type": "checkbox",
			"id": "content_fullwidth",
			"label": "Real Fullwidth",
			"info": "Enable to ignore 'Content Max Width'",
			"default": false
		},
