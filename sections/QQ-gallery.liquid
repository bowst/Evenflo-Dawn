{% capture carouselArrows %}
    {% liquid
        assign arrowLeftImage = section.settings.arrow_left
        assign arrowLeftImageUrl = arrowLeftImage | img_url: '32x32', crop: 'center'
        if arrowLeftImage.alt != blank
            assign arrowLeftImageAlt = 'alt="' | append: arrowLeftImage.alt | append: '"'
        else
            assign arrowLeftImageAlt = ''
        endif
				if arrowLeftImageUrl != blank
						assign customLeft = 'qq-custom-left'
				else
						assign customLeft = ''
				endif
        assign arrowRightImage = section.settings.arrow_right
        assign arrowRightImageUrl = arrowRightImage | img_url: '32x32', crop: 'center'
        if arrowRightImage.alt != blank
            assign arrowRightImageAlt = 'alt="' | append: arrowRightImage.alt | append: '"'
        else
            assign arrowRightImageAlt = ''
        endif
				if arrowRightImageUrl != blank
						assign customRight = 'qq-custom-right'
				else
						assign customRight = ''
				endif
    %}
    <div class="qq-carousel-arrows qq-hidden">
        <span class="qq-carousel-arrow qq-carousel-prev {{customLeft}}">
            {% if arrowLeftSvg != blank %}
                <img src="{{arrowLeftSvg}}" loading="lazy">
            {% elsif arrowLeftImage != blank %}
                <img src="{{arrowLeftImageUrl}}" {{arrowLeftImageAlt}} loading="lazy">
            {% else %}
               <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g><g><circle cx="12" cy="12" r="12" style="fill:#fff;"/><polyline points="14 6.17 8.6 11.57 14 16.97" style="fill:none; stroke:#000; stroke-linecap:round; stroke-miterlimit:8; stroke-width:2px;"/></g></g></svg>
            {% endif %}
        </span>
        <span class="qq-carousel-arrow qq-carousel-next {{customRight}}">
            {% if arrowRightSvg != blank %}
                <img src="{{arrowRightSvg}}" loading="lazy">
            {% elsif arrowRightImage != blank %}
                <img src="{{arrowRightImageUrl}}" {{arrowRightImageAlt}} loading="lazy">
            {% else %}
                <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g id="Layer_1-2"><g><circle cx="12" cy="12" r="12" style="fill:#fff;"/><polyline points="10 17.83 15.4 12.43 10 7.03" style="fill:none; stroke:#000; stroke-linecap:round; stroke-miterlimit:8; stroke-width:2px;"/></g></g></svg>
            {% endif %}
        </span>
    </div>
{% endcapture %}
{% capture sectionHeader %}
	{% if sectionTitle != blank or sectionTextblock != blank %}
		<div class="qq-image-gallery-header">
			{% if sectionTitle != blank %}
				<div class="qq-title">{{sectionTitle}}</div>
			{% endif %}
			{% if sectionTextblock != blank %}
				<div class="qq-textblock">{{sectionTextblock}}</div>
			{% endif %}
		</div>
	{% endif %}
{% endcapture %}
{% if sectionHeaderPosition == 'outside' %}
  {{sectionHeader}}
{% endif %}
<div class="qq-section-wrap-{{sectionWidth}} {{sectionClass}}" id="{{divID}}">
	{% if sectionHeaderPosition == 'inside' %}
      {{sectionHeader}}
    {% endif %}
	{% if blocksSize != 0 %}
		<div class="qq-images-toggle">
			<a href="#" class="qq-hidden" data-expand="{{carouselExpand}}" data-collapse="{{carouselCollapse}}">{{carouselExpand}}</a>
		</div>
	{% endif %}
	<div class="qq-images {% if carouselDefaultState == "grid" %}qq-expanded{% endif %}">
		<div class="qq-images-wrapper"
			data-enableSlider="{{makeCarousel}}"
			data-numOfSlides="{{blocksSize}}"
			data-slidesToShow="{{slidesToShow}}"
			data-carouselSlideAll="{{carouselSlideAll}}"
			data-carouselAutoplay="{{carouselAutoplay}}"
			data-carouselAutoplayMobile="{{carouselAutoplayMobile}}"
			data-carouselSpeed="{{carouselSpeed}}"
			data-carouselCentermode="{{carouselOverflow}}"
			data-carouselInfinite="{{carouselInfinite}}"			
			data-customImageHeight="{{imageCustomHeight}}"
			data-showArrows="{{showArrows}}"			
			data-default="{{carouselDefaultState}}"
			data-popupEnabled="{{popupEnabled}}"
			data-popupTextEnabled="{{popupImageTextDisplay}}">
			{%- for block in section.blocks -%}
				{% if block.type == 'image' %}
					{% liquid
						assign blockImage = block.settings.image						
						assign imageLink = '#'
						assign imageLinkAttributes = ''
						if popupEnabled == false 
							assign imageLink = block.settings.image_link
							if imageLink != blank 
								assign imageLinkTab = block.settings.image_link_tab						
								if imageLinkTab == true
									assign imageLinkAttributes = ' target="_blank"'
								endif
							else 
								assign imageLink = '#'
							endif
						endif 
						assign imageTitle = block.settings.title				
						assign imageSubtitle = block.settings.image_subtitle		
					%}
					<div class="qq-single-image">											
						<a class="qq-image-thumb {% if forloop.index == 1%}qq-active{%endif%}" 
						{{imageLinkAttributes}}
						href="{{imageLink}}"
						data-slide="{{forloop.index}}"
						data-full-image="{{fullImageUrl}}">
							{% if blockImage != blank %}
								{% assign loopImage = blockImage %}								
								{% assign mediaSize = imageDimensions %}								
								{% liquid 
                    if loopImage.alt != blank
                      assign loopImageAlt = 'alt="' | append: loopImage.alt | append: '"'
                    else
                      assign loopImageAlt = ''
                    endif
                    assign proportion = loopImage.aspect_ratio
                    assign imageW = loopImage.width
                    assign imageH = loopImage.height   
                    for imageSize in imageSizes
                      assign maxWidthAllowed = imageSize | remove: 'x'
                      assign maxHeightAllowed = imageSize | remove: 'x'
                      if proportion > 1
                        # landscape
                        assign mostW = maxWidthAllowed
                        assign mostH = mostW | times: proportion
                      elsif proportion < 1
                        # portrait
                        assign mostH = maxHeightAllowed
                        assign mostW = mostH | times: proportion
                      else
                        # square
                        assign mostW = maxWidthAllowed
                        assign mostH = mostW
                      endif
                      assign iw = imageW | at_most: mostW | round
                      assign ih	= imageH | at_most: mostH | round
                      if mediaSize == 'portrait'
                        if halfSquarePortrait == true  
                          assign ih = iw | times: 2 | round
                            if imageH < ih
                                assign ih = imageH
                                assign iw = ih | divided_by: 2 | round
                            endif
                            if imageW < iw
                                assign iw = imageW
                                assign ih = iw | times: 2 | round
                            endif
                        else 
                          assign ih = iw | divided_by: 0.6666667 | round
                          if imageH < ih
                            assign ih = imageH
                            assign iw = ih | divided_by: 1.5 | round
                          endif
                          if imageW < iw
                            assign iw = imageW
                            assign ih = iw | divided_by: 0.666667 | round
                          endif
                        endif
                      elsif mediaSize == 'vertical'
                        assign ih = iw | times: 16 | divided_by: 9 | round
                        if imageH < ih
                          assign ih = imageH
                          assign iw = ih | times: 9 | divided_by: 16 | round
                        endif
                        if imageW < iw
                          assign iw = imageW
                          assign ih = iw | times: 16 | divided_by: 9 | round
                        endif     
                      elsif mediaSize == 'horizontal'
                        assign ih = iw | times: 9 | divided_by: 16 | round
                        if imageH < ih
                          assign ih = imageH
                          assign iw = ih | times: 16 | divided_by: 9 | round
                        endif
                        if imageW < iw
                          assign iw = imageW
                          assign ih = iw | times: 9 | divided_by: 16 | round
                        endif                                          
                      elsif mediaSize == 'square'
                        assign ih = iw
                        if iw > imageW
                          assign iw = imageW
                          assign ih = iw
                        endif
                        if ih > imageH
                          assign ih = imageH
                          assign iw = ih
                        endif
                      elsif mediaSize == 'landscape'
                        if halfSquareLandscape == true 
                          assign ih = iw | times: 0.5 | round
                          if imageH < ih
                            assign ih = imageH
                            assign iw = ih | times: 2 | round
                          endif
                          if imageW < iw
                            assign iw = imageW
                            assign ih = iw | times: 0.5 | round
                          endif                        
                        else 
                         assign ih = iw | times: 4 | divided_by: 6 | round
                          if imageH < ih
                            assign ih = imageH
                            assign iw = ih | times: 6 | divided_by: 4 | round
                          endif
                          if imageW < iw
                            assign iw = imageW
                            assign ih = iw | times: 4 | divided_by: 6 | round
                          endif
                        endif
                      elsif mediaSize == 'original'
                        assign ih = iw | divided_by: proportion | round
                      endif
                      assign size = iw | append: 'x' | append: ih
                      assign imageUrl = loopImage | img_url: size, crop: 'center'
                      if forloop.first
                        assign imageUrls = imageUrl
                      else
                        assign imageUrls = imageUrls | append: ',' | append: imageUrl
                      endif                      
                    endfor
                    assign imageUrls = imageUrls | split: ','                                                              
%}
								{% assign blockImageAlt = loopImageAlt %}
								{% assign blockImageUrls = imageUrls %}	
								{% capture blockImagesLoopArray %}
									{% for imageSize in imageSizes %}
									{% if imageSize contains 'x' %}
									{% assign defaultImageUrl = blockImageUrls[forloop.index0] %}
									{% assign imageSize = imageSize | remove: 'x' %}
									{% endif %}
									{{blockImageUrls[forloop.index0]}} {{imageSize}}w{% unless forloop.last %},{% endunless %}
									{% endfor %}
								{% endcapture %}
								<picture>
									<img srcset="{{blockImagesLoopArray}}" {{blockImageAlt}} src=”{{defaultImageUrl}}”/ loading="lazy">
								</picture>
							{% else %}
