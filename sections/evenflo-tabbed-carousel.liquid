{{ 'section-evenflo-tabbed-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign slide_count = section.blocks.size
  assign interval_seconds = section.settings.autoplay_interval
  assign total_duration = slide_count | times: interval_seconds
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if slide_count > 1 -%}
    #tabbed-carousel-{{ section.id }} {
      --interval: {{ interval_seconds }}s;
      --total-duration: {{ total_duration }}s;
    }

    @keyframes slide-show-{{ section.id }} {
      {%- for block in section.blocks -%}
        {%- assign delay_start = forloop.index0 | times: interval_seconds -%}
        {%- assign delay_end = forloop.index | times: interval_seconds -%}
        {%- assign start_percent = delay_start | times: 100.0 | divided_by: total_duration -%}
        {%- assign end_percent = delay_end | times: 100.0 | divided_by: total_duration -%}
        {%- if forloop.last -%}
          {%- assign end_percent = 100 -%}
        {%- endif -%}
        {{ start_percent }}% {
          opacity: 1;
          visibility: visible;
        }
        {{ end_percent | minus: 0.01 }}% {
          opacity: 1;
          visibility: visible;
        }
        {{ end_percent }}% {
          opacity: 0;
          visibility: hidden;
        }
      {%- endfor -%}
    }

    @keyframes tab-active-{{ section.id }} {
      {%- for block in section.blocks -%}
        {%- assign delay_start = forloop.index0 | times: interval_seconds -%}
        {%- assign delay_end = forloop.index | times: interval_seconds -%}
        {%- assign start_percent = delay_start | times: 100.0 | divided_by: total_duration -%}
        {%- assign end_percent = delay_end | times: 100.0 | divided_by: total_duration -%}
        {%- if forloop.last -%}
          {%- assign end_percent = 100 -%}
        {%- endif -%}
        {{ start_percent }}% {
          border-color: #2996c5;
          background: rgba(41, 150, 197, 0.05);
        }
        {{ end_percent | minus: 0.01 }}% {
          border-color: #2996c5;
          background: rgba(41, 150, 197, 0.05);
        }
        {{ end_percent }}% {
          border-color: rgba(18, 18, 18, 0.1);
          background: transparent;
        }
      {%- endfor -%}
    }

    @keyframes tab-indicator-{{ section.id }} {
      {%- for block in section.blocks -%}
        {%- assign delay_start = forloop.index0 | times: interval_seconds -%}
        {%- assign delay_end = forloop.index | times: interval_seconds -%}
        {%- assign start_percent = delay_start | times: 100.0 | divided_by: total_duration -%}
        {%- assign end_percent = delay_end | times: 100.0 | divided_by: total_duration -%}
        {%- if forloop.last -%}
          {%- assign end_percent = 100 -%}
        {%- endif -%}
        {{ start_percent }}% {
          opacity: 1;
        }
        {{ end_percent | minus: 0.01 }}% {
          opacity: 1;
        }
        {{ end_percent }}% {
          opacity: 0;
        }
      {%- endfor -%}
    }

    #tabbed-carousel-{{ section.id }}.tabbed-carousel--autoplay .tabbed-carousel__slide {
      animation: slide-show-{{ section.id }} var(--total-duration) infinite;
    }

    #tabbed-carousel-{{ section.id }}.tabbed-carousel--autoplay .tabbed-carousel__tab {
      animation: tab-active-{{ section.id }} var(--total-duration) infinite;
    }

    #tabbed-carousel-{{ section.id }}.tabbed-carousel--autoplay .tabbed-carousel__tab::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: #2996c5;
      border-radius: 4px 0 0 4px;
      opacity: 0;
      animation: tab-indicator-{{ section.id }} var(--total-duration) infinite;
    }

    {%- for block in section.blocks -%}
      {%- assign delay = forloop.index0 | times: interval_seconds -%}
      #tabbed-carousel-{{ section.id }}.tabbed-carousel--autoplay .tabbed-carousel__slide:nth-child({{ forloop.index }}) {
        animation-delay: {{ delay }}s;
      }
      #tabbed-carousel-{{ section.id }}.tabbed-carousel--autoplay .tabbed-carousel__tab:nth-child({{ forloop.index }}) {
        animation-delay: {{ delay }}s;
      }
      #tabbed-carousel-{{ section.id }}.tabbed-carousel--autoplay .tabbed-carousel__tab:nth-child({{ forloop.index }})::before {
        animation-delay: {{ delay }}s;
      }
    {%- endfor -%}
  {%- endif -%}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="tabbed-carousel section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="tabbed-carousel__header title-wrapper title-wrapper--no-top-margin">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}" style="text-align: {{ section.settings.heading_alignment }};">
            {{ section.settings.heading }}
          </h2>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div
          id="tabbed-carousel-{{ section.id }}"
          class="tabbed-carousel__container{% if section.blocks.size > 1 %} tabbed-carousel--autoplay{% endif %}"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ section.settings.heading | default: 'Tabbed carousel' }}"
        >
          <div class="tabbed-carousel__grid grid grid--1-col grid--2-col-tablet">
            <div class="tabbed-carousel__image-wrapper grid__item">
              <div class="tabbed-carousel__slider">
                {%- for block in section.blocks -%}
                  <div
                    class="tabbed-carousel__slide"
                    data-index="{{ forloop.index0 }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.image != blank -%}
                      <div class="tabbed-carousel__image media media--{{ section.settings.image_ratio }}">
                        {{
                          block.settings.image
                          | image_url: width: 2000
                          | image_tag:
                            loading: 'lazy',
                            widths: '375, 550, 750, 1100, 1500, 1780, 2000',
                            sizes: '(min-width: 750px) calc(50vw - 10rem), calc(100vw - 3rem)',
                            alt: block.settings.image.alt
                        }}
                      </div>
                    {%- else -%}
                      <div class="tabbed-carousel__image media media--{{ section.settings.image_ratio }}">
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>

            <div class="tabbed-carousel__tabs-wrapper grid__item">
              <div class="tabbed-carousel__tabs">
                {%- for block in section.blocks -%}
                  <div
                    class="tabbed-carousel__tab{% if forloop.first %} tabbed-carousel__tab--active{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.heading != blank -%}
                      <h3 class="tabbed-carousel__tab-heading">{{ block.settings.heading }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="tabbed-carousel__tab-text rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tabbed Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "header",
      "content": "Carousel settings"
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Interval (seconds)",
      "default": 5,
      "info": "Time each slide is displayed"
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Tab heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Tab content text goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Carousel",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}

