{{ 'section-evenflo-collection-detail.css' | asset_url | stylesheet_tag }}

<style>
  /* …your existing styles… */

  /* ─── POPULAR-FAQ SKELETON CARD ─── */
  .popular-card.skeleton {
    width: 503px;
    height: 425px;
    background: #f1f2f3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .popular-card.skeleton .skeleton-title {
    width: 60%;
    height: 1.5em;
    background: #e0e0e0;
    margin-bottom: 1rem;
  }
  .popular-card.skeleton .skeleton-content {
    flex: 1;
    background: #e0e0e0;
    border-radius: 4px;
  }
</style>

{% assign products_to_show = section.settings.productRelatedRange %}

<div class="help-articles-block">
  <!-- … -->
</div>

<div class="product-page-wrapper">
  <div class="popular-question-block" id="productRelatedBlock" data-faqs-to-show="{{ products_to_show }}">
    <div class="popular-content-wrapper page-width">
      <div class="heading center">
        <h2 id="popularQuestionHeading">{{ section.settings.productRelatedTitle }}</h2>
      </div>
      <div class="popular-card-wrapper" id="popularCards">
        <!-- skeletons will go here immediately on load -->
      </div>
    </div>
  </div>
</div>

{% render 'faq-related-part-block' %}
{% render 'faq-load-more-block', show_topic_dropdown: true %}

<script>
  function fetchPopularProductsRelatedData(productID) {
    const container      = document.getElementById("popularCards");
    const popularSection = document.getElementById("productRelatedBlock");
    const blocksToShow   = +popularSection.dataset.faqsToShow;

    // inject skeletons (in case someone re-calls)
    let skeletonHTML = '';
    for (let i = 0; i < blocksToShow; i++) {
      skeletonHTML += `
        <div class="popular-card skeleton">
          <div class="skeleton-title"></div>
          <div class="skeleton-content"></div>
        </div>`;
    }
    container.innerHTML = skeletonHTML;

    fetch(`${evenFloFAQURL}products/${productID}`)
      .then(res => res.json())
      .then(data => {
        // hide entire section if no FAQs
        const faqs = Array.isArray(data.related_popular_faqs) ? data.related_popular_faqs : [];
        if (faqs.length === 0) {
          document.getElementById('productRelatedBlock').style.display = 'none';
          return;
        }

        // clear skeletons and render real cards
        container.innerHTML = '';
        const faqSchema = { "@context":"https://schema.org", "@type":"FAQPage", "mainEntity":[] };

        faqs.slice(0, blocksToShow).forEach(item => {
          const card = createPopularCardDivElement("popular-card");
          const content = getFAQContent(item.products || []);
          const tags    = getTagsHtml(getTagsArray(item.tags || []));
          card.innerHTML = setFAQBlockInnerHtml(
            item.topic?.name || "",
            item.question,
            content,
            item.answer,
            item.id,
            tags
          );
          container.appendChild(card);

          faqSchema.mainEntity.push({
            "@type":"Question",
            "name": item.question,
            "acceptedAnswer": { "@type":"Answer","text": item.answer }
          });
        });

        // inject JSON-LD
        const scriptTag = document.createElement('script');
        scriptTag.type  = 'application/ld+json';
        scriptTag.innerHTML = JSON.stringify(faqSchema);
        document.head.appendChild(scriptTag);
      })
      .catch(err => {
        console.error("Error fetching popular FAQs:", err);
        redirectIfNoData([]);
      });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const sectionBlock = document.getElementById('productRelatedBlock');
    if (!sectionBlock) return;

    const pid = new URLSearchParams(window.location.search).get('pid');
    if (!pid) {
      redirectIfNoData([]);
      return;
    }

    // **Initial skeletons** injected before the fetch
    const container    = document.getElementById('popularCards');
    const blocksToShow = +sectionBlock.dataset.faqsToShow;
    let initialHTML = '';
    for (let i = 0; i < blocksToShow; i++) {
      initialHTML += `
        <div class="popular-card skeleton">
          <div class="skeleton-title"></div>
          <div class="skeleton-content"></div>
        </div>`;
    }
    container.innerHTML = initialHTML;

    // then fetch real data
    fetchPopularProductsRelatedData(pid);

    // existing hook for related filters
    if (typeof getFilterValuesAndCallFunc === 'function') {
      getFilterValuesAndCallFunc();
    }
  });
</script>
