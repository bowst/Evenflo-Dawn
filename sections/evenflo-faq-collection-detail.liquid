{{ 'section-evenflo-collection-detail.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style>
  .swiper {
    width: 100%;
    height: 100%;
  }
  .swiper-slide {
    text-align: center;
    font-size: 18px;
    background: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .swiper-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ─── SKELETON CARD ─── */
  .popular-card.skeleton {
    width: 503px;
    height: 425px;
    background: #f1f2f3;
    margin: 0 15px; /* keep some gutter between slides */
    border-radius: 4px;
  }
</style>

<div class="product-page-wrapper">
  <div class="product-slider-block">
    <div class="page-width">
      <div class="product-slider-main-wrapper">
        <div class="product-slider-heading center" id="collectionDetail">
          {% comment %} will be filled dynamically {% endcomment %}
        </div>
        <div class="swiper mySwiper product-slider-wrapper">
          <div
            class="swiper-wrapper"
            id="productsInCollection"
            data-faqs-to-show="6">
            <!-- skeleton cards injected here on init -->
          </div>
          <div class="swiper-pagination"></div>
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        </div>
      </div>
    </div>
  </div>
</div>

{% render 'faq-load-more-block', show_topic_dropdown:true, show_product_dropdown:true %}

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  // 1) On initial render, dump skeletons into the slider
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('productsInCollection');
    if (container) {
      const count = +container.dataset.faqsToShow || 6;
      let html = '';
      for (let i = 0; i < count; i++) {
        html += '<div class="swiper-slide popular-card skeleton"></div>';
      }
      container.innerHTML = html;
    }

    const params = new URLSearchParams(window.location.search);
    if (params.has('cid')) {
      fetchCollectionDetail(params.get('cid'));
    } else {
      redirectIfNoData([]);
    }
  });

  function fetchCollectionDetail(collectionID) {
    const heading = document.getElementById('collectionDetail');
    if (!heading) return;

    heading.innerHTML = '';
    const loader = appendLoader(heading);

    fetch(`${evenFloFAQURL}collection/${collectionID}/`)
      .then(res => res.json())
      .then(col => {
        if (col?.detail && containsString(col.detail, errorString())) {
          redirectIfNoData([]); return;
        }
        heading.innerHTML = `
          <h1 id="collectionHeading">${col.name}</h1>
          <p id="collectionDescription">${col.description}</p>`;
        getBreadCrumbLinks(col.name, 'collection');

        // now replace skeletons with real slides
        fetchProductsByCollection(collectionID);

        // also kick off the FAQ bits
        fetchFAQsByFilters({ collectionID });
        fetchTopicsByType(collectionID);
        fetchDropDownProductsByType(collectionID);
      })
      .catch(err => {
        console.error('Error fetching collection:', err);
        redirectIfNoData([]);
      })
      .finally(() => {
        if (loader) hideLoader(loader);
      });
  }

  function fetchProductsByCollection(collectionID) {
    const container = document.getElementById('productsInCollection');
    if (!container) return;

    // clear skeletons
    container.innerHTML = '';

    fetch(`${evenFloFAQURL}products/filterByCollection/${collectionID}`)
      .then(res => res.json())
      .then(data => {
        const count = +container.dataset.faqsToShow || 6;
        data.slice(0, count).forEach(product => {
          const slide = document.createElement('div');
          slide.classList.add('swiper-slide', 'product-card');
          slide.innerHTML = `
            <a href="/pages/evenflo-faq-product?pid=${product.id}">
              <div class="product-img">
                <img src="${product.image}" alt="${product.name}" />
              </div>
              <div class="product-title">
                <h4>${product.name}</h4>
              </div>
            </a>`;
          container.appendChild(slide);
        });

        // init or update the Swiper
        customSlider();
      })
      .catch(err => console.error('Error fetching products:', err));
  }

  function customSlider() {
    // destroy previous if exists
    if (window.__collectionSwiper) window.__collectionSwiper.destroy();
    window.__collectionSwiper = new Swiper(".mySwiper", {
      loop:      true,
      slidesPerView: 4,
      spaceBetween:  30,
      pagination: { el: ".swiper-pagination", clickable: true },
      navigation:{ nextEl: ".swiper-button-next", prevEl: ".swiper-button-prev" },
      breakpoints: {
        320: { slidesPerView: 1, spaceBetween: 10 },
        640: { slidesPerView: 2 },
        960: { slidesPerView: 4 }
      }
    });
  }
</script>
