{% comment %}
  <section class="full-width-image">
    <div class="content-container--full-width">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag: loading: 'lazy', sizes: sizes, widths: widths, class: 'img-full'
        }}
      {% endif %}
      <div class="text-overlay {{ section.settings.position }}">
        {% if section.settings.heading %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text %}
          <p>{{ section.settings.text }}</p>
        {% endif %}
      </div>
    </div>
  </section>
{% endcomment %}
<section class="custom-image-text-section">
  <div class="image-container">
    {% if section.settings.image %}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag: loading: 'lazy', sizes: sizes, widths: widths, class: 'img-full'
      }}
    {% endif %}
    <div class="text-overlay {{ section.settings.position }}">
      {% if section.settings.heading %}
        <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% endif %}
      {% if section.settings.text %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evenflo Full Width Image",
  "class": "image",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Text Position",
      "options": [
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-right", "label": "Bottom Right" },
        { "value": "center", "label": "Center" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Evenflo Full Width Image"
    }
  ]
}
{% endschema %}

{% stylesheet %}
   /* General Styles */
  .responsive-section {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }

  .responsive-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .text-overlay {
    position: absolute;
    color: #fff; /* Text color is white */
  }

  .text-overlay.bottom-right {
    bottom: 7%;
    right: 4.8%;
    text-align: right;
  }

  .rich-text.heading {
    font-size: 80px; /* Desktop size */
    line-height: 1.2;
    font-weight: bold;
    word-wrap: break-word; /* Prevent overflow */
  }

  .rich-text.subheading {
    font-size: 40px; /* Desktop size for subheading */
    line-height: 1.2;
    word-wrap: break-word; /* Prevent overflow */
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .rich-text.heading {
      font-size: 60px; /* Adjust for tablets */
    }

    .rich-text.subheading {
      font-size: 30px;
    }

    .text-overlay.bottom-right {
      bottom: 5%;
      right: 3%;
    }
  }

  @media (max-width: 768px) {
    .rich-text.heading {
      font-size: 50px; /* Adjust for smaller tablets */
    }

    .rich-text.subheading {
      font-size: 25px;
    }
  }

  @media (max-width: 480px) {
    .rich-text.heading {
      font-size: 40px; /* Adjust for mobile */
    }

    .rich-text.subheading {
      font-size: 20px;
    }

    .text-overlay.bottom-right {
      bottom: 3%;
      right: 2%;
    }
  }
{% endstylesheet %}

