{% comment %} <section class="full-width-image">
  <div class="content-container--full-width">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag: loading: 'lazy', sizes: sizes, widths: widths, class: 'img-full'
      }}
    {% endif %}
    <div class="text-overlay {{ section.settings.position }}">
      {% if section.settings.heading %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>
  </div>
</section> {% endcomment %}
<section class="custom-image-text-section">
  <div class="image-container">
    {% if section.settings.image %}
       {{
        section.settings.image
        | image_url: width: 1800
        | image_tag: loading: 'lazy', sizes: sizes, widths: widths, class: 'img-full'
      }}
    {% endif %}
    <div class="text-overlay {{ section.settings.position }}">
      {% if section.settings.heading %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evenflo Full Width Image",
  "class": "image",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Text Position",
      "options": [
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-right", "label": "Bottom Right" },
        { "value": "center", "label": "Center" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Evenflo Full Width Image"
    }
  ]
}
{% endschema %}

{% stylesheet %}
    .custom-image-text-section {
    position: relative;
    text-align: center;
  }

  .image-container {
    position: relative;
    display: inline-block;
  }

  .image-container img {
    display: block;
    width: 100%;
    height: auto;
  }

  .text-overlay {
    position: absolute;
    color: #fff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    padding: 1rem;
    text-align: center;
  }

  .text-overlay h2 {
    margin: 0 0 0.5rem;
  }

  .text-overlay p {
    margin: 0;
  }

  .text-overlay.top-left {
    top: 10%;
    left: 10%;
    transform: translate(-10%, -10%);
  }

  .text-overlay.top-right {
    top: 10%;
    right: 10%;
    transform: translate(10%, -10%);
  }

  .text-overlay.bottom-left {
    bottom: 10%;
    left: 10%;
    transform: translate(-10%, 10%);
  }

  .text-overlay.bottom-right {
    bottom: 10%;
    right: 10%;
    transform: translate(10%, 10%);
  }

  .text-overlay.center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
{% endstylesheet %}

