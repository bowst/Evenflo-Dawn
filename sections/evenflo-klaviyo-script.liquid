{% schema %}
{
    "name": "Klaviyo Script Block",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Block Title",
            "default": "Klaviyo Script"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "This section is for embedding custom Klaviyo JavaScript for product tracking and analytics."
        },
        {
            "type": "textarea",
            "id": "custom_js",
            "label": "Custom JavaScript",
            "default": "// Add your Klaviyo JavaScript code here\nconsole.log('Klaviyo script loaded successfully.');"
        }
    ]
}
{% endschema %}