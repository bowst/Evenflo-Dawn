{% comment %} Evenflo Confidence CTA - 2026, call-to-action block with heading and buttons {% endcomment %}
{{ 'evenflo-confidence-cta.css' | asset_url | stylesheet_tag }}

<div class="evenflo-confidence-cta" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}">
  <div class="container page-width">
    <div class="evenflo-confidence-cta__inner">
      {% if section.settings.heading != blank %}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.blocks.size > 0 %}
        <div class="evenflo-confidence-cta__buttons">
          {% for block in section.blocks %}
            {% if block.settings.button_text != blank and block.settings.button_url != blank %}
              <a href="{{ block.settings.button_url }}" class="button button--outline" {{ block.shopify_attributes }}>
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Confidence CTA",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Styles"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fcfcfd"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Confidence CTA",
      "blocks": [
        { "type": "button", "settings": { "button_text": "Learn More" } }
      ]
    }
  ]
}
{% endschema %}