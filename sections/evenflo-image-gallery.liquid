{%- if section.blocks -%}
  <style>
        .image-gallery-wrapper {
          columns: 300px;
        }

        .image-gallery-wrapper .image-gallery-item img {
          width: 100%;
          margin-bottom: 1rem;
        }


        .image-gallery-item img:first-child {
        height: 250px;
    }

    .image-gallery-item img:last-child {
        height: 350px;
    }

    .image-gallery-item img {
        object-fit: cover;
        margin: 0!important;
        !importan;
        !importa;
        !import;
        !impor;
        !impo;
        !imp;
        !im;
        !i;
        !;
    }

    .image-gallery-item {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .image-gallery-item:nth-child(odd) {
        flex-direction: column-reverse;
    }
  </style>

  <section class="image-gallery">
    <div class="page-width">
      {%- if section.settings.custom_text_title -%}
        <h2 class="h1">{{ section.settings.custom_text_title }}</h2>
      {%- endif -%}

      <div class="image-gallery-wrapper">
        {% for blocks in section.blocks %}
          <div class="image-gallery-item">
            <img
              src="{{ blocks.settings.gallery_image1 | img_url: 'large' }}"
              alt="{{ section.settings.custom_text_title }} gallery image"
              width=""
              height=""
            >
            <img
              src="{{ blocks.settings.gallery_image2 | img_url: 'large' }}"
              alt="{{ section.settings.custom_text_title }} gallery image"
              width=""
              height=""
            >
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "EvenfloImage Gallery",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "id": "custom_text_title",
      "type": "text",
      "label": "Text box heading",
      "default": "Gallery Title"
    }
  ],
  "blocks": [
    {
      "name": "Gallery Image",
      "type": "gallery_image",
      "settings": [
        {
          "type": "image_picker",
          "id": "gallery_image1",
          "label": "gallery image 1"
        },
        {
          "type": "image_picker",
          "id": "gallery_image2",
          "label": "gallery image 2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Gallery",
      "category": "Image Gallery"
    }
  ]
}
{% endschema %}
