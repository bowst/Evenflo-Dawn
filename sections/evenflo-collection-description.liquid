  .collection-page-text-content {
    text-align: left;
    padding: 20px 0; /* Removed side padding since it's handled by page-width */
    margin-bottom: 20px;
    margin-top: 30px;
  }

  .collection-page-text-content h1 {
    font-size: 2em;
    margin-bottom: 10px;
    font-weight: 300;
  }

  .collection-content {
    font-size: 1em;
    color: #333;

  }

  @media screen and (min-width: 750px) {
    .page-width {
      padding: 0 5rem;
    }
