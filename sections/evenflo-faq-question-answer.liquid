{{ 'section-evenflo-answer.css' | asset_url | stylesheet_tag }}
<div class="question-block">
  <div class="page-width">
    <div class="question-banner-wrapper">
      <!-- Content inserted dynamically -->
      <div class="question-col question-col-1"></div>
      <div class="question-col"></div>
    </div>
  </div>
</div>

<style>
  .question-banner-wrapper.question-banner-loading {
    height: 306px;
  }

  .question-banner-wrapper.question-banner-loading .question-col.skeleton {
    background-color: #f1f2f3;
    border-radius: 6px;
    padding: 10px;
  }

  .skeleton-text,
  .skeleton-product,
  .skeleton-tag,
  .skeleton-icon,
  .skeleton-show-more {
    position: relative;
    background-color: #ddd;
    border-radius: 4px;
    margin-bottom: 8px;
    overflow: hidden;

    background-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.4) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite linear;
  }

  .skeleton-title {
    width: 60%;
    height: 24px;
    margin-bottom: 10px;
  }

  .skeleton-subtitle {
    width: 40%;
    height: 20px;
    margin-bottom: 8px;
  }

  .skeleton-paragraph {
    width: 100%;
    height: 12px;
    margin: 6px 0;
  }

  .skeleton-product {
    width: 80px;
    height: 80px;
    display: inline-block;
    margin-right: 10px;
    vertical-align: top;
  }

  .skeleton-tag {
    display: inline-block;
    width: 50px;
    height: 20px;
    margin-right: 8px;
  }

  .skeleton-icon {
    width: 30px;
    height: 30px;
    float: right;
  }

  .skeleton-show-more {
    width: 120px;
    height: 24px;
    margin-top: 10px;
    border-radius: 12px;
  }

  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }
</style>

<script>
  function productList() {
    let productListWrapper = document.querySelectorAll(".question-banner-wrapper .product-list .product-content");
    let bullet = productListWrapper.length;
    console.log(bullet, productListWrapper);

    if (bullet > 3) {
      document.querySelector(".question-banner-wrapper .product-list").classList.add("product-list-custom");
      document.querySelector(".question-banner-wrapper .product-list + .question-banner-links").classList.add("question-banner-links-show");
      document.querySelector(".question-banner-wrapper .product-list + .question-banner-links").addEventListener("click", () => {
        document.querySelector(".question-banner-wrapper .product-list").classList.toggle("product-list-custom");
      });
    }
  }

  function fetchQuestionsAnswerData(id) {
    const container = document.querySelector('.question-banner-wrapper');
    const questionAnswerBlock = document.getElementById('questionAnswerBlock');
    let blocksToShow = questionAnswerBlock ? questionAnswerBlock.dataset.faqsToShow : 1;

    if (!container) return;

    // Show skeleton loading before fetching data
    container.classList.add('question-banner-loading');
    container.innerHTML = `
      <div class="question-col question-col-1 skeleton">
        <div class="question-content">
          <div class="heading">
            <div class="skeleton-text skeleton-title"></div>
            <div class="skeleton-icon"></div>
          </div>
          <div class="description">
            <div class="skeleton-text skeleton-paragraph"></div>
            <div class="skeleton-text skeleton-paragraph"></div>
            <div class="skeleton-text skeleton-paragraph"></div>
          </div>
          <div class="question-banner-links">
            <div class="skeleton-tag"></div>
            <div class="skeleton-tag"></div>
            <div class="skeleton-tag"></div>
          </div>
        </div>
      </div>

      <div class="question-col skeleton">
        <div class="question-content">
          <div class="heading">
            <div class="skeleton-text skeleton-subtitle"></div>
          </div>
          <div class="product-list">
            <div class="skeleton-product"></div>
            <div class="skeleton-product"></div>
            <div class="skeleton-product"></div>
          </div>
          <div class="question-banner-links">
            <div class="skeleton-show-more"></div>
          </div>
        </div>
      </div>
    `;

    fetch(evenFloFAQURL + 'faqs/' + id)
      .then(response => response.json())
      .then(product => {
        if (product?.detail && containsString(product?.detail, errorString())) {
          redirectIfNoData([]);
          return "";
        }

        let productsContent = "";
        product?.products?.forEach(nestedProduct => {
          productsContent += `
            <div class="product-content">
              <a href="/pages/evenflo-faq-product?pid=${nestedProduct?.id}">
                <div class="product-img">
                  <img src="${nestedProduct?.image}" alt="product" />
                </div>
                <div class="product-title">${nestedProduct?.name}</div>
              </a>
            </div>`;
        });

        const tags = getTagsArray(product?.tags || []);
        const tagsHtml = getTagsHtml(tags);

        getBreadCrumbLinks(product?.question, 'question-answer');

        container.innerHTML = `
          <div class="question-col question-col-1">
            <div class="question-content">
              <div class="heading">
                <h1>
                  <span>${product?.question}</span>
                  <span onclick="copyCurrentUrlToClipboard()" class="copy-clipboard-btn">
                    <!-- Clipboard SVG icon here -->
                  </span>
                </h1>
                <div onclick="copyCurrentUrlToClipboard()" class="copy-clipboard-btn">
                  <span>COPY LINK</span>
                  <!-- Clipboard SVG icon here -->
                </div>
                <p>Updated ${formatPostedDate(product?.updated)}</p>
              </div>
              <div class="description">
                <p>${product?.answer}</p>
              </div>
              <div class="question-banner-links">${tagsHtml}</div>
            </div>
          </div>

          <div class="question-col">
            <div class="question-content">
              <div class="heading"><h2>Related Products</h2></div>
              <div class="product-list">${productsContent}</div>
              <div class="question-banner-links">
                <span>Show more products</span>
                <span><!-- Show more SVG icon here --></span>
              </div>
            </div>
          </div>
        `;
      })
      .catch(error => {
        console.error('Error fetching products:', error);
        redirectIfNoData([]);
      })
      .finally(() => {
        container.classList.remove('question-banner-loading');
        productList();
      });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const queryString = window.location.search;
    const urlParams = new URLSearchParams(queryString);

    if (urlParams.has('qid')) {
      let questionID = urlParams.get('qid');
      fetchQuestionsAnswerData(questionID);
    } else {
      window.location.href = '/pages/evenflo-faq-portal';
    }
  });
</script>
