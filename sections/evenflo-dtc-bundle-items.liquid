{% comment %}
  DTC bundle PDP — lists component products (title, image, link).
  Source: product list metafield on the bundle product (default custom.bundle_products).
{% endcomment %}
{{ 'evenflo-dtc-bundle-items.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign metafield_namespace = section.settings.metafield_namespace | default: 'custom'
  assign metafield_key = section.settings.metafield_key | default: 'bundle_products'
  assign bundle_products = product.metafields[metafield_namespace][metafield_key].value

  if bundle_products == blank
    assign bundle_products = product.metafields.custom.bundle_products.value
  endif

  if bundle_products == blank
    assign bundle_products = product.metafields.custom.dtc_bundle_products.value
  endif

  if bundle_products == blank
    assign bundle_products = product.metafields.product_info.bundle_products.value
  endif
-%}

{%- if bundle_products != blank -%}
  <div
    id="dtc-bundle-items-{{ section.id }}"
    class="evenflo-dtc-bundle-items new-2026 section-{{ section.id }}-padding"
    {{ section.shopify_attributes }}
  >
    <div class="container page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="evenflo-dtc-bundle-items__heading h3">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <ul
        class="evenflo-dtc-bundle-items__grid"
        role="list"
        style="--dtc-bundle-columns: {{ bundle_products.size | at_most: 4 }};"
      >
        {%- for bundle_product in bundle_products -%}
          {%- if bundle_product != blank -%}
            <li class="evenflo-dtc-bundle-items__item">
              <a class="evenflo-dtc-bundle-items__card" href="{{ bundle_product.url }}">
                <div class="evenflo-dtc-bundle-items__media">
                  {%- if bundle_product.featured_image != blank -%}
                    {{
                      bundle_product.featured_image
                      | image_url: width: 600
                      | image_tag:
                        class: 'evenflo-dtc-bundle-items__image',
                        loading: 'lazy',
                        widths: '200, 300, 400, 600',
                        sizes: '(min-width: 990px) 280px, (min-width: 750px) 33vw, 50vw',
                        alt: bundle_product.featured_image.alt | default: bundle_product.title | escape
                    }}
                  {%- else -%}
                    <div class="evenflo-dtc-bundle-items__image-placeholder" aria-hidden="true"></div>
                  {%- endif -%}
                </div>
                <div class="evenflo-dtc-bundle-items__title">
                  <span class="h5">{{ bundle_product.title | escape }}</span>
                </div>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "DTC Bundle Items",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's included"
    },
    {
      "type": "header",
      "content": "Product data"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom",
      "info": "List of products metafield on the bundle product (type: list.product_reference)."
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "bundle_products",
      "info": "Also checks custom.bundle_products, custom.dtc_bundle_products, and product_info.bundle_products if the configured metafield is empty."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "DTC Bundle Items"
    }
  ]
}
{% endschema %}
