<a href="{{ section.settings.promo_link }}">
  <div style="position: relative;">
    <div class="desktop">
      <img
        width=""
        height=""
        class="desktop"
        src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Holiday_2024_DTC_Homepage_Header.jpg?v=1732851209
          
        "
      >
    </div>

    <div class="mobile">
      <img
        width=""
        height=""
        class="mobile"
        src="

            https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Holiday_2024_DTC_Homepage_MObile.jpg?v=1732851255  
         
        "
      >
    </div>

    
  </div>
</a>

<style>
  .mobile,
  .desktop {
    min-width: 100%;
  }

  @media screen and (min-width: 800px) {
    .mobile {
      display: none;
    }
  }

  @media screen and (max-width: 800px) {
    .desktop {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Evenflo Single Promo",
