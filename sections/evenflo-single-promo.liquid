<a href="{{ section.settings.promo_link }}">
  <div style="position: relative;">
    <div class="desktop">
            <!-- {%- assign desktop_banner = section.settings.desktop_banner -%}
{{ desktop_banner | image_url: width: desktop_banner.width | image_tag: class: 'desktop', loading: 'lazy' }} -->
      <img
        width=""
        height=""
        class="desktop"
        src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Holiday_2024_DTC_Homepage_Header.jpg?v=1732851209
          
        "
      >
      {%- assign desktop_banner = section.settings.desktop_banner -%}
{{ desktop_banner | image_url: width: desktop_banner.width | image_tag: class: 'desktop', loading: 'lazy' }}
    </div>

    <div class="mobile">
      <img
        width=""
        height=""
        class="mobile"
        src="

            https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Holiday_2024_DTC_Homepage_MObile.jpg?v=1732851255  
         
        "
      >
    </div>

    
  </div>
</a>

<style>
  .mobile,
  .desktop {
    min-width: 100%;
  }

  @media screen and (min-width: 800px) {
    .mobile {
      display: none;
    }
  }

  @media screen and (max-width: 800px) {
    .desktop {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Evenflo Single Promo",
  "tag": "section",
  "class": "text",
  "settings": [
    {
      "type": "text",
      "id": "promo_link",
      "label": "Bronze and Silver Loyalty Banner Link",
      "default": "Add url here"
    },
    {
      "type": "image_picker",
      "id": "desktop_banner",
      "label": "Desktop Banner"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
  ],
  "presets": [
    {
      "name": "Evenflo Single Promo"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}
