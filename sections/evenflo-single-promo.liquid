<a href="{{ section.settings.promo_link }}">
  <div style="position: relative;">
    {% assign current_date = 'now' | date: '%s' %}
    {% assign start_date = '2024-12-05' | date: '%s' %}
    {%- comment -%}Promotion Start Date{%- endcomment -%}
    {% assign end_date = '2024-12-12' | date: '%s' %}

    <div class="desktop">
      {% if current_date >= start_date and current_date <= end_date %}
        {%- if section.settings.desktop_banner != blank -%}
          {%- assign desktop_banner = section.settings.desktop_banner -%}
          {{ desktop_banner | image_url: width: desktop_banner.width | image_tag: class: 'desktop', loading: 'lazy' }}
        {%- endif -%}
      {% else %}
        <img
          width=""
          height=""
          class="desktop"
          src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Holiday_2024_DTC_Deal_Days_1920x450_1963aec8-5e77-4a4f-ac82-03590af4e8ab.jpg?v=1733454918"
        >
      {% endif %}
    </div>

    <div class="mobile">
      {% if current_date >= start_date and current_date <= end_date %}
        {%- if section.settings.mobile_image != blank -%}
          {%- assign mobile_image = section.settings.mobile_image -%}
          {{ mobile_image | image_url: width: mobile_image.width | image_tag: class: 'mobile', loading: 'lazy' }}
        {%- endif -%}
      {% else %}
        <img
          width=""
          height=""
          class="mobile"
          src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Holiday_2024_DTC_Deal_Days_400x500_5ae15006-f485-41fa-a884-d2f94e086143.jpg?v=1733454956"
        >
      {% endif %}
    </div>
  </div>
</a>

<style>
  .mobile,
  .desktop {
    min-width: 100%;
  }

  @media screen and (min-width: 800px) {
    .mobile {
      display: none;
    }
  }

  @media screen and (max-width: 800px) {
    .desktop {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Evenflo Single Promo",
  "tag": "section",
  "class": "text",
  "settings": [
    {
      "type": "text",
      "id": "promo_link",
      "label": "Bronze and Silver Loyalty Banner Link",
      "default": "Add url here"
    },
    {
      "type": "image_picker",
      "id": "desktop_banner",
      "label": "Desktop Banner"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    }
  ],
  "presets": [
    {
      "name": "Evenflo Single Promo"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}
