<a href="{{ section.settings.promo_link }}">
  <div style="position: relative;">
    {% assign current_date = 'now' | date: '%s' %}
    {% assign start_date = '2024-12-02' | date: '%s' %}
    {%- comment -%}Promotion Start Date{%- endcomment -%}
    {% assign end_date = '2024-12-03' | date: '%s' %}

    <div class="desktop">
      {% if current_date >= start_date and current_date <= end_date %}
        {%- if section.settings.desktop_banner != blank -%}
          {%- assign desktop_banner = section.settings.desktop_banner -%}
          {{ desktop_banner | image_url: width: desktop_banner.width | image_tag: class: 'desktop', loading: 'lazy' }}
        {%- endif -%}
      {% else %}
        <img
          width=""
          height=""
          class="desktop"
          src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Holiday_2024_DTC_Cyber_Monday_1920x450_d8c966a2-da9f-4d28-a74d-8cf4b9a8f349.jpg?v=1733105096"
        >
      {% endif %}
    </div>

    <div class="mobile">
      {% if current_date >= start_date and current_date <= end_date %}
        {%- if section.settings.mobile_image != blank -%}
          {%- assign mobile_image = section.settings.mobile_image -%}
          {{ mobile_image | image_url: width: mobile_image.width | image_tag: class: 'mobile', loading: 'lazy' }}
        {%- endif -%}
      {% else %}
        <img
          width=""
          height=""
          class="mobile"
          src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Holiday_2024_DTC_Homepage_Header_Cyber_Monday_400x500_fde3c7bf-5778-4e27-8d09-0c0ad82b6dc5.jpg?v=1733146112"
        >
      {% endif %}
    </div>
  </div>
</a>

<style>
  .mobile,
  .desktop {
    min-width: 100%;
  }

  @media screen and (min-width: 800px) {
    .mobile {
      display: none;
    }
  }

  @media screen and (max-width: 800px) {
    .desktop {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Evenflo Single Promo",
  "tag": "section",
  "class": "text",
  "settings": [
    {
      "type": "text",
      "id": "promo_link",
      "label": "Bronze and Silver Loyalty Banner Link",
      "default": "Add url here"
    },
    {
      "type": "image_picker",
      "id": "desktop_banner",
      "label": "Desktop Banner"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    }
  ],
  "presets": [
    {
      "name": "Evenflo Single Promo"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}
