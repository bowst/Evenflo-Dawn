{% schema %}
{
  "name": "Evenflo Collection Head",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title",
      "default": "Your Collection Title"
    }
  ],
  "presets": [
    {
      "name": "Evenflo Collection Head",
      "category": "Collection pages"
    }
  ]
}
{% endschema %}
<div class="content-container">
<div class="collection-page-text-content">
  <h1>{{ section.settings.page_title }}</h1>
  <div class="collection-content">
    <p>{{ collection.description }}</p>
  </div>
</div>
</div>
<style>
  .collection-page-text-content {
    text-align: left;
    padding: 20px;
    margin-bottom: 20px;
  }

  .collection-page-text-content h1 {
    font-size: 2em;
    margin-bottom: 10px;
  }

  .collection-content {
    font-size: 1em;
    color: #333;
  }
</style>
