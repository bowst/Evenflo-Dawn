

{% schema %}
{
  "name": "Evenflo Collection Head",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title",
      "default": "Your Collection Title"
    },
  {
      "type": "text",
      "id": "page_subtitle",
      "label": "Page subtitle",
    }
  ],
  "presets": [
    {
      "name": "Evenflo Collection Head",
      "category": "Collection pages"
    }
  ]
}
{% endschema %}
<div class="page-width">
<div class="collection-page-text-content">
  <h1>{{ section.settings.page_title }}</h1>
  <div class="collection-content">
    <h2>{{ section.settings.page_subtitle }}</h2>
  </div>
</div>
</div>
<style>
  .page-width {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .collection-page-text-content {
    text-align: left;
    padding: 20px 0; /* Removed side padding since it's handled by page-width */
    margin-bottom: 20px;
    margin-top: 30px;
  }

  .collection-page-text-content h1 {
    font-size: 2em;
    margin-bottom: 10px;
    font-weight: 300;
  }

  .collection-content {
    font-size: 1em;
    color: #333;

  }

  @media screen and (min-width: 750px) {
    .page-width {
      padding: 0 5rem;
    }
  }
</style>
