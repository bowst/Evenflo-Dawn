{% comment %} Evenflo Hero Banner - 2026, to replace existing Evenflo Image Banners {%  endcomment %}
{{ 'evenflo-hero-banner.css' | asset_url | stylesheet_tag }}
{% style %}

	{% if section.settings.desktop_overlay_opacity > 0 %}
		{% assign overlay_opacity = 100 | minus: section.settings.desktop_overlay_opacity | times: 0.01 %}
		#hero-banner-{{ section.id }} .desktop-image {
			opacity: {{ overlay_opacity }};
		}
	{% endif %}
{% endstyle %}

<div id="hero-banner-{{ section.id }}" class="evenflo-hero-banner {{ section.settings.content_alignment }} text-{{ section.settings.text_color }} {{ section.settings.desktop_overlay_opacity }} new-2026">
	<div class="hero-banner-content">
	  <div class="container page-width">
		{% if section.settings.eyebrow_text != blank %}
			<p class="eyebrow-text h6">{{ section.settings.eyebrow_text }}</p>
		{% endif %}

		{% if section.settings.primary_heading != blank %}
			<h1 class="primary-heading h1">{{ section.settings.primary_heading }}</h1>
		{% endif %}

		{% if section.settings.short_description != blank %}
			<p class="short-description">{{ section.settings.short_description }}</p>
		{% endif %}

		{% if section.settings.primary_cta_link != blank or section.settings.secondary_cta_link != blank %}
		<div class="hero-banner-buttons">
			{% if section.settings.primary_cta_text != blank and section.settings.primary_cta_link != blank %}
				<a href="{{ section.settings.primary_cta_link }}" class="button button--secondary {{ section.settings.text_color }}">{{ section.settings.primary_cta_text }}</a>
			{% endif %}
			
			{% if section.settings.secondary_cta_text != blank and section.settings.secondary_cta_link != blank %}
				<a href="{{ section.settings.secondary_cta_link }}" class="text-link">{{ section.settings.secondary_cta_text }}</a>
			{% endif %}
		</div>
		{% endif %}
	  </div>
	</div>

	{% render 'evenflo-banner-background-media',
		wrapper_class: 'hero-banner-image',
		desktop_image: section.settings.desktop_image,
		mobile_image: section.settings.mobile_image,
		desktop_video: section.settings.desktop_video,
		mobile_video: section.settings.mobile_video,
		enable_video_looping: section.settings.enable_video_looping,
		alt_text: section.settings.primary_heading | strip_html,
		eager: true
	%}
</div>
{% schema %}
{
	"name": "Evenflo Hero Banner",
	"tag": "section",
	"class": "section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
	{
		"type": "header",
		"content": "Content"
	},
	{
		"type": "image_picker",
		"id": "desktop_image",
		"label": "Desktop image"
	},
	{
		"type": "image_picker",
		"id": "mobile_image",
		"label": "Mobile image"
	},
	{
		"type": "header",
		"content": "Video background"
	},
	{
		"type": "video",
		"id": "desktop_video",
		"label": "Desktop video"
	},
	{
		"type": "video",
		"id": "mobile_video",
		"label": "Mobile video",
		"info": "Optional. Uses desktop video when empty."
	},
	{
		"type": "checkbox",
		"id": "enable_video_looping",
		"default": true,
		"label": "Loop video"
	},
	{
		"type": "text",
		"id": "eyebrow_text",
		"label": "Eyebrow text"
	},
	{
		"type": "richtext",
		"id": "primary_heading",
		"label": "Primary heading"
	},
	{
		"type": "text",
		"id": "short_description",
		"label": "Short description"
	},
	{
		"type": "text",
		"id": "primary_cta_text",
		"label": "Primary CTA text"
	},
	{
		"type": "url",
		"id": "primary_cta_link",
		"label": "Primary CTA link"
	},
	{
		"type": "text",
		"id": "secondary_cta_text",
		"label": "Secondary CTA text"
	},
	{
		"type": "url",
		"id": "secondary_cta_link",
		"label": "Secondary CTA link"
	},
	{
		"type": "header",
		"content": "Styles"
	},
	{
		"type": "select",
		"id": "content_alignment",
		"label": "Content alignment",
		"options": [
		{ "value": "align-left", "label": "Left" },
		{ "value": "align-center", "label": "Center" },
		{ "value": "align-right", "label": "Right" }
		],
		"default": "align-left"
	},
	{
		"type": "select",
		"id": "text_color",
		"label": "Text color",
		"options": [
		{ "value": "light", "label": "Light text" },
		{ "value": "dark", "label": "Dark text" }
		],
		"default": "dark"
	},
	{
		"type": "range",
		"id": "desktop_overlay_opacity",
		"min": 0,
		"max": 100,
		"step": 1,
		"default": 0,
		"unit": "%",
		"label": "Desktop image overlay",
		"info": "Opacity from 0% (light) to 100% (dark)"
	}
	],
	"presets": [
		{
			"name": "Evenflo Hero Banner"
		}
	]
}
{% endschema %}
