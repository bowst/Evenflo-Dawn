{{ 'evenflo-section-at-a-glance-section.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading | default: 'At a Glance'
  assign sensorsafe_url = section.settings.sensorsafe_url | default: '/pages/sensorsafe'
  assign sensorysoothe_url = section.settings.sensorysoothe_url | default: '/pages/sensorysoothe'
-%}

<div class="aag-section" style="background-color: {{ section.settings.background_color }};">
  <div class="aag-section__inner page-width">
    {%- if heading != blank -%}
      <h2 class="aag-section__heading">{{ heading }}</h2>
    {%- endif -%}

    {% render 'evenflo-at-a-glance-cards',
      product: product,
      sensorsafe_url: sensorsafe_url,
      sensorysoothe_url: sensorysoothe_url
    %}
  </div>
</div>

{% schema %}
{
  "name": "At a Glance",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Cards populate automatically from the product's metafields (Child Weight, Product Weight, Modes of Use, SensorSafe, SensorySoothe). Add this section to a product template."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "At a Glance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF8F6"
    },
    {
      "type": "header",
      "content": "Card Links"
    },
    {
      "type": "url",
      "id": "sensorsafe_url",
      "label": "SensorSafe \"See Details\" link (defaults to /pages/sensorsafe)"
    },
    {
      "type": "url",
      "id": "sensorysoothe_url",
      "label": "SensorySoothe \"See Details\" link (defaults to /pages/sensorysoothe)"
    }
  ],
  "presets": [
    {
      "name": "At a Glance",
      "category": "Custom Sections",
      "settings": {
        "heading": "At a Glance",
        "background_color": "#FAF8F6"
      }
    }
  ]
}
{% endschema %}
