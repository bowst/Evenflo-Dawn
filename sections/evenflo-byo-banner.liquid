            "label": "Middle Center"
          }, {
            "value": "middle-right",
            "label": "Middle Right"
          }, {
            "value": "bottom-left",
            "label": "Bottom Left"
          }, {
            "value": "bottom-center",
            "label": "Bottom Center"
          }, {
            "value": "bottom-right",
            "label": "Bottom Right"
          }
