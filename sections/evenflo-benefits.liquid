{{ 'section-evenflo-benefits.css' | asset_url | stylesheet_tag }}

{%- assign benefits = shop.metaobjects.benefits_of_evenflo.values -%}

<div
  class="evenflo-benefits"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="evenflo-benefits__container page-width">
    {% if benefits.count > 0 %}
      <div class="evenflo-benefits__grid">
        {% for benefit in benefits %}
          {%- assign benefit_url = benefit.link.value.url | default: benefit.link.value -%}
          {%- capture button_inner -%}
            {%- if benefit.icon.value != blank -%}
              {{
                benefit.icon.value
                | image_url: width: 48
                | image_tag: loading: 'lazy', width: 24, height: 24, alt: '', class: 'evenflo-benefits__icon'
              }}
            {%- endif -%}
            {%- if benefit.text.value != blank -%}
              <span class="evenflo-benefits__label">{{ benefit.text.value }}</span>
            {%- endif -%}
          {%- endcapture -%}

          {% if benefit_url != blank %}
            <a class="evenflo-benefits__button" href="{{ benefit_url }}">
              {{ button_inner }}
            </a>
          {% else %}
            <div class="evenflo-benefits__button">
              {{ button_inner }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Benefits",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Give $20, Get $20",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "description",
          "default": "Refer a friend and earn points for each successful referral.",
          "label": "Description Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits"
    }
  ]
}
{% endschema %}
