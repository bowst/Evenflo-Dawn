{% comment %} 2026 - Evenflo - PDP Tabs {% endcomment %}
{{ 'evenflo-pdp-tabs.css' | asset_url | stylesheet_tag }}
{{ 'evenflo-pdp-tabs.js' | asset_url | script_tag }}

{% assign overview_content = product.metafields.sf_products.short_description.value %}
{% assign specs_content = product.metafields.custom.specs_content.value %}
{% capture whats_included_content %}
  {% render 'evenflo-pdp-tab-whats-included' %}
{% endcapture %}
{% assign whats_included_content = whats_included_content | strip %}
{% capture dimensions_fit_content %}
  {% render 'evenflo-pdp-tab-dimensions-fit' %}
{% endcapture %}
{% assign dimensions_fit_content = dimensions_fit_content | strip %}
{% capture specifications_content %}
  {% render 'evenflo-pdp-tab-specifications' %}
{% endcapture %}
{% assign specifications_content = specifications_content | strip %}

{% assign tab_count = 0 %}
{% if overview_content != blank %}{% assign tab_count = tab_count | plus: 1 %}{% endif %}
{% if specs_content != blank %}{% assign tab_count = tab_count | plus: 1 %}{% endif %}
{% if whats_included_content != blank %}{% assign tab_count = tab_count | plus: 1 %}{% endif %}
{% if dimensions_fit_content != blank %}{% assign tab_count = tab_count | plus: 1 %}{% endif %}
{% if specifications_content != blank %}{% assign tab_count = tab_count | plus: 1 %}{% endif %}
{% assign tab_count = tab_count | plus: 2 %}

{%- liquid
  assign panel_overview = 'overview-' | append: section.id
  assign panel_specs = 'specs-' | append: section.id
  assign panel_included = 'included-' | append: section.id
  assign panel_dimensions = 'dimensions-' | append: section.id
  assign panel_specifications = 'specifications-' | append: section.id
  assign panel_reviews = 'reviews-' | append: section.id
  assign panel_faqs = 'faqs-' | append: section.id

  assign first_panel = panel_reviews
  if overview_content != blank
    assign first_panel = panel_overview
  elsif specs_content != blank
    assign first_panel = panel_specs
  elsif whats_included_content != blank
    assign first_panel = panel_included
  elsif dimensions_fit_content != blank
    assign first_panel = panel_dimensions
  elsif specifications_content != blank
    assign first_panel = panel_specifications
  endif
-%}

{% if tab_count > 0 %}
  <div id="evenflo-pdp-tabs-{{ section.id }}" class="evenflo-pdp-tabs _new-2026" {{ section.shopify_attributes }}>
    <div class="page-width">
      <div class="tabs-container">
        <div class="tabs-nav" role="tablist" aria-label="Product content tabs">
          {% if overview_content != blank %}
            <button
              class="tab-button{% if first_panel == panel_overview %} active{% endif %}"
              type="button"
              role="tab"
              data-tab="{{ panel_overview }}"
              aria-selected="{% if first_panel == panel_overview %}true{% else %}false{% endif %}"
            >
              Overview
            </button>
          {% endif %}
          {% if specs_content != blank %}
            <button
              class="tab-button{% if first_panel == panel_specs %} active{% endif %}"
              type="button"
              role="tab"
              data-tab="{{ panel_specs }}"
              aria-selected="{% if first_panel == panel_specs %}true{% else %}false{% endif %}"
            >
              Specs
            </button>
          {% endif %}
          {% if whats_included_content != blank %}
            <button
              class="tab-button{% if first_panel == panel_included %} active{% endif %}"
              type="button"
              role="tab"
              data-tab="{{ panel_included }}"
              aria-selected="{% if first_panel == panel_included %}true{% else %}false{% endif %}"
            >
              What's Included
            </button>
          {% endif %}
          {% if dimensions_fit_content != blank %}
            <button
              class="tab-button{% if first_panel == panel_dimensions %} active{% endif %}"
              type="button"
              role="tab"
              data-tab="{{ panel_dimensions }}"
              aria-selected="{% if first_panel == panel_dimensions %}true{% else %}false{% endif %}"
            >
              Dimensions &amp; Fit
            </button>
          {% endif %}
          {% if specifications_content != blank %}
            <button
              class="tab-button{% if first_panel == panel_specifications %} active{% endif %}"
              type="button"
              role="tab"
              data-tab="{{ panel_specifications }}"
              aria-selected="{% if first_panel == panel_specifications %}true{% else %}false{% endif %}"
            >
              Specifications
            </button>
          {% endif %}
          <button
            class="tab-button{% if first_panel == panel_reviews %} active{% endif %}"
            type="button"
            role="tab"
            data-tab="{{ panel_reviews }}"
            aria-selected="{% if first_panel == panel_reviews %}true{% else %}false{% endif %}"
          >
            Reviews
          </button>
          <button
            class="tab-button{% if first_panel == panel_faqs %} active{% endif %}"
            type="button"
            role="tab"
            data-tab="{{ panel_faqs }}"
            aria-selected="{% if first_panel == panel_faqs %}true{% else %}false{% endif %}"
          >
            FAQs
          </button>
        </div>

        <div class="tabs-content-container evenflo-pdp-accordion" role="region" aria-label="Product information">
          {% if overview_content != blank %}
            <section
              class="tab-content{% if first_panel == panel_overview %} active mobile-open{% endif %}"
              data-panel="{{ panel_overview }}"
              role="tabpanel"
            >
              <h3
                class="content-heading"
                role="button"
                tabindex="0"
                aria-expanded="{% if first_panel == panel_overview %}true{% else %}false{% endif %}"
              >
                Overview
              </h3>
              <div class="content-body">
                <div class="evenflo-pdp-tab-layout">
                  <div class="evenflo-pdp-tab-layout__full-width rte">
                    <h3>
                      {{ product.title | escape -}}
                    </h3>
                    {{ overview_content }}
                  </div>
                </div>
              </div>
            </section>
          {% endif %}

          {% if specs_content != blank %}
            <section
              class="tab-content{% if first_panel == panel_specs %} active mobile-open{% endif %}"
              data-panel="{{ panel_specs }}"
              role="tabpanel"
            >
              <h3
                class="content-heading"
                role="button"
                tabindex="0"
                aria-expanded="{% if first_panel == panel_specs %}true{% else %}false{% endif %}"
              >
                Specs
              </h3>
              <div class="content-body">
                {{ specs_content }}
              </div>
            </section>
          {% endif %}

          {% if whats_included_content != blank %}
            <section
              class="tab-content{% if first_panel == panel_included %} active mobile-open{% endif %}"
              data-panel="{{ panel_included }}"
              role="tabpanel"
            >
              <h3
                class="content-heading"
                role="button"
                tabindex="0"
                aria-expanded="{% if first_panel == panel_included %}true{% else %}false{% endif %}"
              >
                What's Included
              </h3>
              <div class="content-body">
                {{ whats_included_content }}
              </div>
            </section>
          {% endif %}

          {% if dimensions_fit_content != blank %}
            <section
              class="tab-content{% if first_panel == panel_dimensions %} active mobile-open{% endif %}"
              data-panel="{{ panel_dimensions }}"
              role="tabpanel"
            >
              <h3
                class="content-heading"
                role="button"
                tabindex="0"
                aria-expanded="{% if first_panel == panel_dimensions %}true{% else %}false{% endif %}"
              >
                Dimensions & Fit
              </h3>
              <div class="content-body">
                {{ dimensions_fit_content }}
              </div>
            </section>
          {% endif %}

          {% if specifications_content != blank %}
            <section
              class="tab-content{% if first_panel == panel_specifications %} active mobile-open{% endif %}"
              data-panel="{{ panel_specifications }}"
              role="tabpanel"
            >
              <h3
                class="content-heading"
                role="button"
                tabindex="0"
                aria-expanded="{% if first_panel == panel_specifications %}true{% else %}false{% endif %}"
              >
                Specifications
              </h3>
              <div class="content-body">
                {{ specifications_content }}
              </div>
            </section>
          {% endif %}

          <section
            class="tab-content{% if first_panel == panel_reviews %} active mobile-open{% endif %}"
            data-panel="{{ panel_reviews }}"
            role="tabpanel"
          >
            <h3
              class="content-heading"
              role="button"
              tabindex="0"
              aria-expanded="{% if first_panel == panel_reviews %}true{% else %}false{% endif %}"
            >
              Reviews
            </h3>
            <div class="content-body">
              <div
                class="yotpo-widget-instance"
                data-yotpo-instance-id="498559"
                data-yotpo-product-id="{{product.id}}"
                data-yotpo-name="{{ product.title | escape }}"
                data-yotpo-url="{{ shop.url }}{{ product.url }}"
                data-yotpo-image-url="{{ product.featured_image | product_img_url: "large" | prepend: "https:" | replace: '?', '%3F' | replace: '&','%26'}}"
                data-yotpo-price="{{ product.price | divided_by: 100.00 }}"
                data-yotpo-currency="{{ shop.currency }}"
                data-yotpo-description="{{ product.description | escape }}"
              ></div>
            </div>
          </section>

          <section
            class="tab-content{% if first_panel == panel_faqs %} active mobile-open{% endif %}"
            data-panel="{{ panel_faqs }}"
            role="tabpanel"
          >
            <h3
              class="content-heading"
              role="button"
              tabindex="0"
              aria-expanded="{% if first_panel == panel_faqs %}true{% else %}false{% endif %}"
            >
              FAQs
            </h3>
            <div class="content-body">
              <div
                class="yotpo-widget-instance"
                data-yotpo-instance-id="511091"
                data-yotpo-product-id="{{product.id}}"
                data-yotpo-name="{{ product.title | escape }}"
                data-yotpo-url="{{ shop.url }}{{ product.url }}"
                data-yotpo-image-url="{{ product.featured_image | product_img_url: "large" |replace: '?', '%3F' | replace: '&','%26'}}"
                data-yotpo-description="{{ product.description | escape }}"
              ></div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
{% endif %}

<script src="https://cdn-widgetsrepository.yotpo.com/v1/loader/B0qJeONB1n5uLg0RiKMrl58AdoGwnftUWBiOC4S6" async></script>

{% schema %}
{
  "name": "PDP Tabs",
  "limit": 1,
  "class": "section evenflo-pdp-tabs-section",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "PDP Tabs"
    }
  ]
}
{% endschema %}
