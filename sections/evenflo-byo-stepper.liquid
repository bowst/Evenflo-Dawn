      <div class="filter-title">${step.category}</div>
      <div class="filter-options">
        <ul>
          ${step.items
            .map((item) => {
              console.log("PENCIL", !(
                    (hideStepSixEditPencil && item.step === 6) ||
                    (selectedItems.skipStrollerSteps === true && item.step > 3)
                  ))
              const className =
                item.step === currentStep
                  ? "step active"
                  : item.step < currentStep
                  ? "step completed"
                  : "step";
              
              const pencilIcon =
                item.step < currentStep &&
                  !(
                    (hideStepSixEditPencil && item.step === 6) ||
                    (selectedItems.skipStrollerSteps === true && item.step > 3 && item.step !== 6)
                  )
                  ? `<span style="margin-left: auto; cursor: pointer;" onclick="stepperEdit(${item.step})">
                        <img src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/pencil.svg?v=1753445128" alt="Edit" />
                     </span>`
                  : "";

              return `
                <li class="${className}">
                  <span class="filter-count">${item.step + 1}</span>
                  <span class="filter-label">${item.label}</span>
                  ${pencilIcon}
                </li>
              `;
            })
            .join("")}
        </ul>
      </div>
    </div>
  `;
  });

  productSidebar.innerHTML = productSidebarContent.join("");
}

function updateStepperButtons() {
  const isFirst = currentStep === 0;
  const isLast = currentStep === stepperSteps.length - 1;
  stepperPreviousBtn.classList.toggle("hidden-btn", isFirst || isLast);
  stepperNextBtn.classList.toggle("hidden-btn", isLast);
  buttonWrapper.classList.toggle("hidden-btn", !isLast);
  updateNoExtraButton()

}

function renderStepContent() {
  const titleOf = stepperSteps[currentStep]?.title || "";
  const isTitle = (t) => titleOf === t;
  const uniqueColorVariants = (products) => {
    const seen = new Set();
    const out = [];
    for (const p of products) {
      for (const v of p.variants || []) {
        if (!seen.has(v.color)) {
          seen.add(v.color);
          out.push({
            ...v,
            label: v.color,
            image: v.byoColorImage ?? "https://www.svgrepo.com/show/508699/landscape-placeholder.svg",
            productData: p
          });
        }
      }
    }
    return out;
  };

  const strollerStepFromType = (type) => {
    const matching = strollers.filter(s => s.stroller === type);
    if (matching.length) {
      return {
        title: "Choose Your Stroller Color",
        item: uniqueColorVariants(matching),
        alternativeMessage: null
      };
    }
    const altType = type === "intuiti+" ? "intuiti" : "intuiti+";
    const alt = strollers.filter(s => s.stroller === altType);
    if (alt.length) {
      const selectedTypeName = type === "intuiti+" ? "Intuiti+" : "Intuiti";
      const alternativeTypeName = altType === "intuiti+" ? "Intuiti+" : "Intuiti";
      return {
        title: "Choose Your Stroller Color",
        item: uniqueColorVariants(alt),
        alternativeMessage: `Sorry, there are no ${selectedTypeName} strollers available. Would you like to buy a ${alternativeTypeName} stroller instead?`
      };
    }
    return {
      title: "Choose Your Stroller Color",
      item: [],
      alternativeMessage: "Sorry, no strollers are available at this time."
    };
  };

  const needSwiperFor = (title, count, currentStep) => {
    if (swiperSliderActive && ![0,1,2,4].includes(currentStep)) return true;
    const thresholds = {
      "Choose Your Car Seat Color": 4,
      "Choose Your Stroller Color": 3,
      "Add Accessories (Optional)": 3,
      "Review Your Selection": 3
    };
    return count > (thresholds[title] ?? Infinity);
  };

  const wrapperClassFor = (title) => {
    if (currentStep === 7)
      return "product-stepper-card-wrapper selected-stepper-card-wrapper swiper-wrapper";
    if (title === "Choose Your Car Seat Color")
      return "product-stepper-card-wrapper product-stepper-card-variant-wrapper swiper-wrapper";
    if (title === "Choose Your Stroller Color")
      return "product-stepper-card-wrapper product-stepper-card-stroller-wrapper swiper-wrapper";
    if (title === "Add Accessories (Optional)")
      return "product-stepper-card-wrapper product-stepper-card-accessory-wrapper swiper-wrapper";
    return "product-stepper-card-wrapper";
  };

  const cardClassFor = (title) => {
    if (title === "Choose Your Car Seat Color") return "variant-color swiper-slide";
    if (title === "Choose Your Stroller Color") return "stroller-card swiper-slide";
    if (title === "Add Accessories (Optional)") return "accessory-card swiper-slide";
    if (title === "Review Your Selection") return "review-card swiper-slide";
    return "";
  };

  let stepContent;

  if (currentStep === 7) {
    const reducedAmount = cart.reduce((acc, curr) => {
      return acc + (curr?.variant?.price ?? 0);
    }, 0);
    totalAmount = reducedAmount;
    document.querySelector(".buy-now").innerText = "Buy now for $" + reducedAmount

    const cartReviewItems = cart.map(ci => ({
      label: ci?.variant?.byoTitle ?? "Byo Title N/A",
      description: ci?.variant?.byoSubTitle ?? "Byo Subtitle N/A",
      image: ci?.variant?.featureImage ?? "https://www.evenflo.com/cdn/shop/files/evenflo-logo_101dc51f-b744-408d-bba4-82966df062dc.svg",
      productType: ci.productType,
      variant: ci.variant
    }));
    stepContent = { title: "Review Your Selection", item: cartReviewItems };
    stepperSteps[currentStep].item = cartReviewItems;
  } else if (currentStep === 5 && selectedItems.selectedStrollerType) {
    stepContent = stepperSteps[5].alternativeMessage
      ? stepperSteps[5]
      : strollerStepFromType(selectedItems.selectedStrollerType);
  } else {
    stepContent = stepperSteps[currentStep];
  }

  const selected = currentStep === 6 ? selectedItems.accessories : selectedItems[currentStep];
  const selectedLabels = Array.isArray(selected)
    ? selected.map(i => i.label)
    : (selected && selected.label ? [selected.label] : []);
  const isSelected = selectedLabels.length > 0;


  const noItemsAvailable = (stepContent.item?.length === 0) && !!stepContent.alternativeMessage;
  const shouldEnableNext = isSelected || noItemsAvailable;

  stepperNextBtn.disabled = !shouldEnableNext;
  stepperNextBtn.classList.toggle("button-disabled", !shouldEnableNext);


  const count = stepContent.item?.length || 0;
  const needsSwiper = needSwiperFor(stepContent.title, count, currentStep);
  const wrapperClass = wrapperClassFor(stepContent.title);
  const perCardClass = cardClassFor(stepContent.title);

  const productCardsHTML = count
    ? stepContent.item.map((it, idx) => {
        const isCardSelected = selectedLabels.includes(it.label);
        const fullDesc = it.description || "";
        const shortDesc = fullDesc.slice(0, 100);
        const isLong = fullDesc.length > 170;
        return `
          <div class="product-stepper-card ${perCardClass} ${isCardSelected ? "selected" : ""}" onclick="setActiveCard(${idx})">
            <img src="${it.image ?? "https://www.svgrepo.com/show/508699/landscape-placeholder.svg"}" alt="${it.label}" />
            <div class="product-stepper-card-content">
              <h3>${it.label}</h3>
              <p id="desc-${idx}">${isLong ? shortDesc + "..." : fullDesc}</p>
              ${isLong ? `<button class="read-more-btn" onclick="toggleReadMore(event, ${idx})">Read More</button>` : ""}
            </div>
          </div>
        `;
      }).join("")
    : stepContent.alternativeMessage?.includes("no strollers are available")
      ? `<div class="no-products-message" style="text-align: center; padding: 40px; color: #666;">
           <p>No strollers are currently available.</p>
           <p>Click "Next" to proceed to the review.</p>
         </div>`
      : (currentStep === 6 ? "No Accessories Found" : "");

  const alternativeMessageHTML = stepContent.alternativeMessage
    ? `<div class="alternative-message" style="background: #f9f9f9; padding: 15px; margin: 15px 0; border-radius: 8px; border-left: 4px solid #00aea9;">
         <p style="margin: 0; color: #333; font-weight: 500;">${stepContent.alternativeMessage}</p>
       </div>`
    : "";

  const swiperOpen  = needsSwiper ? `<div class="swiper mySwiper">` : "";
  const swiperClose = needsSwiper
    ? `<div class="swiper-button-next"></div>
       <div class="swiper-button-prev"></div>
       <div class="swiper-pagination"></div>
     </div>`
    : "";

  const accessoryCTA =
    isTitle("Add Accessories (Optional)")
      ? `<button class="no-extra-needed" onclick="accessoryNotSelected()">
           No Extras Needed, Let’s Roll
           <svg xmlns="http://www.w3.org/2000/svg" width="14" height="12" viewBox="0 0 14 12" fill="none">
             <path d="M12.9062 6.77148L8.09375 11.3652C7.82031 11.6113 7.41016 11.6113 7.16406 11.3379C6.91797 11.0645 6.91797 10.6543 7.19141 10.4082L10.8281 6.93555H1.53125C1.14844 6.93555 0.875 6.66211 0.875 6.2793C0.875 5.92383 1.14844 5.62305 1.53125 5.62305H10.8281L7.19141 2.17773C6.91797 1.93164 6.91797 1.49414 7.16406 1.24805C7.41016 0.974609 7.84766 0.974609 8.09375 1.2207L12.9062 5.81445C13.043 5.95117 13.125 6.11523 13.125 6.2793C13.125 6.4707 13.043 6.63477 12.9062 6.77148Z" fill="#00AEA9"/>
           </svg>
         </button>`
      : "";

  productStepper.innerHTML = `
    <div class="product-stepper__item">
      <h2>${stepContent.title}</h2>
      ${alternativeMessageHTML}
      ${swiperOpen}
        <div class="${wrapperClass}">
          ${productCardsHTML}
        </div>
      ${swiperClose}
      ${accessoryCTA}
    </div>
  `;

  if (document.querySelector(".mySwiper")) {
    customSwiperSlider();
  }

  updateStepperButtons();
}

function accessoryNotSelected(){
  if (currentStep === 6) {
    currentStep++;
    updateURLHash(); // Add hash update
    render();
    videoLoader();
