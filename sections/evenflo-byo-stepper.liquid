<script src="{{ 'swiper-script.js' | asset_url }}" defer></script>
<script>
const byoVariants = [
  {% for product in collections.byo.products %}
    {% assign in_stock = false %}

    {% capture variants %}
      [
      {% assign first = true %}
      {% for variant in product.variants %}
        {% if variant.inventory_quantity > 0 %}
          {% assign in_stock = true %}
          {% unless first %},{% endunless %}
          {
            "variantTitle": {{ variant.metafields.custom.byo_title.value | json }},
            "variantId": {{ variant.id }},
            "price": {{ variant.price | divided_by: 100.0 }},
            "byoTitle": {{ variant.metafields.custom.byo_title.value | json }},
            "byoSubTitle": {{ variant.metafields.custom.byo_subtitle.value | json }},
            "featureImage": {{ variant.featured_image.src | image_url: width: 600 | json }},
            "color": {{ variant.option1 | json }},
            "colorImage": {{ variant.metafields.custom.new_swatch_image.value | json }},
            "byoColorImage": {{ variant.metafields.custom.byo_color.value | json }},
            "sku": {{ variant.sku | json }},
            "inventory": {{ variant.inventory_quantity }},
            "inStock": true
          }
          {% assign first = false %}
        {% endif %}
      {% endfor %}
      ]
    {% endcapture %}

    {% capture accessories %}
      [
      {% assign first = true %}
      {% for accessory_product in product.metafields.custom.byo_accessories.value %}
        {% assign accessory_variant = accessory_product.variants.first %}
        {% if accessory_variant.inventory_quantity > 0 %}
          {% assign in_stock = true %}
          {% unless first %},{% endunless %}
          {
            "accessoryProductTitle": {{ accessory_variant.metafields.custom.byo_title | json }},
            "accessoryProductDescription": {{ accessory_variant.metafields.custom.byo_subtitle | strip_newlines | json }},
            "accessoryProductImage": {{ accessory_product.featured_image | image_url: width: 600 | json }},
            "accessoryProductId": {{ accessory_product.id }},
            "accessoryVariantId": {{ accessory_variant.id }},
            "price": {{ accessory_variant.price | divided_by: 100.0 }},
            "byoTitle": {{ accessory_variant.metafields.custom.byo_title.value | json }},
            "byoSubTitle": {{ accessory_variant.metafields.custom.byo_subtitle.value | json }},
            "featureImage": {{ accessory_variant.featured_image.src | image_url: width: 600 | json }},
            "color": {{ accessory_variant.option1 | json }},
            "colorImage": {{ accessory_variant.metafields.custom.new_swatch_image.value | json }},
            "byoColorImage": {{ accessory_variant.metafields.custom.byo_color.value | json }},
            "sku": {{ accessory_variant.sku | json }},
            "inventory": {{ accessory_variant.inventory_quantity }},
            "inStock": true
          }
          {% assign first = false %}
        {% endif %}
      {% endfor %}
      ]
    {% endcapture %}

    {% if in_stock %}
      {
        "productId": {{ product.id }},
        "productTitle": {{ product.title | json }},
        "productType": {{ product.type | json }},
        "fabric": {{ product.metafields.custom.green_gentle_fabric.value | json }},
        "rotation": {{ product.metafields.custom.degrees_of_rotation.value | json }},
        "sensorysoothe": {{ product.metafields.custom.sensorysoothe.value | json }},
        "accessories": {{ accessories }},
        "variants": {{ variants }}
      }{% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
];


