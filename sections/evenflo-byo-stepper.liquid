const stepperNextBtn = document.querySelector(".next-btn");
const stepperPreviousBtn = document.querySelector(".previous-btn");

const startOverBtn = document.querySelector(".start-over");

const buttonWrapper = document.querySelector(".product-stepper-btn-wrapper");

const productSidebar = document.querySelector(".product-sidebar");
const productStepper = document.querySelector(".product-stepper");

const cart = []

let currentStep = 0;

let selectedItems = JSON.parse(localStorage.getItem("selectedItems")) || {};

function renderStepSidebar() {
  const productSidebarContent = steps.map((step) => {
    return `
    <div class="sidebar-content">
      <div class="filter-title">${step.category}</div>
      <div class="filter-options">
        <ul>
          ${step.items
            .map((item) => {
              const className =
                item.step === currentStep
                  ? "step active"
                  : item.step < currentStep
                  ? "step completed"
                  : "step";

              const pencilIcon =
                item.step < currentStep
                  ? `<span style="margin-left: auto; cursor: pointer;" onclick="stepperEdit(${item.step})">
                        <img src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/pencil.svg?v=1753445128" alt="Edit" />
                     </span>`
                  : "";

              return `
                <li class="${className}">
                  <span class="filter-count">${item.step + 1}</span>
                  <span class="filter-label">${item.label}</span>
                  ${pencilIcon}
                </li>
              `;
            })
            .join("")}
        </ul>
      </div>
    </div>
  `;
  });

  productSidebar.innerHTML = productSidebarContent.join("");
}

function startOver() {
  startOverBtn.addEventListener("click", () => {
    smoothStepTransition(() => {
      currentStep = 0;
      selectedItems = {};
      cart.length = 0; // Clear the cart array
      localStorage.removeItem("selectedItems");

      // Reset step content to original state
      stepperSteps[3].alternativeMessage = null;
      stepperSteps[5].alternativeMessage = null;
      stepperSteps[5].title = "Choose Your Stroller Color";

      render();
      updateStepperButtons();
    });
  });
}

function hideShowButtons() {
  updateStepperButtons();
}

function updateStepperButtons() {
  const isFirstStep = currentStep === 0;
  const isLastStep = currentStep === stepperSteps.length - 1;

  stepperPreviousBtn.classList.toggle("hidden-btn", isFirstStep || isLastStep);
  stepperNextBtn.classList.toggle("hidden-btn", isLastStep);
  buttonWrapper.classList.toggle("hidden-btn", !isLastStep);
}

function renderStepContent() {
  let stepContent;
  if (currentStep === 7) {
    // Show cart contents for review
    const cartReviewItems = cart.map(cartItem => ({
      label: cartItem.productTitle,
      description: `Type: ${cartItem.productType} | Color: ${cartItem.variant?.color || 'N/A'}`,
      image: cartItem.variant?.colorImage || "https://cdn.shopify.com/s/files/1/0512/2359/3116/files/default-product.png",
      productType: cartItem.productType,
      variant: cartItem.variant
    }));

    stepContent = {
      title: "Review Your Selection",
      item: cartReviewItems,
    };
  } else if (currentStep === 5 && selectedItems.selectedStrollerType) {
    // Check if stepperSteps[5] already has alternative content set by setActiveCard
    if (stepperSteps[5].alternativeMessage) {
      // Use the content that was already set by setActiveCard
      stepContent = stepperSteps[5];
    } else {
      // Dynamically populate stroller color options based on selected stroller type
      stepContent = { ...stepperSteps[currentStep] };
      const selectedStrollerType = selectedItems.selectedStrollerType;
    
    // Find matching stroller products based on the selected frame
    const matchingStrollers = strollers.filter(stroller => 
      stroller.stroller === selectedStrollerType
    );
    
    if (matchingStrollers.length > 0) {
      // Selected stroller type is available
      const strollerColorVariants = [];
      matchingStrollers.forEach(stroller => {
        stroller.variants.forEach(variant => {
          const exists = strollerColorVariants.some(item => item.color === variant.color);
          if (!exists) {
            strollerColorVariants.push({
              ...variant,
              label: variant.color,
              image: variant.byoColorImage ?? "https://www.svgrepo.com/show/508699/landscape-placeholder.svg",
              productData: stroller
            });
          }
        });
      });
      
      // Update step content with the filtered colors
      stepContent.item = strollerColorVariants;
      stepContent.title = "Choose Your Stroller Color";
      stepContent.alternativeMessage = null;
    } else {
      // Selected stroller type is not available, check for alternatives
      const alternativeType = selectedStrollerType === "intuiti+" ? "intuiti" : "intuiti+";
      const alternativeStrollers = strollers.filter(stroller => 
        stroller.stroller === alternativeType
      );
      
      if (alternativeStrollers.length > 0) {
        // Alternative stroller type is available
        const alternativeColorVariants = [];
        alternativeStrollers.forEach(stroller => {
          stroller.variants.forEach(variant => {
            const exists = alternativeColorVariants.some(item => item.color === variant.color);
            if (!exists) {
              alternativeColorVariants.push({
                ...variant,
                label: variant.color,
                image: variant.byoColorImage ?? "https://www.svgrepo.com/show/508699/landscape-placeholder.svg",
                productData: stroller
              });
            }
          });
        });
        
        // Update step content with alternative message and colors
        const selectedTypeName = selectedStrollerType === "intuiti+" ? "Intuiti+" : "Intuiti";
        const alternativeTypeName = alternativeType === "intuiti+" ? "Intuiti+" : "Intuiti";
        
        stepContent.title = "Choose Your Stroller Color";
        stepContent.alternativeMessage = `Sorry, there are no ${selectedTypeName} strollers available. Would you like to buy a ${alternativeTypeName} stroller instead?`;
        stepContent.item = alternativeColorVariants;
      } else {
        // No strollers available at all - skip to review
        stepContent.item = [];
        stepContent.alternativeMessage = "Sorry, no strollers are available at this time.";
      }
    }
    }
  } else {
    stepContent = stepperSteps[currentStep];
  }

  const selected = selectedItems[currentStep]?.label;
  const isSelected = typeof selected !== "undefined";
  
  // Special case: if no stroller items are available, allow next button
  const noItemsAvailable = stepContent.item.length === 0 && stepContent.alternativeMessage;
  const shouldEnableNext = isSelected || noItemsAvailable;

  stepperNextBtn.disabled = !shouldEnableNext;
  stepperNextBtn.classList.toggle("button-disabled", !shouldEnableNext);

  updateStepperButtons();

  const wrapperClass =
    currentStep === 7
      ? "product-stepper-card-wrapper selected-stepper-card-wrapper"
      : "product-stepper-card-wrapper";

  const productCardsHTML = stepContent.item.length > 0 
    ? stepContent.item
        .map((item, index) => {
          const isCardSelected = selected === item.label;

          return `
          <div class="product-stepper-card ${stepperSteps[currentStep].title === "Choose Your Car Seat Color" && "variant-color"} ${
            isCardSelected ? "selected" : ""
          }" onclick="setActiveCard(${index})">
            <img src="${item.image}" alt="${item.label}" />
            <div class="product-stepper-card-content">
              <h3>${item.label}</h3>
              <p>${item.description || ""}</p>
            </div>
          </div>
        `;
        })
        .join("")
    : stepContent.alternativeMessage && stepContent.alternativeMessage.includes("no strollers are available")
        ? `<div class="no-products-message" style="text-align: center; padding: 40px; color: #666;">
             <p>No strollers are currently available.</p>
             <p>Click "Next" to proceed to the review.</p>
           </div>`
        : "";

  const alternativeMessageHTML = stepContent.alternativeMessage 
    ? `<div class="alternative-message" style="background: #f9f9f9; padding: 15px; margin: 15px 0; border-radius: 8px; border-left: 4px solid #00aea9;">
         <p style="margin: 0; color: #333; font-weight: 500;">${stepContent.alternativeMessage}</p>
       </div>`
    : '';

  productStepper.innerHTML = `
    <div class="product-stepper__item">
      <h2>${stepContent.title}</h2>
      ${alternativeMessageHTML}
      <div class="${wrapperClass}">
        ${productCardsHTML}
      </div>
    </div>
  `;
}

function smoothStepTransition(callback) {
  // Add transitioning class for smooth effect
  productStepper.classList.add('transitioning');
  
  // Wait for transition out, then update content
  setTimeout(() => {
    // Update content
    callback();
    
    // Remove transitioning class to fade in new content
    setTimeout(() => {
      productStepper.classList.remove('transitioning');
    }, 50);
  }, 300);
  
  // Smooth scroll to top of stepper section after transition starts
  setTimeout(() => {
    const stepperSection = document.querySelector('.product-stepper');
    if (stepperSection) {
      stepperSection.scrollIntoView({ 
        behavior: 'smooth', 
        block: 'start' 
      });
    }
  }, 100);
}

function render() {
  renderStepContent();
  renderStepSidebar();
}


function checkIfShowStroller(cart){
  const hasTravelSystem = cart.some(item => item.productType === 'Travel System');
  const hasInfantCarSeat = cart.some(item => item.productType === 'Infant Car Seat');

  // If Travel System is selected, we should skip stroller steps
  if (hasTravelSystem) {
    return { skipStrollerSteps: true, reason: 'Travel System selected' };
  }

  // If only Infant Car Seat is selected, continue with stroller steps
  if (hasInfantCarSeat) {
    return { skipStrollerSteps: false, reason: 'Infant Car Seat selected - show stroller options' };
  }

  return { skipStrollerSteps: false, reason: 'No relevant products in cart' };
};

function setActiveCard(passedItemIndex) {
  const stepContent = stepperSteps[currentStep];
  const selectedItem = stepContent.item[passedItemIndex];

  // Update selectedItems with current step and item
  selectedItems[currentStep] = {
    ...selectedItem
  };

  if (stepperSteps[currentStep].title === "Choose Your Car Seat Color") {
    const selectedColor = selectedItem.label;

    const selectedProduct = normalizedVariants.find(product =>
      Array.isArray(product.variants) &&
      product.variants.some(variant => variant.color === selectedColor)
    );

    if (selectedProduct) {
      const matchedVariant = selectedProduct.variants.find(
        variant => variant.color === selectedColor
      );

      const existingCartItemIndex = cart.findIndex(
        item => item.productId === selectedProduct.productId
      );

      if (existingCartItemIndex > -1) {
        cart[existingCartItemIndex].variant = matchedVariant;
      } else {
        cart.push({
          ...selectedProduct,
          variant: matchedVariant
        });
      }
      
      // Check if we should skip stroller steps
      const strollerCheck = checkIfShowStroller(cart);
      selectedItems.skipStrollerSteps = strollerCheck.skipStrollerSteps;
    }
  }


  if (stepperSteps[currentStep].title === "Choose Your Stroller Frame") {
    const selectedStrollerFrame = selectedItem.label;
    const selectedStrollerType = selectedStrollerFrame.includes("Intuiti+") ? "intuiti+" : "intuiti";
    
    // Store the selected stroller type for the next step
    selectedItems.selectedStrollerType = selectedStrollerType;
    
    // Find matching stroller products based on the selected frame
    const matchingStrollers = strollers.filter(stroller => 
      stroller.stroller === selectedStrollerType
    );
    
    if (matchingStrollers.length > 0) {
      // Selected stroller type is available
      const strollerColorVariants = [];
      matchingStrollers.forEach(stroller => {
        stroller.variants.forEach(variant => {
          const exists = strollerColorVariants.some(item => item.color === variant.color);
          if (!exists) {
            strollerColorVariants.push({
              ...variant,
              label: variant.color,
              image: variant.byoColorImage,
              productData: stroller
            });
          }
        });
      });
              // Update the next step's items with the filtered colors
        stepperSteps[5].item = strollerColorVariants;
        stepperSteps[5].title = "Choose Your Stroller Color";
        stepperSteps[5].alternativeMessage = null;
    } else {
      // Selected stroller type is not available, check for alternatives
      const alternativeType = selectedStrollerType === "intuiti+" ? "intuiti" : "intuiti+";
              const alternativeStrollers = strollers.filter(stroller => 
          stroller.stroller === alternativeType
        );
      if (alternativeStrollers.length > 0) {
        // Alternative stroller type is available
        const alternativeColorVariants = [];
        alternativeStrollers.forEach(stroller => {
          stroller.variants.forEach(variant => {
            const exists = alternativeColorVariants.some(item => item.color === variant.color);
            if (!exists) {
              alternativeColorVariants.push({
                ...variant,
                label: variant.color,
                image: variant.byoColorImage,
                productData: stroller
              });
            }
          });
        });
        
        // Update the next step with alternative message and colors
        const selectedTypeName = selectedStrollerType === "intuiti+" ? "Intuiti+" : "Intuiti";
        const alternativeTypeName = alternativeType === "intuiti+" ? "Intuiti+" : "Intuiti";
        stepperSteps[5].title = "Choose Your Stroller Color";
        stepperSteps[5].alternativeMessage = `Sorry, there are no ${selectedTypeName} strollers available. Would you like to buy a ${alternativeTypeName} stroller instead?`;
        stepperSteps[5].item = alternativeColorVariants;
        
                  // Update selected items to reflect the alternative
          selectedItems.selectedStrollerType = alternativeType;
              } else {
          // No strollers available at all - skip to review
          selectedItems.skipToReview = true;
          stepperSteps[5].item = [];
          stepperSteps[5].alternativeMessage = "Sorry, no strollers are available at this time.";
        }
    }
  }

  if (stepperSteps[currentStep].title === "Choose Your Stroller Color") {
    const selectedStrollerColor = selectedItem.label;
    const selectedStrollerProduct = selectedItem.productData;
    
    if (selectedStrollerProduct) {
      const matchedStrollerVariant = selectedStrollerProduct.variants.find(
        variant => variant.color === selectedStrollerColor
      );

      const existingStrollerIndex = cart.findIndex(
        item => item.productId === selectedStrollerProduct.productId
      );

      if (existingStrollerIndex > -1) {
        cart[existingStrollerIndex].variant = matchedStrollerVariant;
      } else {
        cart.push({
          ...selectedStrollerProduct,
          variant: matchedStrollerVariant
        });
      }
    }
  }

  // Save to localStorage
  localStorage.setItem("selectedItems", JSON.stringify(selectedItems));
  // Update UI

  const cards = document.querySelectorAll(".product-stepper-card");
  cards.forEach((card, index) => {
    if (index === passedItemIndex) {
      card.classList.add("selected");
      stepperNextBtn.disabled = true;
      stepperNextBtn.classList.add("button-disabled");
    } else {
      card.classList.remove("selected");
      stepperNextBtn.disabled = false;
      stepperNextBtn.classList.remove("button-disabled");
    }
  });

  stepperNextBtn.disabled = false;
  stepperNextBtn.classList.remove("button-disabled");
}

function matchProductData() {
  const selectedItemsObject = JSON.parse(localStorage.getItem("selectedItems")) || {};
  const selectedItemsArray = Object.values(selectedItemsObject);

  // Combine selected properties into a single object
  const selected = {
    rotation: selectedItemsArray.find(item => item.hasOwnProperty('rotation'))?.rotation,
    fabric: selectedItemsArray.find(item => item.hasOwnProperty('fabric'))?.fabric,
    sensorysoothe: selectedItemsArray.find(item => item.hasOwnProperty('sensorysoothe'))?.sensorysoothe
  };

  const getVariants = (matchProducts)=> {
    const variants = [];
    matchProducts.forEach((product)=>{
    product.variants.forEach((variant)=>{
      const exists = variants.some(item => item.color === variant.color);
      if(!exists){
        variants.push({...variant,label:variant.color, image:variant.colorImage})
      }
    })

    })
    return variants;
  } 

  // Filter products that match all three selected values (exact match)
  const exactMatchProducts = travelSystemsInfantCarSeat.filter(productData => {
    return (
      productData.rotation === selected.rotation &&
      productData.fabric === selected.fabric &&
      productData.sensorysoothe === selected.sensorysoothe
    );
  });

  if (exactMatchProducts.length > 0) {
    // Exact match found - show those products
    stepperSteps[3].item = getVariants(exactMatchProducts);
    stepperSteps[3].alternativeMessage = null;
  } else {
    // No exact match - find alternatives
    
    // Priority 1: Match rotation + fabric (most important features)
    let alternativeProducts = travelSystemsInfantCarSeat.filter(productData => {
      return (
        productData.rotation === selected.rotation &&
        productData.fabric === selected.fabric
      );
    });
    
    let alternativeMessage = '';
    
    if (alternativeProducts.length > 0) {
      const handleType = selected.sensorysoothe === 1 ? 'SensorySoothe' : 'Traditional';
      const availableHandleType = selected.sensorysoothe === 1 ? 'Traditional' : 'SensorySoothe';
      alternativeMessage = `Your selected combination with ${handleType} handle is not available. Here are similar options with ${availableHandleType} handle:`;
    } else {
      // Priority 2: Match rotation + sensorysoothe
      alternativeProducts = travelSystemsInfantCarSeat.filter(productData => {
        return (
          productData.rotation === selected.rotation &&
          productData.sensorysoothe === selected.sensorysoothe
        );
      });
      
      if (alternativeProducts.length > 0) {
        const fabricType = selected.fabric === 1 ? 'Green & Gentle™' : 'Classic';
        const availableFabricType = selected.fabric === 1 ? 'Classic' : 'Green & Gentle™';
        alternativeMessage = `Your selected combination with ${fabricType} fabric is not available. Here are similar options with ${availableFabricType} fabric:`;
      } else {
        // Priority 3: Match fabric + sensorysoothe
        alternativeProducts = travelSystemsInfantCarSeat.filter(productData => {
          return (
            productData.fabric === selected.fabric &&
            productData.sensorysoothe === selected.sensorysoothe
          );
        });
        
        if (alternativeProducts.length > 0) {
          const baseType = selected.rotation === 1 ? 'Rotational' : 'Traditional';
          const availableBaseType = selected.rotation === 1 ? 'Traditional' : 'Rotational';
          alternativeMessage = `Your selected combination with ${baseType} base is not available. Here are similar options with ${availableBaseType} base:`;
        } else {
          // Priority 4: Match rotation only (most important single feature)
          alternativeProducts = travelSystemsInfantCarSeat.filter(productData => {
            return productData.rotation === selected.rotation;
          });
          
          if (alternativeProducts.length > 0) {
            alternativeMessage = `Your exact combination is not available. Here are available options with the same car seat base:`;
          } else {
            // Last resort: Show any available products
            alternativeProducts = travelSystemsInfantCarSeat.filter(product => 
              product.variants && product.variants.length > 0
            );
            alternativeMessage = `Your selected combination is not available. Here are other available options:`;
          }
        }
      }
    }
    
    stepperSteps[3].item = getVariants(alternativeProducts);
    stepperSteps[3].alternativeMessage = alternativeMessage;
  }

  // Products matched - ready for cart functionality
}

function productCartFunction(){
  // Prepare final cart for Shopify
  const finalCartItems = cart.map(item => ({
    variantId: item.variant?.variantId,
    quantity: 1,
    productTitle: item.productTitle,
    productType: item.productType,
    color: item.variant?.color
  }));
  
  return finalCartItems;
}



function addToCart() {
  const finalCartItems = productCartFunction();
  
  if (finalCartItems.length === 0) {
    alert('No items to add to cart');
    return;
  }
  
  // Prepare items for Shopify cart API
  const cartData = {
    items: finalCartItems.filter(item => item.variantId).map(item => ({
      id: item.variantId,
      quantity: item.quantity
    }))
  };
  
      fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(cartData)
    })
    .then(response => response.json())
    .then(data => {
      // Clear localStorage and reset stepper after successful cart addition
      selectedItems = {};
      localStorage.removeItem("selectedItems");
      alert(`Successfully added ${finalCartItems.length} item(s) to cart!`);
      // Redirect to cart page
      window.location.href = '/cart';
    })
  .catch(error => {
    console.error('Error adding to cart:', error);
    alert('Error adding items to cart. Please try again.');
  });
}

function buyNow() {
  const finalCartItems = productCartFunction();
  
  if (finalCartItems.length === 0) {
    alert('No items to buy');
    return;
  }
  
  // Prepare items for Shopify cart API
  const cartData = {
    items: finalCartItems.filter(item => item.variantId).map(item => ({
      id: item.variantId,
      quantity: item.quantity
    }))
  };
  
      fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(cartData)
    })
    .then(response => response.json())
    .then(data => {
      // Clear localStorage and reset stepper after successful cart addition
      selectedItems = {};
      localStorage.removeItem("selectedItems");
      // Redirect directly to checkout
      window.location.href = '/checkout';
    })
  .catch(error => {
    console.error('Error during buy now:', error);
    alert('Error processing your order. Please try again.');
  });
}

function productClear(){
  smoothStepTransition(() => {
    currentStep = 0;
    selectedItems = {};
    cart.length = 0; // Clear the cart array
    localStorage.removeItem("selectedItems");
    
    // Reset step content to original state
    stepperSteps[3].alternativeMessage = null;
    stepperSteps[5].alternativeMessage = null;
    stepperSteps[5].title = "Choose Your Stroller Color";
    
      render();
  updateStepperButtons();
  document.querySelector(".product-listing-wrapper").innerHTML = `<h2 style="margin: auto;">Select any combination of features to view compatible products.</h2>`;
  });
}

window.addEventListener("load", function(){
currentStep = 0;
    selectedItems = {};
    cart.length = 0; // Clear the cart array
    localStorage.removeItem("selectedItems");
    render();
})

// matchProductData(); // Uncomment if you want to show initial product matches
render();
startOver();

stepperNextBtn.addEventListener("click", () => {
  if (currentStep < stepperSteps.length - 1) {
    smoothStepTransition(() => {
      currentStep++;
      
              // Skip stroller steps (4-5) if Travel System was selected
        if (selectedItems.skipStrollerSteps && currentStep === 4) {
          currentStep = 7; // Jump to Review step
        }
        
        // Skip to review if no strollers are available after selecting stroller frame
        if (selectedItems.skipToReview && currentStep === 5) {
          currentStep = 7; // Jump to Review step
        }

        if (currentStep === 6) {
          const videoContainer = document.getElementById("loading-video");
          videoContainer.style.display = "flex";

          setTimeout(() => {
            videoContainer.style.display = "none";
            currentStep = 7;
            render();
          }, 4000);
          return;
        } 


      render();
      
      // Handle Car Seat Color step
      if(stepperSteps[currentStep]?.title === "Choose Your Car Seat Color"){
        matchProductData();
        render();
      }
    });
  }
});

stepperPreviousBtn.addEventListener("click", () => {
  if (currentStep > 0) {
    smoothStepTransition(() => {
      currentStep--;
      render();
    });
  }
});

function stepperEdit(step) {
  smoothStepTransition(() => {
    currentStep = step;
    render();
  });
}


    </script>


