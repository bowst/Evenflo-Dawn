let swiperSliderActive = false;
let stepperLoader = true;
const cart = [];


let hideStepSixEditPencil = false;
let hideThreeStepEditPencil = false;

const stepperNextBtn = document.querySelector(".next-btn");
const stepperPreviousBtn = document.querySelector(".previous-btn");
const startOverBtn = document.querySelector(".start-over");
const buttonWrapper = document.querySelector(".product-stepper-btn-wrapper");
const productSidebar = document.querySelector(".product-sidebar");
const productStepperWrapper = document.querySelector(".product-stepper-wrapper");
const productStepper = document.querySelector(".product-stepper");
let totalAmount = 0;

let isMobile = /Mobi|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
    navigator.userAgent
  );


window.addEventListener("resize", handleResize);
window.addEventListener("load", resetStepper);
startOverBtn.addEventListener("click", startOver);
stepperNextBtn.addEventListener("click", handleNextStep);
stepperPreviousBtn.addEventListener("click", handlePreviousStep);
document.addEventListener("DOMContentLoaded", handleContentLoaded);

function videoLoader() {
  videoLoaderContent.classList.add("show-loading-video");
  productStepperWrapper.classList.add("showing-loading-video");
  setTimeout(() => {
    videoLoaderContent.classList.remove("show-loading-video"); 
	productStepperWrapper.classList.remove("showing-loading-video");
  }, 4000);

}

function handleResize(){
  console.log('Window resized to: ', window.innerWidth);
  if(window.innerWidth < 768){
    swiperSliderActive = true;
    isMobile = true;
    render();
  } 
  else {
    isMobile = false;
    swiperSliderActive = false; 
    render();
  }
}

// Helper function to update URL hash based on current step
function updateURLHash() {
  const stepNumber = currentStep + 1; // Convert 0-based to 1-based for marketing
  const newHash = `#step${stepNumber}`;
  
  // Update URL without triggering page reload
  if (window.location.hash !== newHash) {
    history.replaceState(null, null, newHash);
  }
}

function resetStepper(){
  currentStep = 0;
  selectedItems = {};
  cart.length = 0; // Clear the cart array
  localStorage.removeItem("selectedItems");
  
  // Reset pricing text
  document.querySelector(".buy-now").innerText = "Buy now for $";
  
  updateURLHash(); // Add hash update
  render();
  document.querySelector(".stepperLoader").classList.add("stepperLoader-show");
}

function startOver(){
  smoothStepTransition(() => {
    currentStep = 0;
    selectedItems = {};
    cart.length = 0; // Clear the cart array
    localStorage.removeItem("selectedItems");

    // Reset step content to original state
    stepperSteps[3].alternativeMessage = null;
    stepperSteps[5].alternativeMessage = null;
    stepperSteps[5].title = "Choose Your Stroller Color";

    // Reset pricing text
    document.querySelector(".buy-now").innerText = "Buy now for $";

    updateURLHash(); // Add hash update
    render();
    updateStepperButtons();
  });
}

function checkIfAccessoriesAvailable(cart) {
  if (cart?.length) {
    const hasAccessories = cart.some(
      item => item?.accessories?.length > 0
    );

    return hasAccessories;
  }

  return false;
}

function handleNextStep(){
  if (currentStep < stepperSteps.length - 1) {
    smoothStepTransition(() => {
      currentStep++;
      // Skip stroller steps (4-5) if Travel System was selected
      if (selectedItems.skipStrollerSteps && currentStep === 4) {

        if(checkIfAccessoriesAvailable(cart)) {
          currentStep=6;
          hideStepSixEditPencil = false
        }
        else currentStep = 7; // Jump to Review step
      }

      // Skip to review if no strollers are available after selecting stroller frame
      if (selectedItems.skipToReview && currentStep === 5) {
        currentStep = 7; // Jump to Review step
      }
      if (currentStep === 6) {
        renderAccessory();
      }
      if (currentStep === 7) {
        videoLoader();
      }
      updateURLHash(); // Add hash update
      render();
      if (stepperSteps[currentStep]?.title === "Choose Your Car Seat Color") {
        matchProductData();
        render();
      }
    });
  }
}

function handlePreviousStep(){
  if (currentStep > 0) {
    smoothStepTransition(() => {
      currentStep--;
      updateURLHash(); // Add hash update
      render();
    });
  }
}

function handleContentLoaded(){
  if(isMobile) {
      swiperSliderActive = true;
      render();
  }
  else{
    swiperSliderActive = false; 
    render();
  }

}

