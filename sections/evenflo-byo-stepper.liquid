} {% endcomment %}

function scrollToStepper() {
  const stepperSection = document.querySelector(".product-stepper");
  if (stepperSection) {
    const offset = isMobile ? 200 :  100; // pixels from top
    const elementTop = stepperSection.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({
      top: elementTop - offset,
      behavior: "smooth"
    });
  }
}


function render() {
  renderStepContent();
  renderStepSidebar();
}

function checkIfShowStroller(cart) {
  const hasTravelSystem = cart.some(
    (item) => item.productType === "Travel System"
  );
  const hasInfantCarSeat = cart.some(
    (item) => item.productType === "Infant Car Seat"
  );

  // If Travel System is selected, we should skip stroller steps
  if (hasTravelSystem) {
    return { skipStrollerSteps: true, reason: "Travel System selected" };
  }

  // If only Infant Car Seat is selected, continue with stroller steps
  if (hasInfantCarSeat) {
    return {
      skipStrollerSteps: false,
      reason: "Infant Car Seat selected - show stroller options",
    };
  }

  return { skipStrollerSteps: false, reason: "No relevant products in cart" };
}

function setActiveCard(passedItemIndex) {
  const step = stepperSteps[currentStep];
  const title = step.title;
  const item = step.item[passedItemIndex];

  // Store selection for this step
  selectedItems[currentStep] = { ...item };

  // ---- Helpers (scoped to this function) ----
  const isTitle = (t) => title === t;


  const upsertCartBy = (predicate, payload, { replace = false } = {}) => {
    const idx = cart.findIndex(predicate);
    if (idx > -1) {
      cart[idx] = replace ? payload : { ...cart[idx], ...payload };
    } else {
      cart.push(payload);
    }
  };
  
  const uniqueColorVariants = (products, imageKey = "byoColorImage") => {
    const seen = new Set();
    const out = [];
    for (const p of products) {
      for (const v of p.variants || []) {
        if (!seen.has(v.color)) {
          seen.add(v.color);
          out.push({
            ...v,
            label: v.color,
            image: v[imageKey] ?? v.colorImage,
            productData: p,
          });
        }
      }
    }
    return out;
  };

  if (!window.__variantProductIndex) {
    const map = new Map();
    for (const p of normalizedVariants) {
      for (const v of p.variants || []) map.set(v.variantId, p);
    }
    window.__variantProductIndex = map;
  }

  const saveSelectedItems = () => {
    try {
      localStorage.setItem("selectedItems", JSON.stringify(selectedItems));
    } catch {
      /* ignore */
    }
  };

  const toggleMultiSelectCardUI = () => {
    const cards = document.querySelectorAll(".product-stepper-card");
    cards.forEach((card, i) => {
      if (i === passedItemIndex) card.classList.toggle("selected");
    });

    const selectedCards = document.querySelectorAll(".product-stepper-card.accessory-card.swiper-slide.selected");
    if(selectedCards.length > 0){
          stepperNextBtn.disabled = false;
    stepperNextBtn.classList.remove("button-disabled");
    }
    else {
        stepperNextBtn.disabled = true;
    stepperNextBtn.classList.add("button-disabled");
  }


    updateNoExtraButton?.();
  };

  const setSingleSelectCardUI = () => {
    const cards = document.querySelectorAll(".product-stepper-card");
    cards.forEach((card, i) => {
      card.classList.toggle("selected", i === passedItemIndex);
    });
    stepperNextBtn.disabled = false;
    stepperNextBtn.classList.remove("button-disabled");
  };

  if (isTitle("Choose Your Car Seat Color")) {
    const selectedVariantId = item.variantId;
    const selectedColor = item.label;

    const selectedProduct =
      window.__variantProductIndex.get(selectedVariantId) ||
      normalizedVariants.find(
        (p) => Array.isArray(p.variants) && p.variants.some(v => v.variantId === selectedVariantId)
      );

    if (selectedProduct) {
      const matchedVariant = selectedProduct.variants.find(v => v.color === selectedColor);

      // Keep only one car-seat/travel-system type in cart (as original logic did)
      const idxSameType = cart.findIndex(ci => ci.productType === selectedProduct.productType);
      if (idxSameType > -1) {
        cart[idxSameType].variant = matchedVariant;
      } else {
        cart.length = 0; // original behavior: clear cart then add
        cart.push({ ...selectedProduct, variant: matchedVariant });
      }

      // Decide whether to skip stroller steps
      const { skipStrollerSteps } = checkIfShowStroller(cart);
      selectedItems.skipStrollerSteps = skipStrollerSteps;
    }

    setSingleSelectCardUI();
    saveSelectedItems();
    return;
  }

  if (isTitle("Choose Your Stroller Frame")) {
    const selectedStrollerType = item.label.includes("Intuiti+") ? "intuiti+" : "intuiti";
    selectedItems.selectedStrollerType = selectedStrollerType;

    const matching = strollers.filter(s => s.stroller === selectedStrollerType);

    if (matching.length) {
      stepperSteps[5].item = uniqueColorVariants(matching);
      stepperSteps[5].title = "Choose Your Stroller Color";
      stepperSteps[5].alternativeMessage = null;
    } else {
      const alternativeType = selectedStrollerType === "intuiti+" ? "intuiti" : "intuiti+";
      const alt = strollers.filter(s => s.stroller === alternativeType);

      if (alt.length) {
        const selectedTypeName = selectedStrollerType === "intuiti+" ? "Intuiti+" : "Intuiti";
        const alternativeTypeName = alternativeType === "intuiti+" ? "Intuiti+" : "Intuiti";

        stepperSteps[5].title = "Choose Your Stroller Color";
        stepperSteps[5].alternativeMessage =
          `Sorry, there are no ${selectedTypeName} strollers available. Would you like to buy a ${alternativeTypeName} stroller instead?`;
        stepperSteps[5].item = uniqueColorVariants(alt);
        selectedItems.selectedStrollerType = alternativeType;
      } else {
        selectedItems.skipToReview = true;
        stepperSteps[5].item = [];
        stepperSteps[5].alternativeMessage = "Sorry, no strollers are available at this time.";
      }
    }

    setSingleSelectCardUI();
    saveSelectedItems();
    return;
  }

if (isTitle("Choose Your Stroller Color")) {
  const selectedStrollerProduct = item.productData;
  if (selectedStrollerProduct) {
    const matched = selectedStrollerProduct.variants.find(v => v.color === item.label);
    if(matched.byoColorImage === null){
      matched.colorImage = "https://www.svgrepo.com/show/508699/landscape-placeholder.svg"
    }
    // Normalize type check just in case
    const isStroller =
      (selectedStrollerProduct.productType || "").toLowerCase() === "stroller";

    // Always REPLACE the existing stroller slot (if any)
    upsertCartBy(
      c => (c.productType || "").toLowerCase() === "stroller",
      { ...selectedStrollerProduct, variant: matched },
      { replace: isStroller } // replace when it's a stroller
    );
  }

  setSingleSelectCardUI();
  saveSelectedItems();
  return;
}

  if (currentStep === 6 && isTitle("Add Accessories (Optional)")) {
    const label = item.label;

    selectedItems.accessories ??= [];

    const idx = selectedItems.accessories.findIndex(a => a.label === label);
    if (idx > -1) {
      selectedItems.accessories.splice(idx, 1);
    } else {
      selectedItems.accessories.push({ ...item, selected: true });
    }

    let matchedAccessory = null;
    for (const ci of cart) {
      const found = ci.accessories?.find(a => a.accessoryProductTitle === label);
      if (found) {
        matchedAccessory = found;
        break;
      }
    }

    if (matchedAccessory) {
      const existingIdx = cart.findIndex(
        c => c.productId === matchedAccessory.accessoryProductId
      );
      const isSelectedNow = selectedItems.accessories.some(a => a.label === label);

      if (existingIdx > -1 && !isSelectedNow) {
        cart.splice(existingIdx, 1);
      } else if (existingIdx === -1 && isSelectedNow) {
        cart.push({
          productId: matchedAccessory.accessoryProductId,
          productTitle: matchedAccessory.accessoryProductTitle,
          productType: "Accessory",
          accessories: [],
          variants: [{
            variantId: matchedAccessory.accessoryVariantId,
            color: matchedAccessory.color,
            colorImage: matchedAccessory.colorImage,
            sku: matchedAccessory.sku,
            inventory: matchedAccessory.inventory,
            inStock: matchedAccessory.inStock
          }],
          variant: {
            variantId: matchedAccessory.accessoryVariantId,
            color: matchedAccessory.color,
            colorImage: matchedAccessory.colorImage,
            sku: matchedAccessory.sku,
            inventory: matchedAccessory.inventory,
            inStock: matchedAccessory.inStock,
            byoTitle: matchedAccessory.byoTitle,
            byoSubTitle:matchedAccessory.byoSubTitle,
            featureImage:matchedAccessory.featureImage,
            price: matchedAccessory.price
          },
          description: matchedAccessory.accessoryProductDescription,
          image: matchedAccessory.accessoryProductImage
        });
      }
    } else {
      console.log("Could not find matching accessory data for:", label);
    }

    toggleMultiSelectCardUI();
    saveSelectedItems();
    return;
  }

  setSingleSelectCardUI();
  saveSelectedItems();
}

function updateNoExtraButton() {
  const noExtraBtn = document.querySelector(".no-extra-needed");
  const accessorySelectedCards = document.querySelectorAll(".product-stepper-card.accessory-card.selected");

  console.log("noExtraBtn", noExtraBtn, accessorySelectedCards);

  if (noExtraBtn && stepperSteps[currentStep]?.title === "Add Accessories (Optional)") {
    if (accessorySelectedCards.length > 0) {
      noExtraBtn.disabled = true;
      noExtraBtn.classList.add("no-extra-needed-disable");
    } else {
      noExtraBtn.disabled = false;
      noExtraBtn.classList.remove("no-extra-needed-disable");
    }
  }
}

function renderAccessory() {
  const accessoryStepIndex = stepperSteps.findIndex(
    (step) => step.title === "Add Accessories (Optional)"
  );
  const currentStepObj = stepperSteps[accessoryStepIndex];
  console.log("cart for assor", cart, accessoryStepIndex);
  // Check if cart exists and has items
  if (cart?.length) {
    const hasAccessories = checkIfAccessoriesAvailable(cart)

    // If no accessories found, skip to step 7
    if (!hasAccessories) {
      currentStep = 7;
      hideStepSixEditPencil = true;
      updateURLHash(); // Add hash update
      console.log("No accessories available, skipping to step 7");
      return;
    }

    // If accessories exist, process them
    cart.map((items) => {
      if (!currentStepObj || !items?.accessories?.length) {
        return;
      }

      const accessories = items.accessories;

      // Map each accessory into the step content
      const accessoryCards = accessories.map((accessory) => ({
        selected: false,
        label: accessory.accessoryProductTitle,
        description: accessory.accessoryProductDescription,
        image: accessory.accessoryProductImage,
      }));

      stepperSteps[accessoryStepIndex] = {
        ...currentStepObj,
        item: accessoryCards,
      };
    });
  } else {
    // If cart is empty, also skip to step 7
    currentStep = 7;
    updateURLHash(); // Add hash update
    console.log("Cart is empty, skipping to step 7");
  }
}

function matchProductData() {
  let selectedState = selectedItems && Object.keys(selectedItems).length
    ? selectedItems
    : (JSON.parse(localStorage.getItem("selectedItems")) || {});

  const selectedValues = Object.values(selectedState);

  const pick = (key) => {
    const found = selectedValues.find(o => o && Object.prototype.hasOwnProperty.call(o, key));
    return found ? found[key] : undefined;
  };

  const selected = {
    rotation: pick("rotation"),
    fabric: pick("fabric"),    
    sensorysoothe: pick("sensorysoothe")
  };

  const uniqueVariants = (products) => {
    const seen = new Set();
    const out = [];
    for (const p of products) {
      for (const v of p.variants || []) {
        if (!seen.has(v.color)) {
          seen.add(v.color);
          out.push({ ...v, label: v.color, image: v.colorImage });
        }
      }
    }
    return out;
  };

  const filterBy = (pred) => travelSystemsInfantCarSeat.filter(pred);

  if ([selected.rotation, selected.fabric, selected.sensorysoothe].every(v => v == null)) {
    const any = filterBy(p => (p.variants?.length ?? 0) > 0);
    stepperSteps[3].item = uniqueVariants(any);
    stepperSteps[3].alternativeMessage = null;
    return;
  }

  const exact = filterBy(p =>
    p.rotation === selected.rotation &&
    p.fabric === selected.fabric &&
    p.sensorysoothe === selected.sensorysoothe
  );
  if (exact.length) {
    stepperSteps[3].item = uniqueVariants(exact);
    stepperSteps[3].alternativeMessage = null;
    return;
  }

  let alternatives = [];
  let altMessage = "";

  alternatives = filterBy(p =>
    p.rotation === selected.rotation &&
    p.fabric === selected.fabric
  );
  if (alternatives.length) {
    const handleType = selected.sensorysoothe === 1 ? "SensorySoothe" : "Traditional";
    const availableHandle = selected.sensorysoothe === 1 ? "Traditional" : "SensorySoothe";
    altMessage = `Your selected combination with ${handleType} handle is not available. Here are similar options with ${availableHandle} handle:`;
  } else {
    alternatives = filterBy(p =>
      p.rotation === selected.rotation &&
      p.sensorysoothe === selected.sensorysoothe
    );
    if (alternatives.length) {
      const fabricType = selected.fabric === 1 ? "Green & Gentle™" : "Classic";
      const availableFabric = selected.fabric === 1 ? "Classic" : "Green & Gentle™";
      altMessage = `Your selected combination with ${fabricType} fabric is not available. Here are similar options with ${availableFabric} fabric:`;
    } else {
      alternatives = filterBy(p =>
        p.fabric === selected.fabric &&
        p.sensorysoothe === selected.sensorysoothe
      );
      if (alternatives.length) {
        const baseType = selected.rotation === 1 ? "Rotational" : "Traditional";
        const availableBase = selected.rotation === 1 ? "Traditional" : "Rotational";
        altMessage = `Your selected combination with ${baseType} base is not available. Here are similar options with ${availableBase} base:`;
      } else {
        alternatives = filterBy(p => p.rotation === selected.rotation);
        if (alternatives.length) {
          altMessage = `Your exact combination is not available. Here are available options with the same car seat base:`;
        } else {
          alternatives = filterBy(p => (p.variants?.length ?? 0) > 0);
          altMessage = `Your selected combination is not available. Here are other available options:`;
        }
      }
    }
  }

  stepperSteps[3].item = uniqueVariants(alternatives);
  stepperSteps[3].alternativeMessage = altMessage;
}

function productCartFunction() {
  return cart.map(item => ({
    variantId: item.variant?.variantId,
    quantity: 1,
    productTitle: item.productTitle,
    productType: item.productType,
    color: item.variant?.color
  }));
}

function addToCart() {
  const finalCartItems = productCartFunction();
  if (!finalCartItems.length) return alert("No items to add to cart");
  sendToShopify(finalCartItems, "/cart");
}

function sendToShopify(items, redirectUrl) {
  fetch("/cart/add.js", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      items: items
        .filter(i => i.variantId)
        .map(i => ({ id: i.variantId, quantity: i.quantity }))
    })
  })
    .then(res => res.json())
    .then(() => {
      selectedItems = {};
      localStorage.removeItem("selectedItems");
      window.location.href = redirectUrl;
    })
    .catch(err => {
      console.error("Error:", err);
      alert("Error processing your order. Please try again.");
    });
}

