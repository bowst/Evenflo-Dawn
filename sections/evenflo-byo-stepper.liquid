{{ 'swiper-style.css' | asset_url | stylesheet_tag }}

<style>
.swiper {
      width: 100%;
      height: 100%;
  }
  
  .swiper-slide {
      text-align: center;
      font-size: 18px;
      background: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
  }
  
  .swiper-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;}
/* Smooth sliding step transitions */
.product-stepper {
  {% comment %} position: relative; {% endcomment %}
  {% comment %} min-height: 400px; {% endcomment %}
  {% comment %} overflow: hidden; {% endcomment %}
}

.product-stepper__item {
  transition: all 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
  transform: translateY(0);
  opacity: 1;
}

.product-stepper.transitioning .product-stepper__item {
  transform: translateY(30px);
  opacity: 0;
}

/* Smooth alternative message fade-in */
.alternative-message {
  animation: fadeInMessage 0.4s ease-out;
}

@keyframes fadeInMessage {
  from {
    opacity: 0;
    transform: translateY(-5px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Subtle card entrance animation */
.product-stepper-card {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.6s ease-out forwards;
}

.product-stepper-card:nth-child(1) { animation-delay: 0.1s; }
.product-stepper-card:nth-child(2) { animation-delay: 0.2s; }
.product-stepper-card:nth-child(3) { animation-delay: 0.3s; }
.product-stepper-card:nth-child(4) { animation-delay: 0.4s; }

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>
