{% assign products_to_show = section.settings.popularQuestionRange %}

<div class="popular-question-block" 
     id="popularQuestionBlock" 
     data-faqs-to-show="{{ products_to_show }}">
  <div class="popular-content-wrapper page-width">
    <div class="heading center">
      <h2>{{ section.settings.popularQuestionTitle }}</h2>
    </div>
    <div class="popular-card-wrapper" id="popularCards"></div>
  </div>
</div>

<style>
  /* layout: flex-wrap for cards */
  .popular-card-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    min-height: 470px;
  }

  /* real card sizing so they’re never hidden */
  .popular-card {
    width: 504px;
    box-sizing: border-box;
    margin-bottom: 1rem;
  }

  /* skeleton placeholder */
  .popular-card.skeleton {
    height: 460px;
    background: #f1f2f3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .popular-card.skeleton .skeleton-title {
    width: 60%;
    height: 1.5em;
    background: #e0e0e0;
    margin-bottom: 1rem;
  }
  .popular-card.skeleton .skeleton-content {
    flex: 1;
    background: #e0e0e0;
    border-radius: 4px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('popularCards');
    if (!wrapper) return console.error('popularCards container missing');

    const max = 3;
    const wanted = Number(
      document.getElementById('popularQuestionBlock')
        .dataset.faqsToShow
    ) || max;
    const toShow = Math.min(wanted, max);

    // 1) inject skeletons
    let skeletonHTML = '';
    for (let i = 0; i < toShow; i++) {
      skeletonHTML += `
        <div class="popular-card skeleton">
          <div class="skeleton-title"></div>
          <div class="skeleton-content"></div>
        </div>`;
    }
    wrapper.innerHTML = skeletonHTML;

    // 2) fetch real FAQs
    fetch(`${evenFloFAQURL}faqs/getFilteredFaqs?popular=true&page=1`)
      .then(res => res.json())
      .then(data => {
        // clear skeletons
        wrapper.innerHTML = '';

        // render up to `toShow` real cards
        const faqsToRender = (data.results || []).slice(0, toShow);
        faqsToRender.forEach(item => {
          const card = document.createElement('div');
          card.className = 'popular-card';
          card.innerHTML = setFAQBlockInnerHtml(
            item.topic?.name || '',
            item.question,
            getFAQContent(item.products || []),
            item.answer,
            '',
            getTagsHtml(getTagsArray(item.tags || []))
          );
          wrapper.appendChild(card);
        });

        // 3) build and inject JSON-LD schema
        const faqLd = {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": faqsToRender.map(item => ({
            "@type": "Question",
            "name": item.question,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": item.answer
            }
          }))
        };
        const ldScript = document.createElement('script');
        ldScript.type = 'application/ld+json';
        ldScript.text = JSON.stringify(faqLd, null, 2);
        document.head.appendChild(ldScript);
      })
      .catch(err => {
        console.error('Error loading popular FAQs:', err);
      });
  });

  // re-run on Shopify section load (when theme editor refreshes just that block)
  document.addEventListener('shopify:section:load', (event) => {
    if (event.detail.sectionId.includes('evenflo_faq_popular_question')) {
      document.dispatchEvent(new Event('DOMContentLoaded'));
    }
  });
</script>

{% schema %}
{
  "name": "EvenFlo FAQ Popular",
  "tag": "section",
  "class": "popularQuestion",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "popularQuestionTitle",
      "label": "Popular Question Title",
      "default": "Popular Questions"
    },
    {
      "type": "range",
      "id": "popularQuestionRange",
      "label": "Number of questions to show",
      "default": 3,
      "min": 1,
      "max": 3,
      "step": 1
    }
  ],
  "presets": [{ "name": "EvenFlo FAQ Popular", "blocks": [] }]
}
{% endschema %}
