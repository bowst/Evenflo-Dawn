{{ 'section-evenflo-collection-detail.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Only Product-related FAQ section: skeleton CSS + JS + schema
{%- endcomment -%}
<style>
  /* ------------------------------------
     Your existing overrides
  ------------------------------------ */
  .help-articles-block {
    background: #fff;
  }

  .search-listing-header2 {
    display: flex;
    justify-content: space-between;
  }

  /* ------------------------------------
     Skeleton layout for popular cards
  ------------------------------------ */
  .popular-card-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    min-height: 470px;
  }

  .popular-card.skeleton {
    width: 584;
    height: 470px;
    background: #f1f2f3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .popular-card.skeleton .skeleton-title {
    width: 60%;
    height: 1.5em;
    background: #e0e0e0;
    margin-bottom: 1rem;
  }

  .popular-card.skeleton .skeleton-content {
    flex: 1;
    background: #e0e0e0;
    border-radius: 4px;
  }

  /* Hide the heading by default; JS will reveal it if FAQs exist */
  #popularQuestionHeading {
    display: none;
  }
</style>

{%- comment -%}
  We no longer use a range setting—this will always inject 20 skeleton cards.
{%- endcomment -%}

<div class="help-articles-block">
  <div class="help-articles-content page-width center">
    <div class="help-article-search-wrapper">
      <h1 id="productName"></h1>
      <p id="productDescription"></p>
      <div class="help-article-link-wrapper" id="productLinks"></div>
    </div>
  </div>
</div>

<div class="product-page-wrapper">
  <div
    class="popular-question-block"
    id="productRelatedBlock"
    data-faqs-to-show="20"  <!-- ALWAYS 20 skeletons -->
  >
    <div class="popular-content-wrapper page-width">
      <div class="heading center">
        <h2 id="popularQuestionHeading">
          {{ section.settings.productRelatedTitle }}
        </h2>
      </div>
      <div class="popular-card-wrapper" id="popularCards"></div>
    </div>
  </div>
</div>

{% render 'faq-related-part-block' %}
{% render 'faq-load-more-block', show_topic_dropdown: true %}

<script>
  function fetchPopularProductsRelatedData(productID) {
    const container = document.getElementById("popularCards");
    const heading = document.getElementById("popularQuestionHeading");
    const blocksToShow = parseInt(
      document.getElementById("productRelatedBlock").dataset.faqsToShow,
      10
    );

    if (!container) {
      console.error("Popular cards container not found");
      return;
    }

    // 1) Inject exactly 20 skeleton placeholders and record start time
    const startTime = Date.now();
    let skeletonHTML = "";
    for (let i = 0; i < blocksToShow; i++) {
      skeletonHTML += `
        <div class="popular-card skeleton">
          <div class="skeleton-title"></div>
          <div class="skeleton-content"></div>
        </div>`;
    }
    container.innerHTML = skeletonHTML;

    const url = evenFloFAQURL + "products/" + productID;

    fetch(url)
      .then((response) => response.json())
      .then((data) => {
        if (data?.detail && containsString(data.detail, errorString())) {
          redirectIfNoData([]);
          return;
        }

        // Fire other related data fetches
        getProductsPartsByProductID(productID);
        fetchFAQsByFilters({ productID: productID });
        fetchTopicsByType(productID, true);

        // Populate product info
        document.getElementById("productName").innerText = data?.name || "";
        getBreadCrumbLinks(data?.name, "product");
        document.getElementById("productDescription").innerText =
          data?.description || "";

        // Build links (if present)
        const productLinks = document.getElementById("productLinks");
        let linksHtml = "";
        if (data?.shopify_page_handel) {
          linksHtml += `<a href="/products/${data.shopify_page_handel}">Product Guide</a> | `;
        }
        if (data?.english_manual_url) {
          linksHtml += `<a href="${data.english_manual_url}">Manual EN</a> | `;
        }
        if (data?.spanish_manual_url) {
          linksHtml += `<a href="${data.spanish_manual_url}">Manual ES</a> | `;
        }
        if (data?.french_manual_url) {
          linksHtml += `<a href="${data.french_manual_url}">Manual FR</a> | `;
        }
        if (data?.warranty_certificate) {
          linksHtml += `<a href="${data.warranty_certificate}">Warranty</a>`;
        }
        productLinks.innerHTML = linksHtml;

        // Show or hide the heading depending on FAQ count
        const faqs = Array.isArray(data?.related_popular_faqs)
          ? data.related_popular_faqs
          : [];
        if (faqs.length > 0) {
          heading.style.display = ""; // show it (block)
        } else {
          heading.style.display = "none";
        }

        // Calculate elapsed time and enforce a 500ms minimum skeleton display
        const elapsed = Date.now() - startTime;
        const minDisplay = 500; // minimum time (ms) to show skeleton
        const delay = Math.max(0, minDisplay - elapsed);

        setTimeout(() => {
          // 2) Remove skeletons
          container.innerHTML = "";

          // 3) Render actual FAQ cards (up to 20)
          const faqSchemaData = {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [],
          };

          faqs.slice(0, blocksToShow).forEach((item) => {
            const popularCard = createPopularCardDivElement("popular-card");
            const faqsContent = getFAQContent(item.products || []);
            const tagsArray = getTagsArray(item.tags || []);
            const tagsHtml = getTagsHtml(tagsArray);

            popularCard.innerHTML = setFAQBlockInnerHtml(
              item.topic?.name || "",
              item.question,
              faqsContent,
              item.answer,
              item.id,
              tagsHtml
            );
            container.appendChild(popularCard);

            // Build JSON-LD
            faqSchemaData.mainEntity.push({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: {
                "@type": "Answer",
                text: item.answer,
              },
            });
          });

          // 4) Inject JSON-LD script
          const scriptTag = document.createElement("script");
          scriptTag.type = "application/ld+json";
          scriptTag.innerHTML = JSON.stringify(faqSchemaData);
          document.head.appendChild(scriptTag);
        }, delay);
      })
      .catch((error) => {
        console.error("Error fetching product FAQs:", error);
        redirectIfNoData([]);
      });
  }

  document.addEventListener("DOMContentLoaded", () => {
    const block = document.getElementById("productRelatedBlock");
    if (!block) return;

    const pid = new URLSearchParams(window.location.search).get("pid");
    if (pid) {
      fetchPopularProductsRelatedData(pid);

      // If a filter-change helper exists, call it:
      if (typeof getFilterValuesAndCallFunc === "function") {
        getFilterValuesAndCallFunc();
      }
    } else {
      redirectIfNoData([]);
    }
  });
</script>

{% schema %}
{
  "name": "EvenFlo FAQ ProdRel",
  "tag": "section",
  "class": "productRelated",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "productRelatedTitle",
      "label": "Popular Question Title",
      "default": "Popular Questions"
    }
  ],
  "presets": [
    {
      "name": "EvenFlo FAQ ProdRel",
      "blocks": []
    }
  ]
}
{% endschema %}
