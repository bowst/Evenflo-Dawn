{{ 'section-evenflo-collection-detail.css' | asset_url | stylesheet_tag }}

<style>
  .help-articles-block {
    background: #fff;
  }

  .search-listing-header2 {
    display: flex;
    justify-content: space-between;
  }

  /* Skeleton styles */
  .popular-card-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    min-height: 470px;
  }

  /* Skeleton for popular card */
  .popular-card.skeleton {
    width: 504px;
    height: 460px;
    background: #f1f2f3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .popular-card.skeleton .skeleton-title {
    width: 60%;
    height: 1.5em;
    background: #e0e0e0;
    margin-bottom: 1rem;
  }

  .popular-card.skeleton .skeleton-content {
    flex: 1;
    background: #e0e0e0;
    border-radius: 4px;
  }
</style>

{% assign products_to_show = section.settings.productRelatedRange %}

<div class="help-articles-block">
  <div class="help-articles-content page-width center">
    <div class="help-article-search-wrapper">
      <h1 id="productName"></h1>
      <p id="productDescription"></p>
      <div class="help-article-link-wrapper" id="productLinks"></div>
    </div>
  </div>
</div>

<div class="product-page-wrapper">
  <!-- Popular Questions Section -->
  <div class="popular-question-block" id="productRelatedBlock" data-faqs-to-show="3">
    <div class="popular-content-wrapper page-width">
      <div class="heading center">
        <h2 id="popularQuestionHeading">{{ section.settings.productRelatedTitle }}</h2>
      </div>
      <div class="popular-card-wrapper" id="popularCards"></div>
      <button id="loadMoreBtn">Load More</button> <!-- Load More Button -->
    </div>
  </div>

  <!-- Section for additional FAQ content -->
  <div class="popular-question-block" id="additionalFaqsSection" style="display:none;">
    <div class="popular-content-wrapper page-width">
      <div class="heading center">
        <h2>More Popular Questions</h2>
      </div>
      <div class="popular-card-wrapper" id="additionalCards"></div>
    </div>
  </div>
</div>

{% render 'faq-related-part-block' %}
{% render 'faq-load-more-block', show_topic_dropdown: true %}

<script>
  // Function to fetch FAQs and handle pagination
  let currentPage = 1; // Start on page 1
  const faqsPerPage = 3;
  const faqsPerLoadMore = 23;

  // Fetch the initial popular FAQs
  function fetchPopularProductsRelatedData(productID, page = 1) {
    const container = document.getElementById("popularCards");
    const loadMoreContainer = document.getElementById("additionalCards");
    const loadMoreButton = document.getElementById("loadMoreBtn");
    
    if (!container) {
      console.log("Error on getting container");
      return;
    }

    // Inject skeleton loader for 3 FAQs initially
    let skeletonHTML = '';
    for (let i = 0; i < faqsPerPage; i++) {
      skeletonHTML += `
        <div class="popular-card skeleton">
          <div class="skeleton-title"></div>
          <div class="skeleton-content"></div>
        </div>`;
    }
    container.innerHTML = skeletonHTML;

    let url = `${evenFloFAQURL}products/${productID}?page=${page}&limit=${faqsPerPage}`;

    fetch(url)
      .then((response) => response.json())
      .then((data) => {
        if (data?.detail && containsString(data?.detail, errorString())) {
          redirectIfNoData([]);
          return "";
        }

        document.getElementById('productName').innerHTML = data?.name;
        getBreadCrumbLinks(data?.name, 'product');
        document.getElementById('productDescription').innerHTML = data?.description;

        const productLinks = document.getElementById('productLinks');
        let linksHtml = ``;

        if (data?.shopify_page_handel) {
          linksHtml += `<a href="/products/${data.shopify_page_handel}">Product Guide </a> | `;
        }

        if (data?.english_manual_url) {
          linksHtml += `<a href="${data.english_manual_url}">Manual EN</a>`;
        }

        if (data?.spanish_manual_url) {
          linksHtml += `<a href="${data.spanish_manual_url}">Manual ES</a>`;
        }

        if (data?.french_manual_url) {
          linksHtml += `<a href="${data.french_manual_url}">Manual FR</a>`;
        }

        if (data?.warranty_certificate) {
          linksHtml += ` | <a href="${data.warranty_certificate}">Warranty</a>`;
        }

        productLinks.innerHTML = linksHtml;
        
        // Render popular questions
        container.innerHTML = ''; // Clear skeletons
        data?.related_popular_faqs?.slice(0, faqsPerPage).forEach((product) => {
          const popularCard = createPopularCardDivElement("popular-card");

          const faqsContent = getFAQContent(product?.products || []);
          const tags = getTagsArray(product?.tags || []);
          const tagsHtml = getTagsHtml(tags);

          popularCard.innerHTML = setFAQBlockInnerHtml(
            product?.topic?.name || "",
            product.question,
            faqsContent,
            product.answer,
            product?.id,
            tagsHtml
          );

          container.appendChild(popularCard);
        });

        // Show Load More button if more FAQs are available
        if (data?.related_popular_faqs?.length > faqsPerPage) {
          loadMoreButton.style.display = 'block';
        } else {
          loadMoreButton.style.display = 'none';
        }
      })
      .catch((error) => {
        console.error("Error fetching products:", error);
        redirectIfNoData([]);
      });
  }

  // Load more FAQs when the button is clicked
  document.getElementById("loadMoreBtn").addEventListener("click", () => {
    currentPage++;
    fetchPopularProductsRelatedData(productID, currentPage);

    // Show the next section of 23 FAQs
    document.getElementById('additionalFaqsSection').style.display = 'block';
    const loadMoreContainer = document.getElementById("additionalCards");
    let skeletonHTML = '';
    for (let i = 0; i < faqsPerLoadMore; i++) {
      skeletonHTML += `
        <div class="popular-card skeleton">
          <div class="skeleton-title"></div>
          <div class="skeleton-content"></div>
        </div>`;
    }
    loadMoreContainer.innerHTML = skeletonHTML;
    
    // Fetch additional FAQs
    fetch(`${evenFloFAQURL}products/${productID}?page=${currentPage}&limit=${faqsPerLoadMore}`)
      .then((response) => response.json())
      .then((data) => {
        loadMoreContainer.innerHTML = ''; // Clear skeletons
        data?.related_popular_faqs?.slice(0, faqsPerLoadMore).forEach((product) => {
          const popularCard = createPopularCardDivElement("popular-card");

          const faqsContent = getFAQContent(product?.products || []);
          const tags = getTagsArray(product?.tags || []);
          const tagsHtml = getTagsHtml(tags);

          popularCard.innerHTML = setFAQBlockInnerHtml(
            product?.topic?.name || "",
            product.question,
            faqsContent,
            product.answer,
            product?.id,
            tagsHtml
          );

          loadMoreContainer.appendChild(popularCard);
        });
      })
      .catch((error) => {
        console.error("Error fetching additional FAQs:", error);
      });
  });

  // Initialize the FAQ section on page load
  document.addEventListener('DOMContentLoaded', () => {
    const queryString = window.location.search;
    const urlParams = new URLSearchParams(queryString);
    if (urlParams.has('pid')) {
      const productID = urlParams.get('pid');
      fetchPopularProductsRelatedData(productID);
    } else {
      redirectIfNoData([]);
    }
  });
</script>

{% schema %}
{
  "name": "EvenFlo FAQ ProdRel",
  "tag": "section",
  "class": "productRelated",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "productRelatedTitle",
      "label": "Popular Question Title",
      "default": "Popular Questions"
    },
    {
      "type": "range",
      "id": "productRelatedRange",
      "label": "Number of questions to show",
      "default": 3,
      "min": 1,
      "max": 3,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "EvenFlo FAQ ProdRel",
      "blocks": []
    }
  ]
}
{% endschema %}
