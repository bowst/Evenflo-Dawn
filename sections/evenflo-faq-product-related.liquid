{{ 'section-evenflo-collection-detail.css' | asset_url | stylesheet_tag }}

<style>
  .help-articles-block { background: #fff; }
  .search-listing-header2 { display: flex; justify-content: space-between; }

  /* ── CARD SKELETON ───────────────────────────────── */
  .popular-card-wrapper {
    display: flex; flex-wrap: wrap; gap: 1rem; min-height: 470px;
  }
  .popular-card.skeleton {
    width: 504px; height: 525px;
    background: #f1f2f3;
    display: flex; flex-direction: column; justify-content: space-between;
    margin-bottom: 1rem;
    position: relative; overflow: hidden;
  }
  .popular-card.skeleton::after {
    content: '';
    position: absolute; top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(
      90deg,
      rgba(255,255,255,0)   0%,
      rgba(255,255,255,0.6) 50%,
      rgba(255,255,255,0)   100%
    );
    animation: skeleton-loading 1.5s infinite;
  }

  /* ── HEADING SKELETON ───────────────────────────── */
  .skeleton-heading {
    width: 40%; height: 1.5em;
    background: #e0e0e0; border-radius: 4px;
    position: relative; overflow: hidden;
    margin-bottom: 1rem;
  }
  .skeleton-heading::after {
    content: '';
    position: absolute; top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(
      90deg,
      rgba(255,255,255,0)   0%,
      rgba(255,255,255,0.6) 50%,
      rgba(255,255,255,0)   100%
    );
    animation: skeleton-loading 1.5s infinite;
  }

  @keyframes skeleton-loading {
    0%   { left: -100%; }
    100% { left: 100%; }
  }
</style>

{% assign products_to_show = section.settings.productRelatedRange %}

<div class="help-articles-block">
  <div class="help-articles-content page-width center">
    <div class="help-article-search-wrapper">
      <h1 id="productName"></h1>
      <p id="productDescription"></p>
      <div id="productLinks" class="help-article-link-wrapper"></div>
    </div>
  </div>
</div>

<div class="product-page-wrapper">
  <div
    id="productRelatedBlock"
    class="popular-question-block"
    data-faqs-to-show="{{ products_to_show }}"
  >
    <div class="popular-content-wrapper page-width">
      <div class="heading center">
        <h2 id="popularQuestionHeading">{{ section.settings.productRelatedTitle }}</h2>
      </div>
      <div id="popularCards" class="popular-card-wrapper"></div>
    </div>
  </div>
</div>

{% render 'faq-related-part-block' %}
{% render 'faq-load-more-block', show_topic_dropdown: true %}

<script>
  // ─── SKELETON HELPERS ────────────────────────────
  function createSkeletonCardDivElement() {
    const c = document.createElement('div');
    c.className = 'popular-card skeleton';
    c.innerHTML = `
      <div class="skeleton-title"></div>
      <div class="skeleton-content"></div>
    `;
    return c;
  }
  function appendSkeletons(container, count) {
    for (let i = 0; i < count; i++) container.appendChild(createSkeletonCardDivElement());
  }
  function removeSkeletons(container) {
    container.querySelectorAll('.popular-card.skeleton').forEach(el => el.remove());
  }

  // ─── FETCH + RENDER POPULAR FAQs ─────────────────
  function fetchPopularProductsRelatedData(productID) {
    const headingEl = document.getElementById('popularQuestionHeading');
    // swap in heading skeleton
    headingEl.dataset.text = headingEl.textContent;
    headingEl.textContent = '';
    headingEl.classList.add('skeleton-heading');

    const container = document.getElementById('popularCards');
    const count = +document
      .getElementById('productRelatedBlock')
      .dataset.faqsToShow;

    if (!container) return console.error('popularCards missing');

    // show card skeletons
    container.innerHTML = '';
    appendSkeletons(container, count);

    fetch(`${evenFloFAQURL}products/${productID}`)
      .then(r => r.json())
      .then(data => {
        if (data.detail && containsString(data.detail, errorString())) {
          redirectIfNoData([]);
          return;
        }

        // restore heading
        headingEl.classList.remove('skeleton-heading');
        headingEl.textContent = headingEl.dataset.text;

        // clear card skeletons
        removeSkeletons(container);

        // kick off related calls
        getProductsPartsByProductID(productID);
        fetchFAQsByFilters({ productID });
        fetchTopicsByType(productID, true);

        // fill product info
        document.getElementById('productName').textContent = data.name;
        getBreadCrumbLinks(data.name, 'product');
        document.getElementById('productDescription').textContent = data.description;

        let linksHtml = '';
        if (data.shopify_page_handel)   linksHtml += `<a href="/products/${data.shopify_page_handel}">Product Guide</a> | `;
        if (data.english_manual_url)    linksHtml += `<a href="${data.english_manual_url}">Manual EN</a>`;
        if (data.spanish_manual_url)    linksHtml += `<a href="${data.spanish_manual_url}">Manual ES</a>`;
        if (data.french_manual_url)     linksHtml += `<a href="${data.french_manual_url}">Manual FR</a>`;
        if (data.warranty_certificate)  linksHtml += ` | <a href="${data.warranty_certificate}">Warranty</a>`;
        document.getElementById('productLinks').innerHTML = linksHtml;

        // render cards & build FAQ schema
        const faqSchema = {
          "@context":"https://schema.org",
          "@type":"FAQPage",
          mainEntity: []
        };

        data.related_popular_faqs
          .slice(0, count)
          .forEach(prod => {
            const card = createPopularCardDivElement('popular-card');
            const faqs = getFAQContent(prod.products || []);
            const tags = getTagsHtml(getTagsArray(prod.tags || []));
            card.innerHTML = setFAQBlockInnerHtml(
              prod.topic?.name || '',
              prod.question,
              faqs,
              prod.answer,
              prod.id,
              tags
            );
            container.appendChild(card);

            faqSchema.mainEntity.push({
              "@type":"Question",
              name: prod.question,
              acceptedAnswer: {
                "@type":"Answer",
                text: prod.answer
              }
            });
          });

        // inject JSON-LD
        const s = document.createElement('script');
        s.type = 'application/ld+json';
        s.textContent = JSON.stringify(faqSchema);
        document.head.appendChild(s);
      })
      .catch(err => {
        console.error('Error fetching products:', err);
        redirectIfNoData([]);
      });
  }

  // ─── INITIALIZE BOTH SECTIONS ────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    const pid = new URLSearchParams(window.location.search).get('pid');
    if (pid) {
      fetchPopularProductsRelatedData(pid);
      if (typeof getFilterValuesAndCallFunc === 'function') {
        getFilterValuesAndCallFunc();
      }
    } else {
      redirectIfNoData([]);
    }
  });
</script>

{% schema %}
{  
  "name": "EvenFlo FAQ ProdRel",
  "tag": "section",
  "class": "productRelated",
  "disabled_on": { "groups": ["header","footer"] },
  "settings": [
    { "type":"text",  "id":"productRelatedTitle", "label":"Popular Question Title", "default":"Popular Questions" },
    { "type":"range", "id":"productRelatedRange", "label":"Number of questions to show", "default":3, "min":1, "max":3, "step":1 }
  ],
  "presets":[ { "name":"EvenFlo FAQ ProdRel","blocks":[] } ]
}
{% endschema %}
