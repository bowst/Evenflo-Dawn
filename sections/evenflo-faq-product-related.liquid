{{ 'section-evenflo-collection-detail.css' | asset_url | stylesheet_tag }}

<style>
  .help-articles-block {
    background: #fff;
  }

  .search-listing-header2 {
    display: flex;
    justify-content: space-between;
  }

  /* ---------------------------------------------------
     CARD SKELETON STYLES
     --------------------------------------------------- */
  .popular-card-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    min-height: 470px;
  }

  .popular-card.skeleton {
    width: 504px;
    height: 525px;
    background: #f1f2f3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin-bottom: 1rem;
    position: relative;
    overflow: hidden;
  }
  .popular-card.skeleton::after {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(
      90deg,
      rgba(255,255,255,0) 0%,
      rgba(255,255,255,0.6) 50%,
      rgba(255,255,255,0) 100%
    );
    animation: skeleton-loading 1.5s infinite;
  }
  .popular-card.skeleton .skeleton-title {
    width: 60%; height: 1.5em;
    background: #e0e0e0; margin-bottom: 1rem;
  }
  .popular-card.skeleton .skeleton-content {
    flex: 1; background: #e0e0e0; border-radius: 4px;
  }

  /* ---------------------------------------------------
     HEADING SKELETON STYLES
     --------------------------------------------------- */
  .skeleton-heading {
    width: 40%;
    height: 1.5em;
    background-color: #e0e0e0;
    border-radius: 4px;
    position: relative;
    overflow: hidden;
    margin-bottom: 1rem;
  }
  .skeleton-heading::after {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(
      90deg,
      rgba(255,255,255,0) 0%,
      rgba(255,255,255,0.6) 50%,
      rgba(255,255,255,0) 100%
    );
    animation: skeleton-loading 1.5s infinite;
  }

  @keyframes skeleton-loading {
    0%   { left: -100%; }
    100% { left: 100%; }
  }
</style>

{% assign products_to_show = section.settings.productRelatedRange %}

<div class="help-articles-block">
  <div class="help-articles-content page-width center">
    <div class="help-article-search-wrapper">
      <h1 id="productName"></h1>
      <p id="productDescription"></p>
      <div class="help-article-link-wrapper" id="productLinks"></div>
    </div>
  </div>
</div>

<div class="product-page-wrapper">
  <div
    class="popular-question-block"
    id="productRelatedBlock"
    data-faqs-to-show="{{ products_to_show }}"
  >
    <div class="popular-content-wrapper page-width">
      <div class="heading center">
        <!-- this H2 will get a skeleton while loading -->
        <h2 id="popularQuestionHeading">{{ section.settings.productRelatedTitle }}</h2>
      </div>
      <div class="popular-card-wrapper" id="popularCards"></div>
    </div>
  </div>
</div>

{% render 'faq-related-part-block' %}
{% render 'faq-load-more-block', show_topic_dropdown: true %}

<script>
  //
  // ─── SKELETON HELPERS ───────────────────────────────
  //
  function createSkeletonCardDivElement() {
    const card = document.createElement('div');
    card.className = 'popular-card skeleton';
    card.innerHTML = `
      <div class="skeleton-title"></div>
      <div class="skeleton-content"></div>
    `;
    return card;
  }

  function appendSkeletons(container, count) {
    for (let i = 0; i < count; i++) {
      container.appendChild(createSkeletonCardDivElement());
    }
  }

  function removeSkeletons(container) {
    container.querySelectorAll('.popular-card.skeleton').forEach(el => el.remove());
  }

  //
  // ─── FETCH & RENDER POPULAR FAQS ────────────────────
  //
  function fetchPopularProductsRelatedData(productID) {
    const headingEl = document.getElementById('popularQuestionHeading');
    // stash original text, inject heading–skeleton
    headingEl.dataset.originalText = headingEl.textContent;
    headingEl.textContent = '';
    headingEl.classList.add('skeleton-heading');

    const container = document.getElementById('popularCards');
    const blocksToShow = +document
      .getElementById('productRelatedBlock')
      .dataset.faqsToShow;

    if (!container) {
      console.error('popularCards container not found');
      return;
    }

    // clear & inject card skeletons
    container.innerHTML = '';
    appendSkeletons(container, blocksToShow);

    fetch(`${evenFloFAQURL}products/${productID}`)
      .then(res => res.json())
      .then(data => {
        if (data.detail && containsString(data.detail, errorString())) {
          redirectIfNoData([]);
          return;
        }

        // restore heading
        headingEl.classList.remove('skeleton-heading');
        headingEl.textContent = headingEl.dataset.originalText;

        // clear card skeletons
        removeSkeletons(container);

        // kick off related snippets
        getProductsPartsByProductID(productID);
        fetchFAQsByFilters({ productID });
        fetchTopicsByType(productID, true);

        // populate product info
        document.getElementById('productName').textContent = data.name;
        getBreadCrumbLinks(data.name, 'product');
        document.getElementById('productDescription').textContent = data.description;

        // build links
        let linksHtml = '';
        if (data.shopify_page_handel) {
          linksHtml += `<a href="/products/${data.shopify_page_handel}">Product Guide</a> | `;
        }
        if (data.english_manual_url)  linksHtml += `<a href="${data.english_manual_url}">Manual EN</a>`;
        if (data.spanish_manual_url)  linksHtml += `<a href="${data.spanish_manual_url}">Manual ES</a>`;
        if (data.french_manual_url)   linksHtml += `<a href="${data.french_manual_url}">Manual FR</a>`;
        if (data.warranty_certificate) {
          linksHtml += ` | <a href="${data.warranty_certificate}">Warranty</a>`;
        }
        document.getElementById('productLinks').innerHTML = linksHtml;

        // render the actual FAQ cards
        const faqSchemaData = {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: []
        };

        data.related_popular_faqs
          .slice(0, blocksToShow)
          .forEach(prod => {
            const card       = createPopularCardDivElement('popular-card');
            const faqsContent = getFAQContent(prod.products || []);
            const tagsHtml   = getTagsHtml(getTagsArray(prod.tags || []));

            card.innerHTML = setFAQBlockInnerHtml(
              prod.topic?.name || '',
              prod.question,
              faqsContent,
              prod.answer,
              prod.id,
              tagsHtml
            );
            container.appendChild(card);

            faqSchemaData.mainEntity.push({
              "@type": 'Question',
              name: prod.question,
              acceptedAnswer: {
                "@type": 'Answer',
                text: prod.answer
              }
            });
          });

        // inject JSON-LD
        const scriptTag = document.createElement('script');
        scriptTag.type = 'application/ld+json';
        scriptTag.textContent = JSON.stringify(faqSchemaData);
        document.head.appendChild(scriptTag);
      })
      .catch(err => {
        console.error('Error fetching products:', err);
        redirectIfNoData([]);
      });
  }

  //
  // ─── KICK EVERYTHING OFF ────────────────────────────
  //
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('pid')) {
      const pid = urlParams.get('pid');
      fetchPopularProductsRelatedData(pid);
      // also trigger the search/load-more snippet’s initial load
      if (typeof getFilterValuesAndCallFunc === 'function') {
        getFilterValuesAndCallFunc();
      }
    } else {
      redirectIfNoData([]);
    }
  });
</script>

{% schema %}
{
  "name": "EvenFlo FAQ ProdRel",
  "tag": "section",
  "class": "productRelated",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "productRelatedTitle",
      "label": "Popular Question Title",
      "default": "Popular Questions"
    },
    {
      "type": "range",
      "id": "productRelatedRange",
      "label": "Number of questions to show",
      "default": 3,
      "min": 1,
      "max": 3,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "EvenFlo FAQ ProdRel",
      "blocks": []
    }
  ]
}
{% endschema %}
