{% assign collections_to_show = section.settings.faqCollectionRange %}

<div class="collection-block">
  <div class="collection-main-wrapper page-width">
    <div class="heading">
      <h1>{{ section.settings.faqCollectionTitle }}</h1>
    </div>
    <div class="collection-wrapper" id="allCollections" data-collections-to-show="{{ collections_to_show }}"></div>
  </div>
</div>

<style>
  /* keep wrapper height steady while loading */
  .collection-wrapper.collection-loading {
    min-height: 300px;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* same skeleton style as your FAQ loader */
  .collection-wrapper.collection-loading .collection-card.skeleton {
    background: #f1f2f3;
    border-radius: 8px;
    padding: 10px;
    flex: 1 1 calc(33.333% - 1rem);
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }
  .collection-card.skeleton .skeleton-title {
    width: 60%;
    height: 1.2em;
    background: #e0e0e0;
    border-radius: 4px;
  }
  .collection-card.skeleton .skeleton-img {
    flex: 1;
    background: #e0e0e0;
    border-radius: 4px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('allCollections');
    if (!container) return;

    // show skeleton loader
    const count = Number(container.dataset.collectionsToShow) || 3;
    container.classList.add('collection-loading');

    let skeletonHTML = '';
    for (let i = 0; i < count; i++) {
      skeletonHTML += `
        <div class="collection-card skeleton">
          <div class="collection-title"><div class="skeleton-title"></div></div>
          <div class="collection-img"><div class="skeleton-img"></div></div>
        </div>`;
    }
    container.innerHTML = skeletonHTML;

    // fetch real collections
    fetch(evenFloFAQURL + 'collection/?page=1&page_size=6')
      .then(res => res.json())
      .then(data => {
        // clear skeletons
        container.innerHTML = '';
        container.classList.remove('collection-loading');

        data.results
          .slice(0, count)
          .forEach(collection => {
            const card = document.createElement('div');
            card.className = 'collection-card';
            card.innerHTML = `
              <a href="/pages/evenflo-collection?cid=${collection.id}">
                <div class="collection-title"><h2>${collection.name}</h2></div>
                <div class="collection-img">
                  <img src="${collection.image}" alt="${collection.name}">
                </div>
              </a>`;
            container.appendChild(card);
          });
      })
      .catch(err => {
        console.error('Error fetching collections:', err);
        container.classList.remove('collection-loading');
        // optionally show a fallback message here
      });
  });
</script>

{% schema %}
{
  "name": "EvenFlo FAQ Collection",
  "tag": "section",
  "class": "faqCollection",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "faqCollectionTitle",
      "label": "FAQ Collections Title",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "faqCollectionRange",
      "label": "Collections to show",
      "default": 5,
      "min": 1,
      "max": 6,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "EvenFlo FAQ Collection",
      "blocks": []
    }
  ]
}
{% endschema %}
