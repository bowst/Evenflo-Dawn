{% assign collections_to_show = section.settings.faqCollectionRange %}

<div class="collection-block">
  <div class="collection-main-wrapper page-width">
    <div class="heading">
      <h1>{{ section.settings.faqCollectionTitle }}</h1>
    </div>
    <div class="collection-wrapper" id="allCollections" data-collections-to-show="{{ collections_to_show }}">
      <!-- Skeleton loader for collections will be shown initially -->
      <div class="skeleton-loader collection-loader"></div>
      <!-- Real content will be injected here after fetching -->
    </div>
  </div>
</div>

<script>
function getPaginatedCollections() {
  const container = document.getElementById('allCollections');
  if (!container) return;

  // Clear any existing content (if any)
  container.innerHTML = "";
  
  // Show skeleton loader while fetching
  const loader = document.createElement('div');
  loader.classList.add('skeleton-loader', 'collection-loader');
  container.appendChild(loader);

  // Fetch collection data
  fetch(evenFloFAQURL + 'collection/?page=1&page_size=6')
    .then(response => response.json())
    .then(data => {
      const blocksToShow = container ? container.dataset.collectionsToShow : 5;

      // Clear loader and add collections
      container.innerHTML = ""; // Clear loader
      data?.results?.slice(0, blocksToShow).forEach((collection) => {
        const collectionCard = document.createElement('div');
        collectionCard.classList.add('collection-card');
        
        collectionCard.innerHTML = `
          <a href="/pages/evenflo-collection?cid=${collection?.id}">
            <div class="collection-title">
              <h2>${collection?.name}</h2>
            </div>
            <div class="collection-img">
              <img src="${collection?.image}" alt="collection-img">
            </div>
          </a>
        `;
        
        container.appendChild(collectionCard);
      });
    })
    .catch(error => {
      console.error('Error fetching collections:', error);
      container.innerHTML = '<p>Error loading collections</p>';
    });
}

document.addEventListener('DOMContentLoaded', () => {
  getPaginatedCollections();
});
</script>

<style>
/* Skeleton loader styles */
.skeleton-loader {
  background-color: #f1f2f3;
  animation: skeleton-loading 1.5s infinite ease-in-out;
  border-radius: 8px;
  margin-bottom: 16px;
}

.collection-loader {
  width: 100%;
  height: 200px;
  margin-bottom: 10px;
}

@keyframes skeleton-loading {
  0% {
    background-color: #f1f2f3;
  }
  50% {
    background-color: #e0e0e0;
  }
  100% {
    background-color: #f1f2f3;
  }
}

/* Collection card styles */
.collection-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 8px;
  padding: 16px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.collection-title h2 {
  margin: 0;
  font-size: 18px;
  color: #333;
}

.collection-img img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  margin-top: 10px;
}
</style>

{% schema %}
{
  "name": "EvenFlo FAQ Collection",
  "tag": "section",
  "class": "faqCollection",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "faqCollectionTitle",
      "label": "FAQ Collections Title",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "faqCollectionRange",
      "label": "Collections to show",
      "default": 5,
      "min": 1,
      "max": 6,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "EvenFlo FAQ Collection",
      "blocks": []
    }
  ]
}
{% endschema %}
