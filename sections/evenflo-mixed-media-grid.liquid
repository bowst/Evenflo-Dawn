{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-evenflo-mixed-media-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient new-2026">
  <div class="mixed-media-grid section-{{ section.id }}-padding">
    <div class="page-width">
      {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="section-header">
          {% if section.settings.heading != blank %}
            <h2 class="h3">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="subheading">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="mixed-media-grid__container">
        <ul
          class="mixed-media-grid__list grid grid--2-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
          role="list"
        >
          {%- for block in section.blocks -%}
            <li
              class="mixed-media-grid__item grid__item"
              {{ block.shopify_attributes }}
            >
              {% case block.type %}
                {% when 'image' %}
                  <div
                    id="mixed-media-image-{{ block.id }}"
                    class="mixed-media-grid__card image text-{{ block.settings.text_color }} mixed-media-grid__card--{{ section.settings.image_ratio }}"
                    {% if section.settings.image_ratio == 'adapt' and block.settings.image != blank %}
                      style="--adapt-ratio: {{ block.settings.image.aspect_ratio }};"
                    {% endif %}
                  >
                    {%- if block.settings.image_overlay_opacity > 0 -%}
                      {%- style -%}
                        #mixed-media-image-{{ block.id }} .mixed-media-grid__image {
                          opacity: {{ 100 | minus: block.settings.image_overlay_opacity | times: 0.01 }};
                        }
                      {%- endstyle -%}
                    {%- endif -%}

                    {%- if block.settings.image != blank -%}
                      {%- liquid
                        assign sizes_value = '(min-width: 750px) calc((100vw - 10rem) / ' | append: section.settings.columns_desktop | append: '), calc((100vw - 3rem) / 2)'
                      -%}
                      <div class="mixed-media-grid__media mixed-media-grid__media--background">
                        {{
                          block.settings.image
                          | image_url: width: 2000
                          | image_tag:
                            loading: 'lazy',
                            widths: '375, 550, 750, 1100, 1500, 1780, 2000',
                            sizes: sizes_value,
                            alt: block.settings.image.alt,
                            class: 'mixed-media-grid__image'
                        }}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.title != blank or block.settings.text != blank -%}
                      <div class="mixed-media-grid__content">
                        {%- if block.settings.title != blank -%}
                          <h3 class="mixed-media-grid__title">{{ block.settings.title }}</h3>
                        {%- endif -%}
                        {%- if block.settings.text != blank -%}
                          <div class="rte">{{ block.settings.text }}</div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}" class="mixed-media-grid__card-link">
                        <span class="visually-hidden">{{ block.settings.title | default: block.settings.image.alt }}</span>
                      </a>
                    {%- endif -%}
                  </div>

                {% when 'video' %}
                  {%- liquid
                    assign video_adapt_ratio = 1.777
                    if block.settings.shopify_video != blank
                      assign video_adapt_ratio = block.settings.shopify_video.aspect_ratio
                    elsif block.settings.fallback_image != blank
                      assign video_adapt_ratio = block.settings.fallback_image.aspect_ratio
                    endif

                    assign video_fallback_image = block.settings.fallback_image
                    if video_fallback_image == blank and block.settings.shopify_video.preview_image != blank
                      assign video_fallback_image = block.settings.shopify_video.preview_image
                    endif
                  -%}
                  <div
                    id="mixed-media-video-{{ block.id }}"
                    class="mixed-media-grid__card video text-{{ block.settings.text_color }} mixed-media-grid__card--{{ section.settings.image_ratio }}"
                    {% if section.settings.image_ratio == 'adapt' %}
                      style="--adapt-ratio: {{ video_adapt_ratio }};"
                    {% endif %}
                  >
                    {%- if block.settings.image_overlay_opacity > 0 -%}
                      {%- style -%}
                        #mixed-media-video-{{ block.id }} .mixed-media-grid__media--background {
                          opacity: {{ 100 | minus: block.settings.image_overlay_opacity | times: 0.01 }};
                        }
                      {%- endstyle -%}
                    {%- endif -%}

                    <div class="mixed-media-grid__media mixed-media-grid__media--background">
                      {%- if video_fallback_image != blank -%}
                        {%- liquid
                          assign sizes_value = '(min-width: 750px) calc((100vw - 10rem) / ' | append: section.settings.columns_desktop | append: '), calc((100vw - 3rem) / 2)'
                        -%}
                        {{
                          video_fallback_image
                          | image_url: width: 2000
                          | image_tag:
                            loading: 'lazy',
                            widths: '375, 550, 750, 1100, 1500, 1780, 2000',
                            sizes: sizes_value,
                            alt: block.settings.title,
                            class: 'mixed-media-grid__image'
                        }}
                      {%- endif -%}

                      {%- if block.settings.video_type == 'vimeo' and block.settings.vimeo_url != blank -%}
                        <div class="mixed-media-grid__video-wrapper video-vimeo">
                          <iframe
                            src="https://player.vimeo.com/video/{{ block.settings.vimeo_url }}?background=1&autoplay=1&loop=1&muted=1&playsinline=1"
                            width="640"
                            height="360"
                            frameborder="0"
                            allow="autoplay; fullscreen; picture-in-picture"
                            allowfullscreen
                            title="{{ block.settings.title | escape }}"
                          ></iframe>
                        </div>
                      {%- elsif block.settings.video_type == 'shopify' and block.settings.shopify_video != blank -%}
                        {{
                          block.settings.shopify_video
                          | video_tag:
                            image_size: '1100x',
                            autoplay: true,
                            loop: block.settings.enable_video_looping,
                            controls: false,
                            muted: true,
                            playsinline: true,
                            preload: 'auto',
                            class: 'mixed-media-grid__video'
                        }}
                      {%- endif -%}
                    </div>

                    {%- if block.settings.title != blank or block.settings.text != blank -%}
                      <div class="mixed-media-grid__content">
                        {%- if block.settings.title != blank -%}
                          <h3 class="mixed-media-grid__title">{{ block.settings.title }}</h3>
                        {%- endif -%}
                        {%- if block.settings.text != blank -%}
                          <div class="rte">{{ block.settings.text }}</div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>

                {% when 'product' %}
                  <div class="mixed-media-grid__card product">
                    {%- if block.settings.product != blank -%}
                      {% render 'evenflo-card-product',
                        card_product: block.settings.product,
                        media_aspect_ratio: section.settings.image_ratio,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        show_swatches: section.settings.show_swatches,
                        enable_quick_add: section.settings.enable_quick_add,
                        section_id: section.id
                      %}
                    {%- endif -%}
                  </div>
              {% endcase %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.enable_quick_add -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'evenflo-card-product-variant-toggle.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Mixed Media Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Headings"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Mixed Media Grid",
      "label": "Section heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "3",
      "label": "Grid columns (desktop)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "header",
      "content": "Product settings"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "default": false,
      "label": "Show color swatches"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": false,
      "label": "Enable quick add"
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Styles"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Text color",
          "options": [
            { "value": "light", "label": "Light text" },
            { "value": "dark", "label": "Dark text" }
          ],
          "default": "light"
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%",
          "label": "Image overlay",
          "info": "Opacity from 0% (light) to 100% (dark)"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "select",
          "id": "video_type",
          "options": [
            {
              "value": "vimeo",
              "label": "Vimeo"
            },
            {
              "value": "shopify",
              "label": "Shopify Video"
            }
          ],
          "default": "vimeo",
          "label": "Video type"
        },
        {
          "type": "text",
          "id": "vimeo_url",
          "label": "Vimeo video ID",
          "info": "Enter only the video ID (e.g., for https://vimeo.com/123456789, use 123456789)"
        },
        {
          "type": "video",
          "id": "shopify_video",
          "label": "Shopify video"
        },
        {
          "type": "checkbox",
          "id": "enable_video_looping",
          "default": false,
          "label": "Enable video looping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "header",
          "content": "Styles"
        },
        {
          "type": "image_picker",
          "id": "fallback_image",
          "label": "Fallback image",
          "info": "Shown as placeholder behind the video. Shopify video preview image is used when empty."
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Text color",
          "options": [
            { "value": "light", "label": "Light text" },
            { "value": "dark", "label": "Dark text" }
          ],
          "default": "light"
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%",
          "label": "Image overlay",
          "info": "Opacity from 0% (light) to 100% (dark)"
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mixed Media Grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "image"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}

