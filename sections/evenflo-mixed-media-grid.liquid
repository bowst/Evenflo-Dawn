{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-evenflo-mixed-media-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="mixed-media-grid section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="mixed-media-grid__header title-wrapper title-wrapper--no-top-margin">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}" style="text-align: {{ section.settings.heading_alignment }};">
            {{ section.settings.heading }}
          </h2>
        </div>
      {%- endif -%}

      <div class="mixed-media-grid__container">
        <ul
          class="mixed-media-grid__list grid grid--1-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
          role="list"
        >
          {%- for block in section.blocks -%}
            <li
              class="mixed-media-grid__item grid__item"
              {{ block.shopify_attributes }}
            >
              {% case block.type %}
                {% when 'image' %}
                  <div class="mixed-media-grid__card">
                    {%- if block.settings.image != blank -%}
                      {%- liquid
                        assign sizes_value = '(min-width: 750px) calc((100vw - 10rem) / ' | append: section.settings.columns_desktop | append: '), calc(100vw - 3rem)'
                      -%}
                      <div class="mixed-media-grid__media media media--{{ section.settings.image_ratio }}">
                        {%- if block.settings.link != blank -%}
                          <a href="{{ block.settings.link }}">
                        {%- endif -%}
                          {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1780, 2000', sizes: sizes_value, alt: block.settings.image.alt, class: 'mixed-media-grid__image' }}
                        {%- if block.settings.link != blank -%}
                          </a>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.title != blank or block.settings.text != blank -%}
                      <div class="mixed-media-grid__content">
                        {%- if block.settings.title != blank -%}
                          <h3 class="mixed-media-grid__title">{{ block.settings.title }}</h3>
                        {%- endif -%}
                        {%- if block.settings.text != blank -%}
                          <div class="rte">{{ block.settings.text }}</div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>

                {% when 'video' %}
                  <div class="mixed-media-grid__card">
                    {%- if block.settings.video_type == 'vimeo' and block.settings.vimeo_url != blank -%}
                      <div class="mixed-media-grid__media media media--{{ section.settings.image_ratio }}">
                        <div class="video-wrapper">
                          <iframe
                            src="https://player.vimeo.com/video/{{ block.settings.vimeo_url }}"
                            width="640"
                            height="360"
                            frameborder="0"
                            allow="autoplay; fullscreen; picture-in-picture"
                            allowfullscreen
                            class="mixed-media-grid__video"
                          ></iframe>
                        </div>
                      </div>
                    {%- elsif block.settings.video_type == 'shopify' and block.settings.shopify_video != blank -%}
                      <div
                        class="mixed-media-grid__media video-section__media"
                        {% if block.settings.shopify_video.preview_image != blank %}
                          style="--ratio-percent: {{ 1 | divided_by: block.settings.shopify_video.aspect_ratio | times: 100 }}%;"
                        {% endif %}
                      >
                        <deferred-media
                          class="deferred-media no-js-hidden"
                          data-media-id="{{ block.settings.shopify_video.id }}"
                        >
                          <button
                            id="Deferred-Poster-Modal-{{ block.settings.shopify_video.id }}"
                            class="video-section__poster media deferred-media__poster media--landscape"
                            type="button"
                          >
                            {% if block.settings.shopify_video.preview_image != blank %}
                              {{
                                block.settings.shopify_video.preview_image
                                | image_url: width: 1100
                                | image_tag
                              }}
                            {% else %}
                              {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                            {% endif %}
                            <span class="deferred-media__poster-button motion-reduce">
                              {%- render 'icon-play' -%}
                            </span>
                          </button>
                          <template>
                            {{
                              block.settings.shopify_video
                              | video_tag:
                                controls: true,
                                autoplay: true,
                                loop: block.settings.enable_video_looping
                            }}
                          </template>
                        </deferred-media>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.title != blank or block.settings.text != blank -%}
                      <div class="mixed-media-grid__content">
                        {%- if block.settings.title != blank -%}
                          <h3 class="mixed-media-grid__title">{{ block.settings.title }}</h3>
                        {%- endif -%}
                        {%- if block.settings.text != blank -%}
                          <div class="rte">{{ block.settings.text }}</div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>

                {% when 'product' %}
                  <div class="mixed-media-grid__card">
                    {%- if block.settings.product != blank -%}
                      {% render 'evenflo-card-product',
                        card_product: block.settings.product,
                        media_aspect_ratio: section.settings.image_ratio,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        show_swatches: section.settings.show_swatches,
                        show_quick_add: section.settings.enable_quick_add,
                        section_id: section.id
                      %}
                    {%- endif -%}
                  </div>
              {% endcase %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.enable_quick_add -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'evenflo-card-product-variant-toggle.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Mixed Media Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Mixed Media Grid",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "3",
      "label": "Grid columns (desktop)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "header",
      "content": "Product settings"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "default": false,
      "label": "Show color swatches"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": false,
      "label": "Enable quick add"
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "select",
          "id": "video_type",
          "options": [
            {
              "value": "vimeo",
              "label": "Vimeo"
            },
            {
              "value": "shopify",
              "label": "Shopify Video"
            }
          ],
          "default": "vimeo",
          "label": "Video type"
        },
        {
          "type": "text",
          "id": "vimeo_url",
          "label": "Vimeo video ID",
          "info": "Enter only the video ID (e.g., for https://vimeo.com/123456789, use 123456789)"
        },
        {
          "type": "video",
          "id": "shopify_video",
          "label": "Shopify video"
        },
        {
          "type": "checkbox",
          "id": "enable_video_looping",
          "default": false,
          "label": "Enable video looping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mixed Media Grid",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "video"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}

