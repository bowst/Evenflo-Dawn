{{ 'evenflo-review-slider-block.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<div
  class="evenflo-review-slider-block"
  style="background-color: {{ section.settings.background }}"
>
  <div class="{% if section.settings.full-width %} full-width-container {% else %} page-width {% endif %}">
    {% if section.settings.title != blank %}
      <div class="review-slider-header" style="text-align: {{ section.settings.title_alignment }};">
        <h2 class="review-slider-title">{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="review-slider-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="review-slider-split-container">
      <!-- Left Column: Awards -->
      <div class="review-slider-awards-column">
        <div class="awards-logos">
          {% for block in section.blocks %}
            {% if block.type == 'award_block' %}
              <div class="award-logo-item" {{ block.shopify_attributes }}>
                {% if block.settings.award_link != blank %}
                  <a href="{{ block.settings.award_link }}" target="_blank" rel="noopener noreferrer" class="award-link">
                {% endif %}
                {% if block.settings.award_image != blank %}
                  <div class="award-image-wrapper">
                    <img
                      src="{{ block.settings.award_image | image_url: width: 120 }}"
                      alt="{{ block.settings.award_image.alt | default: 'Award' }}"
                      width="120"
                      height="120"
                      loading="lazy" 
					  {% if block.settings.award_text != blank %}
					  title="{{ block.settings.award_text }}"
					  {% endif %}
                    >
                  </div>
                {% endif %}
                
                {% if block.settings.award_link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <!-- Right Column: Review Slider -->
      <div class="review-slider-column">
        <div class="swiper mySwiper evenflo-review-slider">
          <div class="swiper-wrapper evenflo-review-slider-wrapper" id="review-slider-wrapper">
            <div class="loading">
              <p>Loading reviews...</p>
            </div>
          </div>
          <!-- Navigation buttons -->
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        </div>
      </div>
    </div>
    {% for block in section.blocks %}
      {% case block.type %}
      {% when '@app' %}
        {% render block %}
      {% endcase %}
    {% endfor %}
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script>
  (function() {
    // Wait for both DOM and Swiper to be ready
    function initReviewSlider() {
      if (typeof Swiper === 'undefined') {
        setTimeout(initReviewSlider, 100);
        return;
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          initializeReviewSlider();
        });
      } else {
        initializeReviewSlider();
      }
    }

    function initializeReviewSlider() {
    const wrapper = document.getElementById('review-slider-wrapper');
    const yotpoAppKey = 'rKKEiGFLu4Rt6rskIEboV0KE0zMdjlOAyX5mm64Y';

    // Collect review IDs from blocks
    const reviewIds = [];
    {% for block in section.blocks %}
      {% if block.settings.review_id != blank %}
        reviewIds.push('{{ block.settings.review_id }}');
      {% endif %}
    {% endfor %}

    // Function to fetch Yotpo reviews by ID
    async function fetchYotpoReviews() {
      try {
        // If review IDs are provided, fetch specific reviews
        if (reviewIds.length > 0) {
          const reviewPromises = reviewIds.map(reviewId =>
            fetchReviewById(yotpoAppKey, reviewId)
          );

          const reviews = await Promise.all(reviewPromises);
          const validReviews = reviews.filter(review => review !== null);

          if (validReviews.length === 0) {
            wrapper.innerHTML = '<div class="error"><p>No reviews found for the provided review IDs.</p></div>';
            return;
          }

          renderReviews(validReviews);
          return;
        }

        // Fallback: If no review IDs, show error message
        wrapper.innerHTML = '<div class="error"><p>Please add at least one review ID in the section settings.</p></div>';
      } catch (error) {
        console.error('Error fetching Yotpo reviews:', error);
        wrapper.innerHTML = '<div class="error"><p>Unable to load reviews. Please check the review IDs and try again.</p></div>';
      }
    }

    // Function to fetch a single review by ID
    async function fetchReviewById(appKey, reviewId) {
      try {
        const apiUrl = `https://api.yotpo.com/reviews/${reviewId}?utoken=${appKey}`;

        const response = await fetch(apiUrl, {
          method: 'GET',
          headers: {
            'Accept': 'application/json',
          },
          mode: 'cors'
        });

        if (!response.ok) {
          console.warn(`Failed to fetch review ${reviewId}:`, response.status);
          return null;
        }

        const data = await response.json();

        if (data.response && data.response.review) {
		  // console.log('data.response.review', data.response.review);
          return data.response.review;
        }

        return null;
      } catch (error) {
        console.error(`Error fetching review ${reviewId}:`, error);
        return null;
      }
    }

    // Function to render reviews
    function renderReviews(reviews) {
      wrapper.innerHTML = '';

      reviews.forEach(review => {
        const slide = document.createElement('div');
        slide.className = 'swiper-slide evenflo-review-slider-content';

        const stars = generateStars(review.score);
        const reviewText = review.content || review.review_body || '';
        const reviewerName = review.user.display_name || 'Anonymous';
        const productTitle = review.products[0].Product.name || '';
		const productUrl = review.products[0].Product.product_url || '';

        slide.innerHTML = `
          <div class="evenflo-review-content">
            ${productTitle ? `<div class="review-product-title"><a href="${productUrl}">${productTitle}</a></div>` : ''}
            <div class="review-text">${reviewText}</div>
            <div class="review-meta">
              <div class="review-author">${reviewerName}</div>
            </div>
			<div class="review-rating">${stars}</div>
          </div>
        `;

        wrapper.appendChild(slide);
      });

      // Initialize Swiper after reviews are loaded
      initializeSwiper();
    }

    // Function to generate star rating HTML
    function generateStars(rating) {
      const fullStars = Math.floor(rating);
      const hasHalfStar = rating % 1 >= 0.5;
      let starsHTML = '';

      for (let i = 0; i < fullStars; i++) {
        starsHTML += '<span class="star star-full">★</span>';
      }

      if (hasHalfStar) {
        starsHTML += '<span class="star star-half">★</span>';
      }

      const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
      for (let i = 0; i < emptyStars; i++) {
        starsHTML += '<span class="star star-empty">★</span>';
      }

      return `<div class="review-stars">${starsHTML}</div>`;
    }

    // Function to initialize Swiper
    function initializeSwiper() {
      if (typeof Swiper === 'undefined') {
        console.error('Swiper library not loaded');
        return;
      }

      const swiper = new Swiper('.evenflo-review-slider-block .mySwiper', {
        loop: true,
        slidesPerView: 1,
        spaceBetween: 0,
        navigation: {
          nextEl: '.evenflo-review-slider-block .swiper-button-next',
          prevEl: '.evenflo-review-slider-block .swiper-button-prev',
        },
        autoplay: {
          delay: {{ section.settings.autoplay_delay | default: 5000 }},
          disableOnInteraction: false,
        },
        breakpoints: {
          320: {
            slidesPerView: 1,
            spaceBetween: 0,
          },
          640: {
            slidesPerView: 1,
          },
          960: {
            slidesPerView: {{ section.settings.slides_per_view_desktop | default: 1 }},
          },
        },
      });
    }

    // Start fetching reviews
    fetchYotpoReviews();
    }

    // Initialize when ready
    initReviewSlider();
  })();
</script>

{% schema %}
{
  "name": "Evenflo Review Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay Delay (ms)",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "default": 5000
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "label": "Slides Per View (Desktop)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "checkbox",
      "id": "full-width",
      "label": "Full Width",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "review_block",
      "name": "Review",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "review_id",
          "label": "Review ID",
          "info": "Enter the Yotpo review ID you want to display"
        }
      ]
    },
    {
      "type": "award_block",
      "name": "Award Logo",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "award_image",
          "label": "Award Logo"
        },
        {
          "type": "url",
          "id": "award_link",
          "label": "Award Link",
          "info": "Optional: Link to award information"
        },
		{
			"type": "text",
			"id": "award_text",
			"label": "Award Text",
			"info": "Text description for this award, which is added to the image title attribute"
		  }
      ]
    },
	{
      "type": "@app"
	}
  ],
  "presets": [
    {
      "name": "Evenflo Review Slider",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

