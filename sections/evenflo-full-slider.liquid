{% render 'swiper-bundle' %}
{{ 'evenflo-full-slider.css' | asset_url | stylesheet_tag }}

<section class="evenflo-multicolumn-slider color-background-4">
  <div class="page-width section-{{ section.id }}-padding{% if section.settings.secondary_background %} isolate{% endif %}">
    {% if section.settings.header %}
      <hl class="main-page-title page-title h0">{{ section.settings.header }}</hl>
    {% endif %}
    <div
      id="full-slider-{{ section.id }}"
      class="swiper color-background-1"
    >
      <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% assign blockClass = "swiper-{{ forloop.index | string }}" %}

        {% if block.settings.image %}
          {% assign image = block.settings.image %}
          {% assign blockHtml = block.settings.html %}
          <div class="swiper-slide">
            <div class="row">
              <div class="col-4">
                {{ image.src | image_url: width: 650 | image_tag }}
              </div>

              <div class="col-7">{{ blockHtml }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>

<script>
  (window.evenfloSwiperBundleReady || Promise.resolve()).then(function () {
    var el = document.getElementById('full-slider-{{ section.id }}');
    if (!el || el.swiper) return;
    new Swiper(el, {
      centeredSlides: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false
      },
      pagination: {
        el: el.querySelector('.swiper-pagination'),
        clickable: true
      }
    });
  });
</script>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Evenflo Full Slider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "header",
      "label": "Header"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "html",
          "id": "html",
          "label": "HTML"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Evenflo Full Slider",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
