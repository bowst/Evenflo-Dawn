{{ 'product-img-slider-block.css' | asset_url | stylesheet_tag }}
{% render 'swiper-bundle' %}
<div class="product-img-slider-block">
  <div class="page-width">
    <!-- Conditionally Render the Heading if it exists -->
    {% if section.settings.title != blank %}
      <h2 class="title inline-richtext h1 text-center">{{ section.settings.title }}</h2>
    {% endif %}
    <div class="swiper mySwiper product-img-slider">
      <div class="swiper-wrapper product-img-wrapper">
        {% for product in section.settings.product_list %}
          {% for variant in product.variants %}
            {% if variant.image.src %}
              <div class="swiper-slide product-img-card">
                <a href="{{ product.url }}">
                  <img src="{{ variant.image.src | image_url: width: 1000 }}" alt="{{ product.title }} - {{ variant.title }}" width="" height="" loading="lazy">
                </a>
              </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    (window.evenfloSwiperBundleReady || Promise.resolve()).then(function () {
    var swiper = new Swiper(".product-img-slider-block .mySwiper", {
      loop: true,
      slidesPerView: 5,
      spaceBetween: 20,
        centeredSlides: true,
      autoplay: {
        delay: 2500,
        disableOnInteraction: false,
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: false,
      },
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      breakpoints: {
          320: {
              // when window width is >= 320px
              slidesPerView: 1,
              spaceBetween: 10,
          },
          640: {
              // when window width is >= 640px
              slidesPerView: 3,
          },
          960: {
              // when window width is >= 960px
              slidesPerView: 5,
          },
    	},
    });
    });
  });
</script>

{% schema %}
{
  "name": "Product Image Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
    "type": "text",
    "id": "title",
    "label": "Heading",
    "default": "Quick links"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
    }
  ],
  "presets": [
    {
      "name": "Product Image Slider",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
