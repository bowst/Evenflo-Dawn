{{ 'evenflo-section-parentlink.css' | asset_url | stylesheet_tag }}

<section class="parentlink">
  <div class="page-width rich-text--full-width content-container--full-width">
    <h2 class="h1">Supported By <strong>ParentLink Consumer Care</strong> Via Phone, Email, Chat and Video</h2>

    <div class="flex-row">
      <div class="flex-item">
        <h3>Chat</h3>
        {% comment %} <p>You can get in touch with us at any time during business hours by using LiveChat.</p> {% endcomment %}
        <p><strong>Available between 9am and 5pm, Monday through Friday</strong></p>

        <div data-id="14e749b8fb" class="livechat_button action_button cc-button">
          <a href="https://www.livechat.com/?utm_source=chat_button&amp;utm_medium=referral&amp;utm_campaign=lc_3753191"
            >Chat Now</a
          >
        </div>
      </div>
      <div class="flex-item">
        <h3>Email</h3>
        <p>No time to chat? Email us your inquiry</p>
        <p><a href="mailto:parentlink@evenflo.com">parentlink@evenflo.com</a></p>
      </div>
      <div class="flex-item">
        <h3>Phone</h3>
        <p>
          <a href="tel:1-800-233-5921">1-800-233-5921 (US)</a><br>
          <a href="tel:1-937-773-3971">1-937-773-3971 (Canada)</a>
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Evenflo Parentlink",
  "class": "text",
  "tag": "section"
}
{% endschema %}
