{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'section-evenflo-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{{ 'evenflo-product-specifications.css' | asset_url | stylesheet_tag }}


{% style %}
@media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="multicolumn evenflo-product-specifications color-scheme-1 gradient background-none">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin text-{{ section.settings.heading_alignment }}">
        <h2 class="title inline-richtext {{ section.settings.heading_size }} ">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}
   
      <ul
        class="multicolumn-list contains-content-container grid grid--1-col-tablet-down grid--3-col-desktop "
        role="list"
      >
		<li id="specs-column-1"
			class="multicolumn-list__item grid__item" >
			<h3 class="h2">What's in the Box</h3>
			<div class="multicolumn-card content-container">
				{%  render 'evenflo-product-specs--whats-in-the-box' %}
			</div>
		</li>  

		<li id="specs-column-2"
			class="multicolumn-list__item grid__item" >
			<h3 class="h2">Product Specifications</h3>
			<div class="multicolumn-card content-container">
				
				{% if product.vendor == 'Rollplay' %}
					{%  render 'evenflo-product-specs--rollplay' %}
				{% endif %}

				{%- if product.type == 'Play Yards' %}
					{%  render 'evenflo-product-specs--play-yard' %}
				{% endif %}

				{%- if product.type == 'Stroller Accessories' %}
					{% render 'evenflo-product-specs--stroller-accessories' %}
				{% endif %}

				{% if product.type == 'Gates' or product.type == 'Baby Gate' %}
					{% render 'evenflo-product-specs--gates' %}
				{% endif %}

				{% if product.type == 'High Chair' %}
					{% render 'evenflo-product-specs--high-chair' %}
				{% endif %}

				{%- if product.type == 'Stroller' or product.type == 'Travel System' %}
					{% render 'evenflo-product-specs--stroller' %}
				{% endif %}

				{%- if product.type == 'Carrier' or product.type == 'Baby Carrier' %}
					{%  render 'evenflo-product-specs--carrier' %}
				{% endif %}

				{% if product.type contains 'Car Seat'
				or product.type contains 'Travel System'
				or product.type contains 'Booster Seat'
				%}				
					{% render 'evenflo-product-specs--car-seat' %}
				{% endif %}

				{% if product.vendor == 'Exersaucer' %}
					{% render 'evenflo-product-specs--exersaucer' %}
				{% endif %}
			</div>
		</li>  
		
		<li id="specs-column-3"
			class="multicolumn-list__item grid__item" >				
			<h3 class="h2">Child Fit</h3>
			<div class="multicolumn-card content-container">
				<!-- Shared Age/Height/Weight fields -->
				{% assign min_weight = product.metafields.sf_products.child_weight_min %}
				{% assign max_weight = product.metafields.sf_products.child_weight_max %}
				{% assign child_weight_min_value = product.metafields.sf_products.child_weight_min %}
				{% assign child_weight_max_value = product.metafields.sf_products.child_weight_max %}
				{% assign min_height = product.metafields.sf_products.child_height_min %}
				{% assign max_height = product.metafields.sf_products.child_height_max %}
				{% assign gen_fit = product.metafields.sf_products.child_gen_fit  %}
				{% assign gen_height = product.metafields.sf_products.child_gen_height  %}
				{% assign min_age = product.metafields.sf_products.child_age_min %}
				{%  assign max_age = product.metafields.sf_products.child_age_max %}

				<div class="child-fit-mode">
					<ul class="specs-list">
					{% if child_weight_min_value or child_weight_max_value %}
						<li>
							<strong>Child Weight</strong>
							<div>
								{% if child_weight_min_value %}
									{{ child_weight_min_value }} -
								{% endif %}
								{% if child_weight_max_value %}
									{{ child_weight_max_value }} lbs
								{% endif %}
							</div>
						</li>
					{% elsif min_weight and max_weight %}
						<li>
							<strong>Weight</strong>
							<div>
								{{ min_weight }} - {{ max_weight }} lbs
							</div>
						</li>
					{% endif %}
					{% if min_height and max_height %}
						<li>
							<strong>Height</strong>
							<div>
								{{ min_height }} - {{ max_height }} inches
							</div>
						</li>
					{% endif %}
					{% if gen_height %}
						<li>
							<strong>Height</strong>
							<div>{{  gen_height }}</div>
						</li>
					{% endif %}
					{% if gen_fit %}
						<li>
							<strong>General Fit</strong>
							<div>{{  gen_fit }}</div>
						</li>
					{% endif %}
					{% if min_age %}
						<li>
							<strong>Minimum Age</strong>
							<div>
								{{ min_age }}
							</div>
						</li>
					{% endif %}
					{% if max_age %}
						<li>
							<strong>Maximum Age</strong>
							<div>
								{{ max_age }}
							</div>
						</li>
					{% endif %}
					</ul>
				</div>
				<!-- rear facing mode for car seat -->
				{% assign rear_facing_weight_min = product.metafields.sf_car_seat.rear_facing_weight_min %}
				{% assign rear_facing_weight_max = product.metafields.sf_car_seat.rear_facing_weight_max %}
				{% assign rear_facing_height_min = product.metafields.sf_car_seat.rear_facing_height_min %}
				{% assign rear_facing_height_max = product.metafields.sf_car_seat.rear_facing_height_max %}
				{% assign rear_facing_age_limit = product.metafields.sf_car_seat.rear_facing_age_limit %}
				{% assign rear_facing_fit_statement = product.metafields.sf_car_seat.rear_facing_fit_statement %}
					
				{% if rear_facing_weight_min
					and rear_facing_weight_max
					and rear_facing_height_min
					and rear_facing_height_max
				%}
				<div class="child-fit-mode">
					<h4 class="h3">Rear-Facing Mode</h4>
					<ul class="specs-list">
						<li>
							<strong>Weight</strong>
							<div>
								{{ rear_facing_weight_min }} - {{ rear_facing_weight_max }} lbs
							</div>
						</li>

						<li>
							<strong>Height</strong>
							<div>
								{{ rear_facing_height_min }} - {{ rear_facing_height_max }} in
							</div>
						</li>
					</ul>
					{% if rear_facing_fit_statement %}
					<div class="statement">
						{{ rear_facing_fit_statement }}
					</div>
					{%  endif %}
				</div>
				{% endif %}

				<!-- forward facing mode for car seat -->
				{% assign forward_facing_weight_min = product.metafields.sf_car_seat.forward_facing_weight_min %}
				{% assign forward_facing_weight_max = product.metafields.sf_car_seat.forward_facing_weight_max %}
				{% assign forward_facing_height_min = product.metafields.sf_car_seat.forward_facing_height_min %}
				{% assign forward_facing_height_max = product.metafields.sf_car_seat.forward_facing_height_max %}
				{% assign forward_facing_age_limit = product.metafields.sf_car_seat.forward_facing_age_limit %}
				{% assign forward_facing_fit_statement = product.metafields.sf_car_seat.forward_facing_fit_statement %}
				{% if forward_facing_weight_min
					and forward_facing_weight_max
					and forward_facing_height_min
					and forward_facing_height_max
				%}
				<div class="child-fit-mode">
					<h4 class="h3">Forward-Facing Mode</h4>
					<ul class="specs-list">
						<li>
							<strong>Weight</strong>
							<div>
								{{ forward_facing_weight_min }} - {{ forward_facing_weight_max }} lbs
							</div>
						</li>

						<li>
							<strong>Height</strong>
							<div>
								{{ forward_facing_height_min }} - {{ forward_facing_height_max }} in
							</div>
						</li>
						
						{%  if forward_facing_fit_statement %}
						<li>
							<div class="statement">
								{{ forward_facing_fit_statement }}
							</div>
						</li>
						{% endif %}
					</ul>	
				</div>
				{% endif %}

				<!-- high back mode for car seat -->
				{% assign high_back_weight_min = product.metafields.sf_car_seat.high_back_weight_min %}
				{% assign high_back_weight_max = product.metafields.sf_car_seat.high_back_weight_max %}
				{% assign high_back_height_min = product.metafields.sf_car_seat.high_back_height_min %}
				{% assign high_back_height_max = product.metafields.sf_car_seat.high_back_height_max %}
				{% assign high_back_fit_statement = product.metafields.sf_car_seat.high_back_fit_statement %}
				{% if high_back_weight_min
					or high_back_weight_max
					or high_back_height_min
					or high_back_height_max
				%}
				<div class="child-fit-mode">
					<h4 class="h3">High Back Booster Mode</h4>
					<ul class="specs-list">
						{% if high_back_fit_statement %}
						<li>
							<strong>Weight</strong>
							<div>
								{{ high_back_weight_min }} - {{ high_back_weight_max }} lbs
							</div>
						</li>
						{% endif %}
						
						{% if high_back_fit_statement %}
						<li>
							<strong>Height</strong>
							<div>
								{{ high_back_height_min }} - {{ high_back_height_max }} in
							</div>
						</li>
						{% endif %}
					</ul>

					{% if high_back_fit_statement %}
						<div class="statement">
						{{ high_back_fit_statement }}
						</div>
					{% endif %}
				</div>
				{% endif %}

				<!-- no back mode for car seat -->
				{% assign no_back_weight_min = product.metafields.sf_car_seat.no_back_weight_min %}
				{% assign no_back_weight_max = product.metafields.sf_car_seat.no_back_weight_max %}
				{% assign no_back_height_min = product.metafields.sf_car_seat.no_back_height_min %}
				{% assign no_back_height_max = product.metafields.sf_car_seat.no_back_height_max %}
				{% assign no_back_fit_statement = product.metafields.sf_car_seat.no_back_fit_statement %}

				{% if no_back_weight_min
					or no_back_weight_max
					or no_back_height_min
					or no_back_height_max
				%}
				<div class="child-fit-mode">
					<h4 class="h3">No Back Booster Mode</h4>
					<ul class="specs-list">
						{% if no_back_weight_max %}
						<li>
							<strong>Weight</strong>
							<div>
								{{ no_back_weight_min }} - {{ no_back_weight_max }} lbs
							</div>
						</li>
						{% endif %}

						{% if no_back_height_max %}
						<li>
							<strong>Height</strong>
							<div>
								{{ no_back_height_min }} - {{ no_back_height_max }} in
							</div>
						</li>
						{% endif %}
					</ul>
					{% if no_back_fit_statement %}
						<div class="statement">
						{{ no_back_fit_statement }}
						</div>
					{% endif %}
				</div>
				{% endif %}

				
				<!-- Stroller Fit -->
				{% comment %} {% if product.metafields.sf_stroller.max_age %}
				<strong>Stroller Max Age</strong>
					{{ product.metafields.sf_stroller.max_age | strip }}
				</div>
				{% endif %} {% endcomment %}
			</div>
		</li>  
      </ul>
	  <div class="specifications-image-container">
	  {% assign specifications_image = product.metafields.sf_products.specifications_image %}
		{% if specifications_image %}
		<h3 class="h2">{{ product.type }} Dimensions</h3>
		<ul
			class="multicolumn-list contains-content-container grid grid--1-col-tablet-down grid--3-col-desktop text-start"
			role="list"
		  >
			<li id="specs-column-1"
				class="multicolumn-list__item grid__item" >
				<div class="multicolumn-card-content no-bg">
					<img class="specifications-image" width="100%" height="auto" loading="lazy" alt="{{ product.title }} Specifications" src="{{ specifications_image }}">
				</div>
			</li>  
		</ul>
		
		{% endif %}
	</div>
  </div>
</div>

{% schema %}
{
  "name": "Evenflo Product Specs",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Product Specs & Manuals",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h1 heading-underline",
          "label": "t:sections.all.heading_size.options__4.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ]
    },
	{
		"type": "range",
		"id": "padding_top",
		"min": 0,
		"max": 100,
		"step": 4,
		"unit": "px",
		"label": "t:sections.all.padding.padding_top",
		"default": 36
	},
	{
		"type": "range",
		"id": "padding_bottom",
		"min": 0,
		"max": 100,
		"step": 4,
		"unit": "px",
		"label": "t:sections.all.padding.padding_bottom",
		"default": 36
	}
  ],
  "presets": [
    {
      "name": "Evenflo Product Specs"
    }
  ]
}
{% endschema %}
