<a
  href="
    {% if customer.tags contains "swell_vip_bronze" or customer.tags contains  "swell_vip_silver"%}
      {{ section.settings.bronze_and_silver }}
    {% elsif customer.tags contains "swell_vip_gold" %}
      {{ section.settings.gold }}
    {% else %}
      {{ section.settings.non_member }}
    {% endif %}
  "
>
  <div style="position: relative;">
    <div class="desktop">
      {% if customer.tags contains 'swell_vip_bronze' %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Evenflo_Labor-Day_2025_HPH_Bronze-Desktop_1440x450_a98e7d87-8f76-49fb-9098-b2d566b254eb.jpg?v=1752008432"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
	  {% elsif customer.tags contains 'swell_vip_silver' %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Evenflo_Labor-Day_2025_HPH_Silver-Desktop_1440x450_7e34c854-c193-4cb2-a2a9-045a1e63ed1b.jpg?v=1753110465"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
      {% elsif customer.tags contains 'swell_vip_gold' %}
        <img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Evenflo_Labor-Day_2025_HPH_Gold-Desktop_1440x450_648be062-7dce-4287-a3c0-aaa588581ee7.jpg?v=1753110465"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
      {% else %}
        <img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Evenflo_Labor-Day_2025_HPH_Join-Now_Desktop_1440x450_7209627f-d842-4158-8339-ae9d02e08f5f.jpg?v=1753110465"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
        <!-- <video autoplay muted loop playsinline class="desktop">
          <source src="{{ section.settings.desktop_video_non_member }}" type="video/mp4">
        </video> -->
      {% endif %}
    </div>

    <div class="mobile">
      {% if customer.tags contains 'swell_vip_bronze' %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Evenflo_Labor-Day_2025_HPH_Bronze-Mobile_375x500_55b29b2e-c60c-45cf-847d-5f31dd866000.jpg?v=1753110465"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
	  {% elsif customer.tags contains 'swell_vip_silver' %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Evenflo_Labor-Day_2025_HPH_Silver-Mobile_375x500_copy.jpg?v=1753110465"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >      
	  {% elsif customer.tags contains 'swell_vip_gold' %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Evenflo_Labor-Day_2025_HPH_Gold-Mobile_375x500_05404ccc-797e-4511-82bd-882090c915cb.jpg?v=1753110465"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
      {% else %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Evenflo_Labor-Day_2025_HPH_Join-Now_Mobile_375x500_a21bf7f6-1645-43ee-b3ae-8406b61db71c.jpg?v=1753110465"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
        <!-- https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Revolve_G_G_HPH_Mobile_1.jpg?v=1729009316
        <video autoplay muted loop playsinline class="mobile">
          <source src="{{ section.settings.mobile_video_non_member }}" type="video/mp4">
        </video> -->
      {% endif %}
    </div>
  </div>
</a>

<style>
  .mobile,
  .desktop {
    min-width: 100%;
  }

  @media screen and (min-width: 800px) {
    .mobile {
      display: none;
    }
  }

  @media screen and (max-width: 800px) {
    .desktop {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Evenflo Loyalty Banner",
  "tag": "section",
  "class": "text",
  "settings": [
    {
      "type": "text",
      "id": "bronze_and_silver",
      "label": "Bronze and Silver Loyalty Banner Link",
      "default": "Add url here"
    },
    {
      "type": "text",
      "id": "gold",
      "label": "Gold Loyalty Banner Link",
      "default": "Add url here"
    },
    {
      "type": "text",
      "id": "non_member",
      "label": "No Loyalty Banner Link",
      "default": "Add url here"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image - Members"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image - Members"
    },
    {
      "type": "url",
      "id": "desktop_video_non_member",
      "label": "Desktop Video - Non Members",
      "info": "MP4 format required"
    },
    {
      "type": "url",
      "id": "mobile_video_non_member",
      "label": "Mobile Video - Non Members",
      "info": "MP4 format required"
    }
  ],
  "presets": [
    {
      "name": "Evenflo Loyalty Banner"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}
