<a
  href="
    {% if customer.tags contains "swell_vip_bronze" or customer.tags contains  "swell_vip_silver"%}
      {{ section.settings.bronze_and_silver }}
    {% elsif customer.tags contains "swell_vip_gold" %}
      {{ section.settings.gold }}
    {% else %}
      {{ section.settings.non_member }}
    {% endif %}
  "
>
  <div style="position: relative;">
    <div class="desktop">
      {% if customer.tags contains 'swell_vip_bronze' %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Reo_Desktop_2x_f57f0f12-aa7f-4cd3-ac29-a40464a25f7a.jpg?v=1752007639"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
	  {% elsif customer.tags contains 'swell_vip_silver' %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Reo_Desktop_2x_f57f0f12-aa7f-4cd3-ac29-a40464a25f7a.jpg?v=1752007639"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
      {% elsif customer.tags contains 'swell_vip_gold' %}
        <img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Reo_Desktop_2x_f57f0f12-aa7f-4cd3-ac29-a40464a25f7a.jpg?v=1752007639"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
      {% else %}
        <img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Reo_Desktop_2x_f57f0f12-aa7f-4cd3-ac29-a40464a25f7a.jpg?v=1752007639"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
        <!-- <video autoplay muted loop playsinline class="desktop">
          <source src="{{ section.settings.desktop_video_non_member }}" type="video/mp4">
        </video> -->
      {% endif %}
    </div>

    <div class="mobile">
      {% if customer.tags contains 'swell_vip_bronze' %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Reo_Mobile_2x_e3887236-2a26-40ec-98c3-3bfd9f777b90.jpg?v=1752007639"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
	  {% elsif customer.tags contains 'swell_vip_silver' %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Reo_Mobile_2x_e3887236-2a26-40ec-98c3-3bfd9f777b90.jpg?v=1752007639"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >      
	  {% elsif customer.tags contains 'swell_vip_gold' %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Reo_Mobile_2x_e3887236-2a26-40ec-98c3-3bfd9f777b90.jpg?v=1752007639"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
      {% else %}
		<img
			src="https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Reo_Mobile_2x_e3887236-2a26-40ec-98c3-3bfd9f777b90.jpg?v=1752007639"
			alt="Loyalty Banner"
			style="width: 100%;"
		  >
        <!-- https://cdn.shopify.com/s/files/1/0512/2359/3116/files/Revolve_G_G_HPH_Mobile_1.jpg?v=1729009316
        <video autoplay muted loop playsinline class="mobile">
          <source src="{{ section.settings.mobile_video_non_member }}" type="video/mp4">
        </video> -->
      {% endif %}
    </div>
  </div>
</a>

<style>
  .mobile,
  .desktop {
    min-width: 100%;
  }

  @media screen and (min-width: 800px) {
    .mobile {
      display: none;
    }
  }

  @media screen and (max-width: 800px) {
    .desktop {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Evenflo Loyalty Banner",
  "tag": "section",
  "class": "text",
  "settings": [
    {
      "type": "text",
      "id": "bronze_and_silver",
      "label": "Bronze and Silver Loyalty Banner Link",
      "default": "Add url here"
    },
    {
      "type": "text",
      "id": "gold",
      "label": "Gold Loyalty Banner Link",
      "default": "Add url here"
    },
    {
      "type": "text",
      "id": "non_member",
      "label": "No Loyalty Banner Link",
      "default": "Add url here"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image - Members"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image - Members"
    },
    {
      "type": "url",
      "id": "desktop_video_non_member",
      "label": "Desktop Video - Non Members",
      "info": "MP4 format required"
    },
    {
      "type": "url",
      "id": "mobile_video_non_member",
      "label": "Mobile Video - Non Members",
      "info": "MP4 format required"
    }
  ],
  "presets": [
    {
      "name": "Evenflo Loyalty Banner"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}
