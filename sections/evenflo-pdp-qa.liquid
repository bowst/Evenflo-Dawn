<div class="pdp-qa page-width">
  <h2 class="pdp-qa__title">PDP QA — Metafields</h2>
  <p class="pdp-qa__meta">
    Product: <strong>{{ product.title }}</strong> &middot; {{ fields.size }} metafields referenced in theme code
  </p>

  <table class="pdp-qa__table">
    <thead>
      <tr>
        <th>Namespace</th>
        <th>Key</th>
        <th>Type</th>
        <th>Value</th>
      </tr>
    </thead>
    <tbody>
      {%- for field in fields -%}
        {%- assign parts = field | split: '.' -%}
        {%- assign ns = parts[0] -%}
        {%- assign key = parts[1] -%}
        {%- assign mf = product.metafields[ns][key] -%}
        <tr>
          <td class="pdp-qa__ns">{{ ns }}</td>
          <td class="pdp-qa__key">{{ key }}</td>
          <td class="pdp-qa__type">{{ mf.type }}</td>
          <td class="pdp-qa__value">{{ mf.value | escape }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>

<style>
  .pdp-qa {
    padding: 2rem 0;
    font-size: 14px;
  }
  .pdp-qa__title {
    margin: 0 0 0.5rem;
  }
  .pdp-qa__meta {
    margin: 0 0 1rem;
    color: #555;
  }
  .pdp-qa__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .pdp-qa__table th,
  .pdp-qa__table td {
    border: 1px solid #ddd;
    padding: 6px 8px;
    text-align: left;
    vertical-align: top;
    word-break: break-word;
    white-space: pre-wrap;
  }
  .pdp-qa__table th {
    background: #f4f4f4;
    position: sticky;
    top: 0;
  }
  .pdp-qa__table tr:nth-child(even) td {
    background: #fafafa;
  }
  .pdp-qa__ns {
    width: 18%;
    font-family: monospace;
  }
  .pdp-qa__key {
    width: 24%;
    font-family: monospace;
  }
  .pdp-qa__type {
    width: 18%;
    color: #777;
  }
  .pdp-qa__value {
    width: 40%;
  }
</style>

{% schema %}
{
  "name": "PDP QA",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "QA-only: lists every product metafield referenced in the theme code with its type and current value (blank if unset). Add to a product template, then remove before launch."
    }
  ],
  "presets": [
    {
      "name": "PDP QA",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
