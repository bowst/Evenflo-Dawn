{% doc %}
  @prompt
    I want to create an image gallery slider that users a product metafield with a list of images. , can we do 3 wide
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gallery-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-gallery-slider-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-gallery-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.3s ease;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-gallery-slider-slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.image_gap | times: 2 }}px) / 3);
    position: relative;
    aspect-ratio: {{ block.settings.aspect_ratio }};
  }

  .ai-gallery-slider-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-gallery-slider-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 300px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-gallery-slider-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.5;
  }

  .ai-gallery-slider-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-gallery-slider-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_text_color }};
    border: none;
    border-radius: 50%;
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-gallery-slider-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-gallery-slider-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: translateY(-50%) scale(1);
  }

  .ai-gallery-slider-nav-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.nav_button_size }}px * 0.4);
    height: calc({{ block.settings.nav_button_size }}px * 0.4);
  }

  .ai-gallery-slider-nav--prev-{{ ai_gen_id }} {
    left: {{ block.settings.nav_button_offset }}px;
  }

  .ai-gallery-slider-nav--next-{{ ai_gen_id }} {
    right: {{ block.settings.nav_button_offset }}px;
  }

  .ai-gallery-slider-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: {{ block.settings.dots_spacing }}px;
  }

  .ai-gallery-slider-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-gallery-slider-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-gallery-slider-counter-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.counter_offset }}px;
    right: {{ block.settings.counter_offset }}px;
    background-color: {{ block.settings.counter_bg_color }};
    color: {{ block.settings.counter_text_color }};
    padding: 8px 12px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
    z-index: 2;
    backdrop-filter: blur(4px);
  }

  @media screen and (max-width: 990px) {
    .ai-gallery-slider-slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.image_gap }}px) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-gallery-slider-slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-gallery-slider-nav-{{ ai_gen_id }} {
      width: calc({{ block.settings.nav_button_size }}px * 0.8);
      height: calc({{ block.settings.nav_button_size }}px * 0.8);
    }

    .ai-gallery-slider-nav--prev-{{ ai_gen_id }} {
      left: calc({{ block.settings.nav_button_offset }}px * 0.5);
    }

    .ai-gallery-slider-nav--next-{{ ai_gen_id }} {
      right: calc({{ block.settings.nav_button_offset }}px * 0.5);
    }

    .ai-gallery-slider-counter-{{ ai_gen_id }} {
      top: calc({{ block.settings.counter_offset }}px * 0.5);
      right: calc({{ block.settings.counter_offset }}px * 0.5);
      font-size: 12px;
      padding: 6px 10px;
    }
  }
{% endstyle %}

<image-gallery-slider-{{ ai_gen_id }}
  class="ai-gallery-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign gallery_images = product.metafields[block.settings.metafield_namespace][block.settings.metafield_key].value
    assign has_images = false
    if gallery_images and gallery_images.size > 0
      assign has_images = true
    endif
  %}

  <div class="ai-gallery-slider-container-{{ ai_gen_id }}">
    {% if has_images %}
      <div class="ai-gallery-slider-track-{{ ai_gen_id }}" data-track>
        {% for image in gallery_images %}
          <div class="ai-gallery-slider-slide-{{ ai_gen_id }}">
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {% endfor %}
      </div>

      {% if gallery_images.size > 3 %}
        {% if block.settings.show_navigation %}
          <button
            class="ai-gallery-slider-nav-{{ ai_gen_id }} ai-gallery-slider-nav--prev-{{ ai_gen_id }}"
            data-prev
            aria-label="Previous images"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15,18 9,12 15,6"></polyline>
            </svg>
          </button>

          <button
            class="ai-gallery-slider-nav-{{ ai_gen_id }} ai-gallery-slider-nav--next-{{ ai_gen_id }}"
            data-next
            aria-label="Next images"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </button>
        {% endif %}

        {% if block.settings.show_counter %}
          <div class="ai-gallery-slider-counter-{{ ai_gen_id }}" data-counter>
            <span data-current-start>1</span>-<span data-current-end>3</span> / <span data-total>{{ gallery_images.size }}</span>
          </div>
        {% endif %}
      {% endif %}
    {% else %}
      <div class="ai-gallery-slider-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-gallery-slider-empty-state-{{ ai_gen_id }}">
          Add images to the "{{ block.settings.metafield_namespace }}.{{ block.settings.metafield_key }}" metafield
        </div>
      </div>
    {% endif %}
  </div>

  {% if has_images and gallery_images.size > 3 and block.settings.show_dots %}
    {% assign total_pages = gallery_images.size | divided_by: 3.0 | ceil %}
    <div class="ai-gallery-slider-dots-{{ ai_gen_id }}">
      {% for i in (1..total_pages) %}
        <button
          class="ai-gallery-slider-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-dot="{{ forloop.index0 }}"
          aria-label="Go to page {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</image-gallery-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageGallerySlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentPage = 0;
        this.totalPages = 0;
        this.imagesPerPage = 3;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dots = this.querySelectorAll('[data-dot]');
        this.counter = this.querySelector('[data-counter]');
        this.currentStartCounter = this.querySelector('[data-current-start]');
        this.currentEndCounter = this.querySelector('[data-current-end]');
        this.totalCounter = this.querySelector('[data-total]');

        if (!this.track) return;

        this.slides = this.track.querySelectorAll('.ai-gallery-slider-slide-{{ ai_gen_id }}');
        this.totalSlides = this.slides.length;
        this.totalPages = Math.ceil(this.totalSlides / this.imagesPerPage);

        if (this.totalSlides <= this.imagesPerPage) return;

        this.setupEventListeners();
        this.setupAutoplay();
        this.setupTouchEvents();
        this.updateResponsiveSettings();
        
        window.addEventListener('resize', () => this.updateResponsiveSettings());
      }

      disconnectedCallback() {
        this.clearAutoplay();
        window.removeEventListener('resize', () => this.updateResponsiveSettings());
      }

      updateResponsiveSettings() {
        const isMobile = window.innerWidth <= 749;
        const isTablet = window.innerWidth <= 990 && window.innerWidth > 749;
        
        if (isMobile) {
          this.imagesPerPage = 1;
        } else if (isTablet) {
          this.imagesPerPage = 2;
        } else {
          this.imagesPerPage = 3;
        }
        
        this.totalPages = Math.ceil(this.totalSlides / this.imagesPerPage);
        this.currentPage = Math.min(this.currentPage, this.totalPages - 1);
        this.updateSlider();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.goToPrevPage());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.goToNextPage());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToPage(index));
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') this.goToPrevPage();
          if (e.key === 'ArrowRight') this.goToNextPage();
        });
      }

      setupAutoplay() {
        const autoplayDelay = {{ block.settings.autoplay_delay | times: 1000 }};
        const autoplayEnabled = {{ block.settings.enable_autoplay }};

        if (autoplayEnabled && autoplayDelay > 0) {
          this.startAutoplay(autoplayDelay);

          this.addEventListener('mouseenter', () => this.clearAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay(autoplayDelay));
        }
      }

      setupTouchEvents() {
        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
          this.clearAutoplay();
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          isDragging = false;

          const diffX = startX - currentX;
          const threshold = 50;

          if (Math.abs(diffX) > threshold) {
            if (diffX > 0) {
              this.goToNextPage();
            } else {
              this.goToPrevPage();
            }
          }
        });
      }

      startAutoplay(delay) {
        this.clearAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.goToNextPage();
        }, delay);
      }

      clearAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      goToPage(pageIndex) {
        this.currentPage = Math.max(0, Math.min(pageIndex, this.totalPages - 1));
        this.updateSlider();
      }

      goToNextPage() {
        this.currentPage = (this.currentPage + 1) % this.totalPages;
        this.updateSlider();
      }

      goToPrevPage() {
        this.currentPage = (this.currentPage - 1 + this.totalPages) % this.totalPages;
        this.updateSlider();
      }

      updateSlider() {
        const slideWidth = 100 / this.imagesPerPage;
        const translateX = -this.currentPage * slideWidth * this.imagesPerPage;
        this.track.style.transform = `translateX(${translateX}%)`;

        this.dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentPage);
        });

        if (this.currentStartCounter && this.currentEndCounter) {
          const startImage = this.currentPage * this.imagesPerPage + 1;
          const endImage = Math.min((this.currentPage + 1) * this.imagesPerPage, this.totalSlides);
          this.currentStartCounter.textContent = startImage;
          this.currentEndCounter.textContent = endImage;
        }

        if (this.prevButton) {
          this.prevButton.disabled = this.currentPage === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentPage === this.totalPages - 1;
        }
      }
    }

    customElements.define('image-gallery-slider-{{ ai_gen_id }}', ImageGallerySlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image gallery slider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Metafield settings"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "gallery_images"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3 / 2",
          "label": "Classic (3:2)"
        },
        {
          "value": "16 / 9",
          "label": "Widescreen (16:9)"
        },
        {
          "value": "2 / 3",
          "label": "Portrait (2:3)"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "image_gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Gap between images",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Container padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Container border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "nav_button_size",
      "min": 30,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Navigation button size",
      "default": 44
    },
    {
      "type": "range",
      "id": "nav_button_offset",
      "min": 10,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Navigation button offset",
      "default": 16
    },
    {
      "type": "color",
      "id": "nav_button_color",
      "label": "Navigation button color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_button_text_color",
      "label": "Navigation button icon color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "nav_button_hover_color",
      "label": "Navigation button hover color",
      "default": "#f0f0f0"
